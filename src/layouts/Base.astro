---
import '../styles/global.css';
type NavLink = { href: string; label: string };
interface Props {
  title: string;
  description?: string;
  /** Page-specific navigation. Omitted: the plain index navigation. */
  nav?: { tone?: 'gallery'; back?: NavLink; links?: NavLink[] };
  /** Full-bleed pages (homepage, course book) that carry their own header: no site navigation bar. */
  bare?: boolean;
}
const { title, description = 'ArtPilot：从一件作品开始，走进全球艺术史。', nav, bare = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    {!bare && <nav class="site-nav" aria-label="主导航" data-tone={nav?.tone}>
      <div class="nav-start">
        <a class="brand" href="/">ArtPilot</a>
        {nav?.back && (
          // Back is a plain link: predictable, and browser Back/Forward stay untouched.
          <a class="nav-back" href={nav.back.href} aria-label={`返回：${nav.back.label}`}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
            <span>{nav.back.label}</span>
          </a>
        )}
      </div>
      <ul>
        {nav
          ? nav.links?.map((l) => <li><a href={l.href}>{l.label}</a></li>)
          : <><li><a href="/courses/">课程</a></li><li><a href="/collection/">图鉴</a></li></>}
      </ul>
    </nav>}
    <main><slot /></main>
  </body>
</html>
