---
import '../styles/global.css';
import SiteBar from '../components/SiteBar.astro';
type NavLink = { href: string; label: string };
type Hall = 'courses' | 'stories' | 'cases' | 'atlas' | 'collection';
interface Props {
  title: string;
  description?: string;
  /** The site bar (SiteBar.astro): the way back, the hall this page belongs to, and links within the page. */
  nav?: { tone?: 'gallery'; back?: NavLink; hall?: Hall; here?: boolean; links?: NavLink[] };
  /** Full-bleed pages (homepage, course book) that carry their own header: no site navigation bar. */
  bare?: boolean;
  /** Pages that are dark from edge to edge: a dark canvas behind them, so no light shows at the edges or between pages. */
  dark?: boolean;
}
const { title, description = 'ArtPilot：从一件作品开始，走进全球艺术史。', nav, bare = false, dark = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-canvas={dark ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <!-- Opt in to native page transitions before any stylesheet arrives: a long page can render before its stylesheets
         apply, and an opt-in found only there is too late (Chrome then skips the transition). Lengths: global.css. -->
    <style is:inline>@view-transition{navigation:auto}@media (prefers-reduced-motion:reduce){@view-transition{navigation:none}}</style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- The site mark, a brick-red square (the same one as in the site bar). -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    {!bare && <SiteBar {...nav} />}
    <main><slot /></main>
  </body>
</html>
