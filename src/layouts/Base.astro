---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'ArtPilot 技术验证（Spike 01A）' } = Astro.props;
const inLesson = Astro.url.pathname.startsWith('/lessons/');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="主导航" data-tone={inLesson ? 'gallery' : undefined}>
      <div class="nav-start">
        <a class="brand" href="/">ArtPilot</a>
        {inLesson && (
          // Back is a plain link to the lesson list: predictable, and browser Back/Forward stay untouched.
          <a class="nav-back" href="/" aria-label="返回：课程列表">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
            <span>课程列表</span>
          </a>
        )}
      </div>
      <ul>
        {!inLesson && <li><a href="/" aria-current="page">课程</a></li>}
        {inLesson && <li><a href="#glossary">术语</a></li>}
        {inLesson && <li><a href="#rights">来源与版权</a></li>}
      </ul>
    </nav>
    <main><slot /></main>
  </body>
</html>
