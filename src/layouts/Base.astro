---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'ArtPilot 技术验证（Spike 01A）' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="主导航">
      <a class="brand" href="/">ARTPILOT</a>
      <ul>
        <li><a href="/">示例课程</a></li>
        <li><a href="#glossary">术语</a></li>
        <li><a href="#rights">图片与版权</a></li>
      </ul>
    </nav>
    <main><slot /></main>
  </body>
</html>
