---
import ArtworkCard from './ArtworkCard.astro';
// The unlock moment: a correct answer in the lesson's observation quiz adds the artwork's card to this device's
// archive, and this panel appears right after the quiz to say so. Hidden until then.
interface Props { artwork: string }
const { artwork } = Astro.props;
---
<aside class="card-unlock" data-unlock={artwork} role="status" aria-live="polite" hidden>
  <ArtworkCard artwork={artwork} variant="mini" />
  <div class="card-unlock-text">
    <p class="kicker" data-unlock-kicker>获得藏品卡</p>
    <p class="card-unlock-title" data-unlock-title></p>
    <a class="btn btn-secondary" href="/collection/">打开图鉴</a>
  </div>
</aside>

<script>
  import { collect, deviceStorage } from '../lib/collection.js';

  const panel = document.querySelector<HTMLElement>('[data-unlock]')!;
  const id = panel.dataset.unlock!;
  addEventListener('artpilot:quiz', (event) => {
    if (!(event as CustomEvent<{ correct: boolean }>).detail.correct) return;
    const { added } = collect(deviceStorage(), id);
    panel.querySelector('[data-unlock-kicker]')!.textContent = added ? '获得藏品卡' : '已在图鉴中';
    panel.querySelector('[data-unlock-title]')!.textContent = added
      ? '这幅作品的卡片已收入你的图鉴。'
      : '这张卡片你已经收集过了。';
    panel.dataset.fresh = String(added);
    (event.target as HTMLElement).after(panel); // right after the quiz that earned it
    panel.hidden = false;
    dispatchEvent(new Event('artpilot:collected'));
  });
</script>
