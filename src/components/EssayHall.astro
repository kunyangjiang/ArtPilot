---
// The entrance of a hall of long-form articles (艺术家故事, 叙事案例): its name and premise, then every published
// article as an exhibit — the opening work shown whole, the number, the title, who or what it is about, one paragraph.
// Only what is published is listed; nothing announces what is coming. Order: the order they were published in, never by
// date, so the hall does not turn into a feed — for artist stories the artist series (ARTIST_CARDS in
// src/lib/publication.js), for cases their file name. A story whose work cannot be reproduced here opens with a lawful
// image of another kind; the hall shows it under its role, never as the work.
import { getCollection, getEntry } from 'astro:content';
import { destinations } from '../data/home';
import { ARTIST_CARDS } from '../lib/publication.js';
interface Props { kind: 'artist-story' | 'case' }
const { kind } = Astro.props;
const d = destinations.find((x) => x.id === (kind === 'artist-story' ? 'stories' : 'cases'))!;
const base = kind === 'artist-story' ? '/stories/' : '/cases/';
const tag = kind === 'artist-story' ? 'Story' : 'Case';
const rank = (e: { id: string; data: { card?: { id: string } } }) => (kind === 'artist-story' && e.data.card ? ARTIST_CARDS.indexOf(e.data.card.id) : -1);
const entries = (await getCollection('essays')).filter((e) => e.data.kind === kind)
  .sort((a, b) => rank(a) - rank(b) || a.id.localeCompare(b.id));
const items = await Promise.all(entries.map(async (e, i) => {
  const art = (await getEntry('artworks', e.data.hero.artwork.id))!.data;
  const img = art.images.find((x) => x.key === e.data.hero.image)!;
  const role = art.officialPage ? `${e.data.hero.role ?? '示意'} · 不是本篇的主角作品` : null;
  return { href: `${base}${e.id}/`, no: String(i + 1).padStart(2, '0'), title: e.data.title, subject: e.data.subject, summary: e.data.summary, img, role };
}));
---
<section class="eh" aria-labelledby="eh-title">
  <!-- The halls' room (src/lib/desk/hall.ts), as behind the collection and the catalogue. -->
  <canvas class="eh-web" data-web aria-hidden="true"></canvas>
  <header class="eh-head">
    <p class="eh-kicker">{d.label === 'Cases' ? d.sub : d.label} · <span lang="en">{d.label === 'Cases' ? d.label : d.sub}</span></p>
    <h1 id="eh-title" tabindex="-1">{d.label === 'Cases' ? d.sub : d.label}</h1>
    <p class="eh-premise">{d.premise}</p>
  </header>
  <!-- Artist stories, a series of twenty, hang two to a row; the cases, a handful, keep one exhibit per row. -->
  <ol class:list={['eh-list', { 'eh-grid': kind === 'artist-story' }]}>
    {items.map((it) => (
      <li>
        <a class="eh-item" href={it.href}>
          <span class="eh-print"><img src={it.img.src} alt={it.img.alt} width={it.img.width} height={it.img.height} loading="lazy" />{it.role && <span class="eh-role">{it.role}</span>}</span>
          <span class="eh-text">
            <span class="eh-no" lang="en">{tag} {it.no}</span>
            <span class="eh-title">{it.title}</span>
            <span class="eh-subject">{it.subject}</span>
            <span class="eh-summary">{it.summary}</span>
            <span class="eh-go">开始阅读 <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  /* The room's red wall (drawHallWall) stands in the last 8.5% of the window (7% on a phone). Where the page's own
     margin is narrower than that, the hall steps in from the right so no text or rule runs onto the wall. */
  .eh { position: relative; isolation: isolate; margin-right: max(0px, calc(8.5vw + 1.5rem - max(1.25rem, (100vw - 66rem) / 2))); }
  @media (max-width: 900px) { .eh { margin-right: max(0px, calc(7vw + .75rem - 1.25rem)); } }
  .eh-web { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
  .eh { --serif-d: "ArtPilot Serif SC", "Noto Serif SC", "Source Han Serif SC", serif; --latin-d: "ArtPilot Bodoni", "Bodoni Moda", Didot, serif; }
  .eh-kicker { margin: 0 0 1rem; font: 500 .75rem/1.5 var(--sans); letter-spacing: .2em; color: var(--gallery-ink-2); }
  .eh h1 { margin: 0; font: 500 clamp(2.25rem, 5vw, 3.25rem)/1.25 var(--serif-d); letter-spacing: .06em; color: var(--gallery-ink); }
  .eh-premise { max-width: 32em; margin: 1rem 0 0; font: 400 1rem/1.85 var(--sans); color: var(--gallery-ink-2); }
  .eh-list { margin: 3rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--gallery-ink-2); }
  .eh-list > li { border-bottom: 1px solid var(--gallery-rule); }
  .eh-item { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center;
    padding: 2.25rem 0; color: inherit; text-decoration: none; }
  /* The opening work as a print on paper, shown whole. */
  .eh-print { display: flex; flex-direction: column; align-items: center; gap: .6rem; }
  .eh-role { font: 500 .75rem/1.5 var(--sans); letter-spacing: .12em; color: var(--gallery-ink-2); text-align: center; }
  .eh-print img { display: block; width: auto; height: auto; max-width: 100%; max-height: 20rem; padding: .5rem; background: var(--gallery-ink);
    box-shadow: 0 18px 32px -16px rgb(0 0 0 / .9); transform: rotate(-1.5deg); transition: transform var(--t) var(--ease); }
  .eh-item:hover .eh-print img, .eh-item:focus-visible .eh-print img { transform: rotate(0deg) translateY(-4px); }
  .eh-text { display: grid; gap: .5rem; }
  .eh-no { font: 400 .9375rem/1 var(--latin-d); letter-spacing: .14em; color: var(--gallery-ink-2); }
  .eh-title { font: 500 clamp(1.5rem, 3vw, 2rem)/1.4 var(--serif-d); letter-spacing: .04em; color: var(--gallery-ink); }
  .eh-subject { font: 400 .875rem/1.6 var(--sans); letter-spacing: .08em; color: var(--gallery-ink-2); }
  .eh-summary { max-width: 34em; margin-top: .25rem; font: 400 .9375rem/1.85 var(--sans); color: var(--gallery-ink-2); }
  .eh-go { margin-top: .5rem; font: 500 .875rem/1.5 var(--sans); letter-spacing: .08em; color: var(--gallery-ink); }
  .eh-go span { display: inline-block; transition: transform var(--t) var(--ease); }
  .eh-item:hover .eh-go span, .eh-item:focus-visible .eh-go span { transform: translateX(4px); }
  .eh-item:focus-visible { outline: 2px solid var(--gallery-ink); outline-offset: 6px; }
  @media (max-width: 640px) {
    .eh-item { grid-template-columns: 1fr; gap: 1.25rem; }
    .eh-print img { max-height: 24rem; }
  }

  /* Two to a row: each exhibit a print beside its text, the summary held to four lines. */
  .eh-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(1.5rem, 4vw, 3.5rem); }
  .eh-grid .eh-item { grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr); gap: 1.5rem; align-items: start; padding: 2rem 0; }
  .eh-grid .eh-print img { max-height: 13rem; padding: .375rem; }
  .eh-grid .eh-role { font-size: .6875rem; letter-spacing: .08em; }
  .eh-grid .eh-text { gap: .4rem; }
  .eh-grid .eh-no { font-size: .875rem; }
  .eh-grid .eh-title { font-size: clamp(1.1875rem, 1.9vw, 1.4375rem); line-height: 1.45; }
  .eh-grid .eh-subject { font-size: .8125rem; letter-spacing: .06em; }
  .eh-grid .eh-summary { margin-top: .15rem; font-size: .875rem; line-height: 1.8;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; line-clamp: 4; overflow: hidden; }
  .eh-grid .eh-go { margin-top: .25rem; font-size: .8125rem; }
  /* Narrower windows: the print above its text, still two to a row; prints of a row share a top line. */
  @media (max-width: 960px) {
    .eh-grid .eh-item { --ph: 14rem; grid-template-columns: 1fr; gap: 1rem; padding: 1.75rem 0; }
    .eh-grid .eh-print { align-items: flex-start; }
    .eh-grid .eh-print img { max-height: var(--ph); }
    .eh-grid .eh-role { text-align: left; }
  }
  @media (max-width: 640px) {
    .eh-grid { column-gap: 1rem; }
    .eh-grid .eh-item { --ph: 10rem; gap: .75rem; padding: 1.25rem 0 1.5rem; }
    .eh-grid .eh-print img { padding: .25rem; transform: rotate(-1deg); }
    .eh-grid .eh-text { gap: .3rem; }
    .eh-grid .eh-no { font-size: .75rem; }
    .eh-grid .eh-title { font-size: 1rem; line-height: 1.5; letter-spacing: .02em; }
    .eh-grid .eh-subject { font-size: .6875rem; line-height: 1.5; letter-spacing: .02em; }
    .eh-grid .eh-summary { font-size: .75rem; line-height: 1.7; -webkit-line-clamp: 3; line-clamp: 3; }
    .eh-grid .eh-go { font-size: .75rem; }
  }
</style>

<script>
  import { startGround } from '../lib/desk/ground';
  import { drawHallWall } from '../lib/desk/hall';
  import { startScrollFade } from '../lib/scrollFade';

  // The halls' room behind the page; blocks dim as they leave the window.
  startGround(document.querySelector<HTMLCanvasElement>('[data-web]')!, drawHallWall);
  startScrollFade('.eh-head, .eh-item');
</script>
