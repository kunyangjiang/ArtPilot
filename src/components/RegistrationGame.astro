---
// Printing a multicolour woodblock print, block by block. A simple design (a schematic, not any surviving print) is
// built up from four blocks: the background, the face, the robe, then the black key-line block. "印下一块版" prints
// the next block; with "纸靠着见当放" off, every block lands a little off, as it would without registration marks.
// After the last block, "再印一张" starts a new sheet. Not scored, not stored.
const layers = [
  { id: 'bg', label: '底色版', note: '整片底色。' },
  { id: 'skin', label: '肤色版', note: '脸和手的颜色。' },
  { id: 'robe', label: '衣服版', note: '衣服的条纹。' },
  { id: 'key', label: '主版（墨线）', note: '最后印上黑色的轮廓线。' },
];
---
<section class="module reg" data-reg={JSON.stringify(layers)}>
  <p class="module-label">互动 · 套色印刷</p>
  <h3>做一回摺师：一块版一块版地印</h3>
  <div class="reg-body">
    <svg class="reg-sheet" viewBox="0 0 200 280" role="img" aria-labelledby="reg-title">
      <title id="reg-title">一张正在印制的版画示意：依次印上底色、肤色、衣服和黑色轮廓线。</title>
      <rect x="0" y="0" width="200" height="280" fill="#f7f1e3" />
      <g data-layer="bg" class="reg-layer"><rect x="10" y="10" width="180" height="260" fill="#6f6862" /></g>
      <g data-layer="skin" class="reg-layer">
        <path d="M86 70 Q86 46 106 44 Q128 44 130 70 Q132 96 118 108 Q102 116 92 102 Q86 92 86 70 Z" fill="#efd9bd" />
        <path d="M40 214 Q52 200 66 206 L76 222 Q64 236 48 232 Z M130 220 Q146 206 160 214 L162 232 Q146 240 134 234 Z" fill="#efd9bd" />
      </g>
      <g data-layer="robe" class="reg-layer">
        <path d="M30 140 Q70 112 104 120 Q140 112 176 140 L186 270 H20 Z" fill="#9b4a35" />
        <path d="M44 142 L40 268 M58 134 L56 268 M72 128 L72 268 M140 128 L142 268 M154 134 L158 268 M168 140 L172 268" stroke="#e7c9a0" stroke-width="3" />
      </g>
      <g data-layer="key" class="reg-layer" fill="none" stroke="#1d1d1e" stroke-width="2.4" stroke-linecap="round">
        <path d="M86 70 Q86 46 106 44 Q128 44 130 70 Q132 96 118 108 Q102 116 92 102 Q86 92 86 70 Z" />
        <path d="M84 60 Q90 26 112 28 Q134 32 132 58" fill="#1d1d1e" />
        <path d="M96 66 L104 64 M114 64 L122 66 M102 90 Q108 86 114 90" />
        <path d="M30 140 Q70 112 104 120 Q140 112 176 140 L186 270 H20 Z" />
        <path d="M40 214 Q52 200 66 206 L76 222 Q64 236 48 232 Z M130 220 Q146 206 160 214 L162 232 Q146 240 134 234 Z" />
      </g>
      <g class="reg-kento" stroke="#8a3b2a" stroke-width="2" fill="none"><path d="M4 262 V276 H18" /><path d="M150 276 H180" /></g>
    </svg>
    <div class="reg-side">
      <ol class="reg-steps" data-steps>
        {layers.map((l) => <li data-step-for={l.id}><strong>{l.label}</strong>{l.note}</li>)}
      </ol>
      <label class="reg-switch"><input type="checkbox" data-kento checked /> 纸靠着见当放</label>
      <div class="actions">
        <button type="button" class="btn btn-primary" data-print>印下一块版</button>
        <button type="button" class="btn btn-secondary" data-again hidden>再印一张</button>
      </div>
      <p class="reg-status" data-status role="status" aria-live="polite">一张白纸。先印哪一块？按“印下一块版”。</p>
    </div>
  </div>
  <p class="reg-note">示意：图样与版的数目都是简化的，不是对某一张版画的复原。纸边的红色记号代表见当。</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-reg]').forEach((root) => {
    const layers = JSON.parse(root.dataset.reg!) as { id: string; label: string }[];
    const g = (id: string) => root.querySelector<SVGGElement>(`[data-layer="${id}"]`)!;
    const kento = root.querySelector<HTMLInputElement>('[data-kento]')!;
    const print = root.querySelector<HTMLButtonElement>('[data-print]')!;
    const again = root.querySelector<HTMLButtonElement>('[data-again]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    let n = 0, offs = 0;
    const reset = () => {
      n = 0; offs = 0;
      layers.forEach((l) => { const el = g(l.id); el.classList.remove('is-on'); el.removeAttribute('transform'); });
      root.querySelectorAll('[data-step-for]').forEach((li) => li.classList.remove('is-done'));
      print.hidden = false; again.hidden = true; kento.disabled = false;
      status.textContent = '一张白纸。按“印下一块版”。';
    };
    print.addEventListener('click', () => {
      const l = layers[n]; const el = g(l.id);
      if (!kento.checked) {
        const dx = Math.round((Math.random() * 2 - 1) * 9), dy = Math.round((Math.random() * 2 - 1) * 9);
        el.setAttribute('transform', `translate(${dx} ${dy})`); offs++;
      }
      el.classList.add('is-on');
      root.querySelector(`[data-step-for="${l.id}"]`)!.classList.add('is-done');
      n++;
      if (n < layers.length) status.textContent = `印好了${l.label}。还有 ${layers.length - n} 块。`;
      else {
        status.textContent = offs ? `印完了。纸每次都放得不一样，颜色和轮廓错开了 ${offs} 次：这就是没有见当的结果。` : '印完了。每次都靠着见当放纸，四块版对得整整齐齐。';
        print.hidden = true; again.hidden = false; kento.disabled = true; again.focus();
      }
    });
    again.addEventListener('click', () => { reset(); print.focus(); });
    reset();
  });
</script>
