---
// Three burials side by side, each as a simple section: Meketre's tomb cut into the Theban cliff (Middle Kingdom), a
// Classic Kerma royal tumulus, and Taharqo's pyramid at Nuri (Kushite, 25th Dynasty). They are centuries apart and
// are not drawn to one scale; each heading carries its own place and date. Four switches pick one layer to read across
// all three: what stood above ground, where the dead lay, what was set beside them, and how we know. The chosen layer
// is drawn darker in every section and each burial's note for it opens beneath. Schematic drawings of relationships,
// not plans of the real tombs. Nothing is scored or stored; without script all notes show.
type Layer = 'above' | 'body' | 'goods' | 'record';
interface Burial { title: string; place: string; date: string; notes: Record<Layer, string> }
interface Props { prompt: string; burials: [Burial, Burial, Burial]; caption: string }
const { prompt, burials, caption } = Astro.props;
const layers: { id: Layer; label: string }[] = [
  { id: 'above', label: '地面上看得见什么' },
  { id: 'body', label: '死者躺在哪里' },
  { id: 'goods', label: '身边放了什么' },
  { id: 'record', label: '我们怎么知道' },
];
---
<section class="module bc" data-bc data-layer="above">
  <p class="module-label">互动 · 三座墓的剖面</p>
  <h3>{prompt}</h3>
  <div class="bc-switch" role="group" aria-label="选择要对照的一层">
    {layers.map((l, i) => <button type="button" data-set={l.id} aria-pressed={i === 0 ? 'true' : 'false'}>{l.label}</button>)}
  </div>
  <ol class="bc-cols">
    <li>
      <svg viewBox="0 0 200 150" aria-hidden="true">
        <path class="bc-rock" d="M0 40 H70 L80 30 V0 H200 V150 H0 Z" />
        <path class="bc-cut" data-l="above" d="M0 40 H62 V28 H80" />
        <path class="bc-void" d="M80 40 H160 V52 H80 Z" />
        <rect class="bc-void" data-l="body" x="160" y="36" width="30" height="34" />
        <rect class="bc-mark" data-l="body" x="166" y="56" width="18" height="8" />
        <rect class="bc-void" data-l="goods" x="108" y="54" width="22" height="16" />
        <path class="bc-goods" data-l="goods" d="M111 66 h4 v-5 h-4 z M118 66 h4 v-7 h-4 z M125 66 h3 v-4 h-3 z" />
        <path class="bc-note" data-l="record" d="M119 70 V88" />
        <text class="bc-s" data-l="record" x="119" y="100" text-anchor="middle">1920 年在原位找到</text>
        <text class="bc-s" x="6" y="22">山崖</text>
      </svg>
      <p class="bc-title">{burials[0].title}</p>
      <p class="bc-where">{burials[0].place} · {burials[0].date}</p>
      {layers.map((l) => <p class="bc-text" data-for={l.id}>{burials[0].notes[l.id]}</p>)}
    </li>
    <li>
      <svg viewBox="0 0 200 150" aria-hidden="true">
        <path class="bc-ground" d="M0 92 H200" />
        <path class="bc-mound" data-l="above" d="M14 92 Q100 26 186 92 Z" />
        <path class="bc-corridor" data-l="goods" d="M30 96 H170" />
        <path class="bc-dots" data-l="goods" d="M40 96 h0 M52 96 h0 M64 96 h0 M76 96 h0 M124 96 h0 M136 96 h0 M148 96 h0 M160 96 h0" />
        <path class="bc-void" data-l="body" d="M84 88 H116 V108 H84 Z" />
        <rect class="bc-mark" data-l="body" x="90" y="100" width="20" height="4" />
        <path class="bc-bed" data-l="body" d="M91 104 v4 M109 104 v4" />
        <text class="bc-s" data-l="record" x="100" y="132" text-anchor="middle">20 世纪初赖斯纳的发掘</text>
        <text class="bc-s" x="100" y="20" text-anchor="middle">圆形封土</text>
      </svg>
      <p class="bc-title">{burials[1].title}</p>
      <p class="bc-where">{burials[1].place} · {burials[1].date}</p>
      {layers.map((l) => <p class="bc-text" data-for={l.id}>{burials[1].notes[l.id]}</p>)}
    </li>
    <li>
      <svg viewBox="0 0 200 150" aria-hidden="true">
        <path class="bc-ground" d="M0 70 H200" />
        <path class="bc-pyr" data-l="above" d="M100 8 L136 70 H64 Z" />
        <path class="bc-void" d="M170 70 L120 112 H128 L174 72" />
        <rect class="bc-void" data-l="body" x="70" y="104" width="54" height="26" />
        <rect class="bc-mark" data-l="body" x="86" y="118" width="22" height="6" />
        <path class="bc-goods" data-l="goods" d="M73 108 V128 M76 108 V128 M79 108 V128 M115 108 V128 M118 108 V128 M121 108 V128 M84 108 H110" />
        <text class="bc-s" data-l="record" x="100" y="146" text-anchor="middle">1917 年哈佛—波士顿考古队</text>
        <text class="bc-s" x="182" y="64" text-anchor="end">阶梯</text>
      </svg>
      <p class="bc-title">{burials[2].title}</p>
      <p class="bc-where">{burials[2].place} · {burials[2].date}</p>
      {layers.map((l) => <p class="bc-text" data-for={l.id}>{burials[2].notes[l.id]}</p>)}
    </li>
  </ol>
  <p class="bc-caption">{caption}</p>
</section>

<style>
  .bc-switch { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
  .bc-switch button { padding: .5rem .9rem; border: 1px solid var(--rule); background: var(--paper); color: var(--ink-2);
    font: 500 .875rem/1.4 var(--sans); letter-spacing: .04em; cursor: pointer; transition: border-color var(--t) var(--ease), background var(--t) var(--ease); }
  .bc-switch button:hover { border-color: var(--ink-3); }
  .bc-switch button[aria-pressed="true"] { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .bc-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  .bc-cols svg { display: block; width: 100%; height: auto; background: var(--mist); }
  .bc-title { margin: .85rem 0 0; font: 500 1rem/1.5 var(--serif); letter-spacing: .03em; }
  .bc-where { margin: .15rem 0 0; font: 400 .75rem/1.5 var(--sans); letter-spacing: .08em; color: var(--ink-3); }
  .bc-text { margin: .6rem 0 0; font: 400 .9rem/1.8 var(--sans); color: var(--ink-2); }
  .bc-caption { margin: 1.25rem 0 0; font: 400 .8125rem/1.75 var(--sans); color: var(--ink-3); letter-spacing: .03em; }
  /* Only the chosen layer's note shows (all of them without script). */
  :global(.bc.is-ready) .bc-text { display: none; }
  :global(.bc.is-ready[data-layer="above"]) .bc-text[data-for="above"],
  :global(.bc.is-ready[data-layer="body"]) .bc-text[data-for="body"],
  :global(.bc.is-ready[data-layer="goods"]) .bc-text[data-for="goods"],
  :global(.bc.is-ready[data-layer="record"]) .bc-text[data-for="record"] { display: block; animation: bc-in 360ms var(--ease) both; }
  @keyframes bc-in { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { :global(.bc) .bc-text { animation: none !important; } }
  .bc-rock { fill: var(--silver); stroke: none; }
  .bc-ground { stroke: var(--ink-2); stroke-width: 1.2; }
  .bc-cut { fill: none; stroke: var(--ink-3); stroke-width: 1.2; }
  .bc-void { fill: var(--paper); stroke: var(--ink-3); stroke-width: 1; }
  .bc-mound, .bc-pyr { fill: var(--silver); stroke: var(--ink-3); stroke-width: 1; }
  .bc-mark { fill: var(--ink-3); }
  .bc-bed { stroke: var(--ink-3); stroke-width: 1.2; }
  .bc-goods { fill: var(--ink-3); stroke: var(--ink-3); stroke-width: 1; }
  .bc-corridor { stroke: var(--ink-3); stroke-width: 5; stroke-opacity: .25; }
  .bc-dots { stroke: var(--ink-3); stroke-width: 4; stroke-linecap: round; }
  .bc-note { stroke: var(--ink-3); stroke-width: .8; stroke-dasharray: 2 2; }
  .bc-s { font: 400 10.5px/1 var(--sans); fill: var(--ink-3); letter-spacing: .02em; }
  [data-l] { transition: fill var(--t) var(--ease), stroke var(--t) var(--ease), opacity var(--t) var(--ease); }
  text[data-l] { opacity: .35; }
  :global(.bc[data-layer="above"]) [data-l="above"],
  :global(.bc[data-layer="body"]) [data-l="body"],
  :global(.bc[data-layer="goods"]) [data-l="goods"] { fill: var(--ink); stroke: var(--ink); }
  :global(.bc[data-layer="body"]) .bc-void[data-l="body"] { fill: var(--paper); stroke: var(--ink); stroke-width: 1.6; }
  :global(.bc[data-layer="goods"]) .bc-void[data-l="goods"] { fill: var(--paper); stroke: var(--ink); stroke-width: 1.6; }
  :global(.bc[data-layer="goods"]) .bc-corridor { stroke-opacity: .5; }
  :global(.bc[data-layer="record"]) [data-l="record"] { opacity: 1; fill: var(--ink); }
  :global(.bc[data-layer="record"]) .bc-note { stroke: var(--ink); }
  @media (max-width: 640px) {
    .bc-cols { grid-template-columns: 1fr; gap: 2rem; }
    .bc-cols svg { max-width: 22rem; }
    .bc-s { font-size: 12px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-bc]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-set]')];
    root.classList.add('is-ready');
    buttons.forEach((b) => b.addEventListener('click', () => {
      root.dataset.layer = b.dataset.set;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }));
  });
</script>
