---
// Walking through a house by its inventory: the rooms in the order the clerk wrote them, and in each room a few of the
// entries as they stand in the document (the original wording, a translation, the lot number), with what each one tells
// about the owner. An entry may show a related work from an artwork record (`artwork`/`image`), labelled as such: the
// entry names an object, the picture shows something it can be compared with, never the object itself. Moved between
// rooms with the tabs (arrow keys too). Nothing is scored or stored. Without script every room is in the page.
import { getEntry } from 'astro:content';
interface Entry { lot: string; original: string; zh: string; note: string; artwork?: string; image?: string }
interface Room { id: string; original: string; zh: string; count: number; intro: string; entries: Entry[] }
interface Props { prompt: string; rooms: Room[]; caption: string }
const { prompt, rooms, caption } = Astro.props;
const withImages = await Promise.all(rooms.map(async (r) => ({
  ...r,
  entries: await Promise.all(r.entries.map(async (e) => {
    if (!e.artwork) return { ...e, img: undefined };
    const img = (await getEntry('artworks', e.artwork))?.data.images.find((i) => i.key === e.image);
    if (!img) throw new Error(`InventoryRooms: unknown image ${e.artwork}/${e.image}`);
    return { ...e, img };
  })),
})));
---
<section class="module inv" data-inv>
  <p class="module-label">互动 · 清单上的房间</p>
  <h3>{prompt}</h3>
  <div class="inv-tabs" role="tablist" aria-label="清单上的房间">
    {withImages.map((r, i) => (
      <button type="button" role="tab" class="inv-tab" id={`inv-tab-${r.id}`} aria-controls={`inv-panel-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="inv-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="inv-zh">{r.zh}</span>
      </button>
    ))}
  </div>
  {withImages.map((r, i) => (
    <div class="inv-panel" role="tabpanel" id={`inv-panel-${r.id}`} aria-labelledby={`inv-tab-${r.id}`} hidden={i !== 0}>
      <p class="inv-room"><span lang="nl">{r.original}</span><span class="inv-count">清单上这一间约 {r.count} 条</span></p>
      <p class="inv-intro">{r.intro}</p>
      <ol class="inv-entries">
        {r.entries.map((e) => (
          <li class={e.img ? 'has-img' : undefined}>
            <p class="inv-line"><span class="inv-lot">{e.lot}</span><span lang="nl" class="inv-orig">{e.original}</span></p>
            <p class="inv-tr">{e.zh}</p>
            <p class="inv-note">{e.note}</p>
            {e.img && (
              <figure class="inv-fig">
                <img src={e.img.src} alt={e.img.alt} width={e.img.width} height={e.img.height} loading="lazy" decoding="async" />
                <figcaption>对照：{e.img.subject ?? e.img.caption}</figcaption>
              </figure>
            )}
          </li>
        ))}
      </ol>
    </div>
  ))}
  <p class="inv-caption">{caption}</p>
</section>

<style>
  .inv-tabs { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1.25rem; }
  .inv-tab { display: inline-flex; align-items: baseline; gap: .45rem; min-height: 2.75rem; padding: .5rem .8rem; border: 1px solid var(--silver);
    background: transparent; color: inherit; font: 400 .9375rem/1.3 var(--sans); cursor: pointer; transition: border-color var(--t) var(--ease), background var(--t) var(--ease); }
  .inv-tab:hover { border-color: var(--ink-3); }
  .inv-tab[aria-selected="true"] { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .inv-no { font: 400 .75rem/1 var(--latin); letter-spacing: .08em; opacity: .7; }
  .inv-room { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem 1rem; margin: 0 0 .4rem; font: italic 400 1.0625rem/1.5 var(--serif); }
  .inv-count { font: 400 .75rem/1.5 var(--sans); font-style: normal; letter-spacing: .1em; color: var(--ink-3); }
  .inv-intro { max-width: var(--measure); margin: 0 0 1.1rem; font: 400 .9375rem/1.85 var(--sans); color: var(--ink-2); }
  .inv-entries { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .inv-entries > li { padding: .9rem 0 1rem; border-bottom: 1px solid var(--rule); }
  .inv-entries > li.has-img { display: grid; grid-template-columns: minmax(0, 1fr) 9rem; column-gap: 1.25rem; }
  .inv-entries > li.has-img > p { grid-column: 1; }
  .inv-fig { grid-column: 2; grid-row: 1 / span 3; margin: 0; }
  .inv-fig img { display: block; width: 100%; height: auto; max-height: 11rem; object-fit: contain; }
  .inv-fig figcaption { margin-top: .35rem; font: 400 .6875rem/1.5 var(--sans); color: var(--ink-3); }
  .inv-line { display: flex; gap: .75rem; align-items: baseline; margin: 0 0 .2rem; }
  .inv-lot { flex: none; font: 400 .75rem/1.6 var(--latin); letter-spacing: .06em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .inv-orig { font: italic 400 1rem/1.6 var(--latin); color: var(--ink); }
  .inv-tr { margin: 0 0 .3rem; padding-left: 3.1rem; font: 500 .9375rem/1.7 var(--sans); color: var(--ink); }
  .inv-note { max-width: var(--measure); margin: 0; padding-left: 3.1rem; font: 400 .875rem/1.8 var(--sans); color: var(--ink-2); }
  .inv-caption { max-width: var(--measure); margin: 1.1rem 0 0; font: 400 .8125rem/1.7 var(--sans); color: var(--ink-3); }
  @media (max-width: 640px) {
    .inv-entries > li.has-img { grid-template-columns: 1fr; }
    .inv-fig { grid-column: 1; grid-row: auto; max-width: 12rem; margin: .6rem 0 0; }
    .inv-tr, .inv-note { padding-left: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-inv]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.inv-tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.inv-panel')];
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => (p.hidden = k !== i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); pick((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); pick((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>
