---
import { getEntry } from 'astro:content';
// A photograph with a few numbered points placed on real features (percent of the image width/height, set by
// eye against the photo) and a legend beneath. Numbers rather than labels on the image, so nothing collides on a
// phone. Static: no interaction.
interface Mark { x: number; y: number; label: string; note: string }
interface Props { artwork: string; image: string; marks: Mark[]; note?: string }
const { artwork, image, marks, note } = Astro.props;
const record = await getEntry('artworks', artwork);
const img = record?.data.images.find((i) => i.key === image);
if (!record || !img) throw new Error(`Unknown artwork/image: ${artwork}/${image}`);
const credit = img.credit ? `${img.subject ?? record.data.titleZh} · 摄影 ${img.credit.author} · ${img.credit.licence}` : '';
---
<figure class="marks">
  <div class="marks-frame">
    <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
    {marks.map((m, i) => <span class="marks-dot" style={`left:${m.x}%;top:${m.y}%`} aria-hidden="true">{i + 1}</span>)}
  </div>
  <figcaption>
    <ol class="marks-legend">
      {marks.map((m) => <li><strong>{m.label}</strong>　{m.note}</li>)}
    </ol>
    <span class="cap">{img.caption}{note && ` ${note}`}</span>
    <span class="credit photo">{credit}</span>
  </figcaption>
</figure>
