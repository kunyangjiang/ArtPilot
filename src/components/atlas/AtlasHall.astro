---
// The Atlas hall (同时代的世界), in three levels.
// 1. Time: one timeline across all nine windows, with one selection — a year and the years around it (the default), or
//    a whole window (chosen from the numerals under the axis). Nothing else on the page selects time.
// 2. Works: the works of that selection, from every part of the world, as cards with their images; a part of the
//    world can be chosen above them.
// 3. Deeper, on request, for the window holding the selection: its overview on a time axis (with what the site lacks),
//    a plan of where the works were made, and the site's comparisons. Any two works can also be compared side by side.
// Everything is rendered at build time, so the hall reads without scripts: the timeline at its opening year, every
// work, and each window's comparisons. The data: src/data/atlas.ts over the collection's records; the time logic:
// src/lib/atlasTime.js.
import { getCollection } from 'astro:content';
import { destinations } from '../../data/home';
import { WINDOWS, ANCHORS, BANDS, BAND_COLOUR, CONTEXT, type Entry, type Source, type Precision, type Band } from '../../data/atlas';
import { astro, relation, relationText, yearParts } from '../../lib/atlasTime.js';

const d = destinations.find((x) => x.id === 'atlas')!;
const records = new Map((await getCollection('artworks')).map((r) => [r.id, r.data]));
const lessons = await getCollection('lessons');
const essays = await getCollection('essays');
const anchors = new Map(ANCHORS.map((a) => [a.id, a]));
const contexts = new Map(CONTEXT.map((c) => [c.id, c]));
const essayHref = (e: (typeof essays)[number]) => `${e.data.kind === 'artist-story' ? '/stories/' : '/cases/'}${e.id}/`;

// Six parts of the world: the eight bands of the data, gathered so that none stands nearly empty.
const WALLS: { id: string; label: string; en: string; bands: Band[] }[] = [
  { id: 'east-asia', label: '东亚', en: 'East Asia', bands: ['east-asia'] },
  { id: 'south-se-asia', label: '南亚与东南亚', en: 'South & Southeast Asia', bands: ['south-asia', 'southeast-asia'] },
  { id: 'west-asia', label: '西亚', en: 'West Asia', bands: ['west-asia'] },
  { id: 'africa', label: '非洲', en: 'Africa', bands: ['africa'] },
  { id: 'europe', label: '欧洲', en: 'Europe', bands: ['europe'] },
  { id: 'americas-oceania', label: '美洲与大洋洲', en: 'The Americas & Oceania', bands: ['americas', 'oceania'] },
];
const wallOf = (b: Band) => WALLS.find((w) => w.bands.includes(b))!;
// Works whose place cannot be determined stand apart, as a part of the world of their own.
const NOWHERE = { id: 'none', label: '地点无法确定', en: 'Place unknown', bands: [] as Band[] };
const wallId = (x: { wall: { id: string } | null }) => x.wall?.id ?? 'none';
// Each part of the world's colour (BAND_COLOUR), set as --wc on its row, cards and button; place unknown stays grey.
const wc = (w: { bands: Band[] }) => `--wc:${w.bands.length ? BAND_COLOUR[w.bands[0]] : '169 168 162'}`;
const bandLabel = (b: Band) => BANDS.find((x) => x.id === b)!.label;

const PRECISION: Record<Precision, string> = {
  year: '确切年份', range: '有记录的起止年份', approx: '约数', century: '只能定到世纪',
  period: '只能定到时期', disputed: '有争议或不确定', deep: '最小年龄或地层年代',
};
const ESTIMATED = new Set<Precision>(['approx', 'century', 'period', 'disputed', 'deep']);
// The plan's ground: one tile per cell of the 26 × 14 grid the anchors sit on (src/data/atlas.ts). # land, o an island,
// . sea. Drawn to the anchors, not to scale: Europe and the Mediterranean are squeezed, the oceans narrowed, so that
// every anchor lands on its own land and the map still reads at a glance.
const LAND = [
  '.#####.##...############..',
  '.#####....o#############..',
  '.#####....############....',
  '..###.....############o...',
  '..##......#####.######....',
  '..##o.....#####.######o...',
  '...#.....######..#.#.o....',
  '....##.....####...o#.....o',
  '....####....###.....oooo..',
  '....####....###...........',
  '....###.....###o....####..',
  '....###.....##......####..',
  '.....#......#........##..o',
  '.....#....................',
];
const tiles = LAND.flatMap((row, r) => [...row].flatMap((t, c) => (t === '.' ? [] : [{ c, r, island: t === 'o' }])));
const MAP_NAMES = [
  { x: 3.5, y: 0.62, t: '北美洲' }, { x: 8.2, y: 12.6, t: '南美洲' }, { x: 11.5, y: 0.62, t: '欧洲' },
  { x: 13.5, y: 10.62, t: '非洲' }, { x: 17.5, y: 1.62, t: '亚洲' }, { x: 21.5, y: 10.62, t: '大洋洲' },
  { x: 7.5, y: 4.6, t: '大西洋', sea: true }, { x: 17.6, y: 9.6, t: '印度洋', sea: true }, { x: 24, y: 4.6, t: '太平洋', sea: true },
];
const PLACE: Record<string, string> = { site: '遗址或建筑', city: '城市', region: '地区', tradition: '只能定到传统或政权', unknown: '无法确定' };
const CONTACT = { 'none-known': '没有已知的接触', documented: '有记录的往来', indirect: '共同的框架，没有直接联系' };

const source = (s: Source) => {
  if (s.lesson) { const l = lessons.find((x) => x.id === s.lesson); return { label: `本站课程：${l?.data.title ?? s.lesson}`, href: `/lessons/${s.lesson}/` }; }
  if (s.essay) { const e = essays.find((x) => x.id === s.essay)!; return { label: `本站${e.data.kind === 'artist-story' ? '故事' : '案例'}：${e.data.title}`, href: essayHref(e) }; }
  return { label: s.label!, href: s.url };
};

// A work as the hall shows it: from its record (or its context entry), with its Atlas entry beside it.
function work(e: Entry) {
  const anchor = e.place.anchor ? anchors.get(e.place.anchor)! : null;
  const band = anchor?.band ?? null;
  const base = { entry: e, anchor, band, wall: band ? wallOf(band) : null };
  const c = contexts.get(e.id);
  if (c) {
    return { ...base, title: c.title, titleEn: c.titleEn, maker: c.maker, image: null, textOnly: true, record: null, official: null,
      links: c.lesson ? [{ href: `/lessons/${c.lesson}/`, label: `本站课程：${lessons.find((l) => l.id === c.lesson)?.data.title}` }] : [],
      sources: c.sources.map(source), context: true };
  }
  const r = records.get(e.id)!;
  const img = r.officialPage ? null : (r.images.find((i) => i.key === 'full') ?? r.images[0]);
  const links = [
    ...lessons.filter((l) => l.data.artwork.id === e.id || l.data.cards?.some((c) => c.id === e.id) || l.body?.includes(e.id))
      .map((l) => ({ href: `/lessons/${l.id}/`, label: `课程：${l.data.title}` })),
    ...essays.filter((x) => x.data.hero.artwork.id === e.id || x.body?.includes(e.id))
      .map((x) => ({ href: essayHref(x), label: `${x.data.kind === 'artist-story' ? '故事' : '案例'}：${x.data.title}` })),
  ];
  return { ...base, title: r.titleZh, titleEn: r.titleEn, maker: r.artist?.replace(/（[^）]*）/g, '') ?? '', image: img, textOnly: !img,
    record: `/artworks/${e.id}/`, official: r.officialPage ?? null, links, sources: [], context: false };
}
type Work = ReturnType<typeof work>;

// A window's own time axis (the overview): years as a fraction of its span, in astronomical years.
const niceSteps = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 5000, 10000, 20000];
const windows = WINDOWS.map((w, wi) => {
  const span = astro(w.to) - astro(w.from) + 1;
  const pos = (y: number) => ((astro(y) - astro(w.from)) / span) * 100;
  const step = niceSteps.find((s) => span / s <= 7)!;
  const ticks: number[] = [];
  for (let a = Math.ceil(astro(w.from) / step) * step; a <= astro(w.to); a += step) ticks.push(a <= 0 ? a - 1 : a);
  const works = w.entries.map(work);
  // One row per part of the world that has works here, works in lanes so their bars and names do not collide.
  const rows = [...WALLS, NOWHERE].map((wall) => {
    const items = works.filter((x) => wallId(x) === wall.id).sort((a, b) => a.entry.when.from - b.entry.when.from);
    const ends: number[] = [];
    const placed = items.map((x) => {
      const left = Math.max(0, pos(x.entry.when.from)), right = Math.min(100, pos(x.entry.when.to) + 100 / span);
      const width = Math.max(right - left, 0.5);
      const lw = x.title.length * 1.75 + 1.5, flip = left + lw > 100;
      const start = flip ? Math.min(left, left + width - lw) : left, end = flip ? left + width : Math.max(left + width, left + lw);
      let lane = ends.findIndex((e) => e <= start);
      if (lane === -1) { lane = ends.length; ends.push(0); }
      ends[lane] = end + 1;
      return { ...x, left, width, lane, flip, start };
    });
    return { wall, items: placed, lanes: Math.max(1, ends.length) };
  }).filter((r) => r.items.length);
  const unlocated = works.filter((x) => !x.anchor);
  const byAnchor = new Map<string, Work[]>();
  works.forEach((x) => { if (x.anchor) byAnchor.set(x.anchor.id, [...(byAnchor.get(x.anchor.id) ?? []), x]); });
  const comparisons = w.comparisons.map((c) => {
    const ws = c.works.map((id) => works.find((x) => x.entry.id === id)!);
    // The wedge between each neighbouring pair: their spans on a shared scale, and what the dates allow us to say.
    const lo = Math.min(...ws.map((x) => astro(x.entry.when.from))), hi = Math.max(...ws.map((x) => astro(x.entry.when.to))) + 1;
    const wpos = (y: number) => ((astro(y) - lo) / Math.max(1, hi - lo)) * 100;
    const wedges = ws.slice(1).map((b, i) => {
      const a = ws[i];
      return { text: relationText(relation(a.entry.when, b.entry.when)),
        a: { l: wpos(a.entry.when.from), r: wpos(a.entry.when.to) + 100 / Math.max(1, hi - lo) },
        b: { l: wpos(b.entry.when.from), r: wpos(b.entry.when.to) + 100 / Math.max(1, hi - lo) } };
    });
    return { ...c, ws, wedges, sources: c.contact.sources.map(source) };
  });
  const deep = w.entries.some((e) => e.when.precision === 'deep');
  return { ...w, wi, span, pos, ticks, works, rows, unlocated, byAnchor, comparisons, deep };
});
const shortYear = (y: number) => (y < 0 ? (y <= -10000 ? `${Math.round(-y / 1000)}k BCE` : `${-y} BCE`) : `${y}`);

// Every work once, by date: the cards of level 2. Each knows the site's comparisons it belongs to.
const cmpsOf = (id: string) => windows.flatMap((w) => w.comparisons.filter((c) => c.works.includes(id)).map((c) => [c.id, c.title, w.wi]));
const cards = windows.flatMap((w) => w.works.map((x) => ({ ...x, w })))
  .sort((a, b) => a.entry.when.from - b.entry.when.from || a.entry.when.to - b.entry.when.to);

// The timeline: all nine windows on one axis, a row for each part of the world. Each window takes an equal ninth of
// the width — the scale is even inside a window, not across them, so 72,000 years of deep time take the width of the
// last eighty — and the numerals under the axis mark the ninths.
const NINTH = 100 / WINDOWS.length;
const spanOf = (w: (typeof WINDOWS)[number]) => astro(w.to) - astro(w.from) + 1;
const winOf = (y: number) => { const i = WINDOWS.findIndex((w) => y <= w.to); return i === -1 ? WINDOWS.length - 1 : i; };
/** The left edge of year y on the axis (its right edge with `end`), in % of the axis. */
const riverX = (y: number, end = false) => {
  const i = winOf(y), w = WINDOWS[i];
  return (i + Math.min(1, (Math.max(astro(y), astro(w.from)) - astro(w.from) + (end ? 1 : 0)) / spanOf(w))) * NINTH;
};
// What counts as "around" a year: about a tenth of its window, as a plain number of years (±50 in window V).
const NEAR = [5, 10, 25, 50, 100, 250, 500, 1000, 5000, 10000];
const nearOf = (w: (typeof WINDOWS)[number]) => NEAR.find((n) => n >= spanOf(w) * 0.1) ?? 10000;
const START = 1150; // window V, where the hall opens
const startNear = nearOf(WINDOWS[winOf(START)]);
const startLo = START - startNear, startHi = START + startNear;
const river = [...WALLS, NOWHERE].map((wall) => ({ wall, marks: cards.filter((x) => wallId(x) === wall.id) })).filter((r) => r.marks.length);
const isNear = (e: Entry) => Math.max(e.when.from, startLo) <= Math.min(e.when.to, startHi);
const axisYear = (y: number) => (y <= -10000 ? `前 ${Math.round(-y / 1000) / 10} 万` : y < 0 ? `前 ${-y}` : `${y}`);
const [startEra, startNum] = yearParts(START);
const total = cards.length;
---
<section class="at" aria-labelledby="at-title" data-at>
  <!-- Before anything below is parsed: the hall is scripted, so it streams in already in its scripted shape (one
       window, the opening works, the controls) instead of the whole no-JS reading. The page restores its own scroll
       once its height is final (the script at the end), so a reload never lands on a taller page that then shrinks.
       Arriving without a selection in the address (/atlas/), the hall reopens at the visitor's last one, put into the
       address here so every script below reads it as if it had been linked. -->
  <script is:inline>
    document.currentScript.parentElement.setAttribute('data-js', '');
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    try {
      var last = localStorage.getItem('atlas-selection');
      if (!location.hash && last && /^#(y-?\d+|period-0[1-9])$/.test(last)) history.replaceState(null, '', last);
    } catch (e) { /* storage blocked: open at the default */ }
  </script>
  <header class="at-head">
    <p class="at-kicker">{d.label} · <span lang="en">{d.sub}</span></p>
    <h1 id="at-title" tabindex="-1">{d.label}</h1>
    <p class="at-premise">{d.premise}</p>
  </header>

  <!-- Level 1: time. -->
  <div class="rv" data-river data-start={START}
    data-windows={JSON.stringify(WINDOWS.map((w) => [w.from, w.to, nearOf(w), w.roman, w.label]))}>
    <div class="rv-top">
      <p class="rv-year" data-year-out><span class="rv-era">{startEra}</span><span class="rv-num" lang="en">{startNum}</span><span class="rv-era">年</span></p>    </div>
    <div class="rv-chart" data-chart aria-hidden="true">
      {river.map((r) => (
        <div class="rv-row" data-row={r.wall.id} style={wc(r.wall)}>
          <span class="rv-label">{r.wall.label}</span>
          <span class="rv-track">
            {r.marks.map((m) => (
              <span class:list={['rv-m', { est: ESTIMATED.has(m.entry.when.precision), near: isNear(m.entry) }]}
                style={`--a:${riverX(m.entry.when.from).toFixed(3)};--b:${riverX(m.entry.when.to, true).toFixed(3)}`}
                data-mark={m.entry.id} data-y0={m.entry.when.from} data-y1={m.entry.when.to} data-wall={r.wall.id}></span>
            ))}
          </span>
        </div>
      ))}
      <span class="rv-cursor" data-cursor style={`--x:${riverX(START).toFixed(3)}`}></span>
    </div>
    <div class="rv-axis" role="group" aria-label="九个时期：选一个，看整个时期">
      {windows.map((w) => (
        <button type="button" style={`--x:${w.wi * NINTH}`} data-axis-win={w.wi} aria-pressed="false" aria-label={`整个第 ${w.roman} 时期：${w.label}`}>
          <span lang="en">{w.roman}</span><span class="rv-axis-y">{axisYear(w.from)}</span>
        </button>
      ))}
    </div>
    <div class="rv-scrub" data-js-only>
      <span class="rv-range" data-range aria-hidden="true" style={`--a:${riverX(startLo).toFixed(3)};--b:${riverX(startHi, true).toFixed(3)}`}></span>
      <input type="range" min="0" max="900" step="1" data-scrub aria-label="选择年份（时间线上每个时期占同样的宽度）" />
    </div>
    <div class="rv-mode" role="group" aria-label="时间范围" data-js-only>
      <button type="button" data-mode="near" aria-pressed="true">前后 <span data-near-n>{startNear}</span> 年</button>
      <button type="button" data-mode="window" aria-pressed="false" data-window-label>整个第 V 时期</button>
    </div>
  </div>
  <!-- Before the timeline is painted: draw it at the selection in the address (#y1840, #period-05), or at the opening
       year, so a reload does not show 1150 first and then move. The same arithmetic as the module below (posOf, edge,
       nearSpan in src/lib/atlasTime.js); the module redraws the same state a moment later. -->
  <script is:inline>
    (function () {
      var root = document.currentScript.parentElement, river = root.querySelector('[data-river]');
      var b = JSON.parse(river.dataset.windows), N = b.length, last = N - 1;
      var A = function (y) { return y < 0 ? y + 1 : y; }, H = function (a) { return a <= 0 ? a - 1 : a; };
      var spanA = function (i) { return A(b[i][1]) - A(b[i][0]) + 1; };
      var winOf = function (y) { var i = b.findIndex(function (w) { return y <= w[1]; }); return i < 0 ? last : i; };
      var m = /^#y(-?\d+)$/.exec(location.hash), p = /^#(?:period-|w)0?([1-9])$/.exec(location.hash);
      var year = +river.dataset.start, mode = 'near';
      if (m && +m[1] && +m[1] >= b[0][0] && +m[1] <= b[last][1]) year = +m[1];
      else if (p) {
        var k = +p[1] - 1, s = b[k][2], a = Math.round((A(b[k][0]) + A(b[k][1])) / 2);
        year = Math.round(H(a) / s) * s; if (year === 0) year = a <= 0 ? -1 : 1;
        year = Math.max(b[k][0], Math.min(b[k][1], year)); mode = 'window';
      }
      var i = winOf(year), n = b[i][2], lo = A(year) - n, hi = A(year) + n;
      if (i > 0) lo = Math.max(lo, A(b[i][0]) - b[i - 1][2]);
      if (i < last) hi = Math.min(hi, A(b[i + 1][0]) + b[i + 1][2]);
      lo = H(Math.max(lo, A(b[0][0]))); hi = H(Math.min(hi, A(b[last][1])));
      if (mode === 'window') { lo = b[i][0]; hi = b[i][1]; }
      root._sel = { year: year, mode: mode, i: i, n: n, lo: lo, hi: hi };

      var pos = function (y) { var j = winOf(y); return j * 100 + ((A(y) - A(b[j][0]) + 0.5) / spanA(j)) * 100; };
      var edge = function (y, end) { var j = winOf(y); return (j + (A(y) - A(b[j][0]) + (end ? 1 : 0)) / spanA(j)) * (100 / N); };
      var parts = function (y) {
        if (y <= -10000) return ['约公元前', Math.round(-y / 1000) / 10 + ' 万'];
        return y < 0 ? ['公元前', String(-y)] : ['公元', String(y)];
      };
      var near = mode === 'near', out = near ? parts(year).concat('年') : ['整个时期', b[i][3], b[i][4]];
      river.toggleAttribute('data-broad', !near);
      [].forEach.call(river.querySelector('[data-year-out]').children, function (c, k) { c.textContent = out[k]; });
      river.querySelector('[data-cursor]').style.setProperty('--x', String(pos(year) / N));
      var range = river.querySelector('[data-range]');
      range.style.setProperty('--a', String(edge(lo))); range.style.setProperty('--b', String(edge(hi, true)));
      river.querySelector('[data-scrub]').value = String(pos(year));
      river.querySelectorAll('[data-mark]').forEach(function (el) {
        el.classList.toggle('near', Math.max(+el.dataset.y0, lo) <= Math.min(+el.dataset.y1, hi));
      });
      river.querySelectorAll('[data-axis-win]').forEach(function (el, j) { el.setAttribute('aria-pressed', String(!near && j === i)); });
      river.querySelectorAll('[data-mode]').forEach(function (el) { el.setAttribute('aria-pressed', String(el.dataset.mode === mode)); });
      river.querySelector('[data-near-n]').textContent = String(n);
      river.querySelector('[data-window-label]').textContent = '整个第 ' + b[i][3] + ' 时期';
    })();
  </script>

  <!-- Level 2: the works of the selection. Without the script, every work in the hall, by date. -->
  <section class="aw" aria-labelledby="aw-t">
    <div class="aw-head">
      <h2 id="aw-t" class="aw-title" tabindex="-1" data-works-title>全部作品</h2>
      <p class="aw-count" data-works-count>本页共 {total} 件作品与遗址，按年代排列。</p>
    </div>
    <div class="aw-regions" role="group" aria-label="按地区看" data-js-only>
      <button type="button" data-wall-btn="all" aria-pressed="true">全部地区 <span data-n></span></button>
      {[...WALLS, NOWHERE].map((w) => <button type="button" data-wall-btn={w.id} aria-pressed="false" style={wc(w)}>{w.label} <span data-n></span></button>)}
    </div>
    <div class="aw-empty" data-empty hidden></div>
    <ul class="aw-grid" data-grid>
      {cards.map((x) => {
        const wall = x.wall ?? NOWHERE;
        const est = ESTIMATED.has(x.entry.when.precision);
        const place = `${x.entry.place.detail}${x.anchor ? ` · ${x.anchor.label}` : ''}`;
        return (
          <li data-card={x.entry.id} data-later={isNear(x.entry) ? undefined : ''} data-y0={x.entry.when.from} data-y1={x.entry.when.to} data-precision={x.entry.when.precision}
            data-wall={wall.id} data-anchor-of={x.anchor?.id ?? 'none'} data-wi={x.w.wi} data-title={x.title} data-when={x.entry.when.label} data-region={wall.label}
            data-place={place} data-form={`${x.entry.form} · ${x.entry.tradition}`} data-cmps={JSON.stringify(cmpsOf(x.entry.id))}>
            <article class="at-card" id={`e${x.w.no}-${x.entry.id}`} style={wc(wall)}>
              <button type="button" class="at-print" data-open={x.entry.id} aria-label={`查看详情：${x.title}`}>
                {x.image
                  ? <img src={x.image.src} alt={x.image.alt} width={x.image.width} height={x.image.height} loading="lazy" decoding="async" />
                  : <span class="at-text-card"><span class="at-text-card-title">{x.title}</span><span class="at-text-card-sub">{x.context ? '本站未收录此作品 · 只有文字' : '受版权保护 · 本站只用文字介绍，可在收藏机构的官方页面观看'}</span></span>}
              </button>
              <div class="at-card-text">
                <p class="at-card-region">{wall.label}</p>
                <h3 class="at-card-title">{x.record ? <a href={x.record}>{x.title}</a> : x.title}</h3>
                {x.maker && <p class="at-card-maker">{x.maker}</p>}
                <p class="at-card-when">{x.entry.when.label}{est && <span class="at-est">年代为估计</span>}</p>
                <p class="at-note">{x.entry.note}</p>
                <details class="at-more">
                  <summary>来源与链接</summary>
                  <p class="at-card-en" lang="en">{x.titleEn}</p>
                  <dl class="at-facts">
                    <dt>年代</dt><dd>{x.entry.when.label}<span class="at-q">年代的性质：{PRECISION[x.entry.when.precision]}</span></dd>
                    <dt>制作地</dt><dd>{place}<span class="at-q">地点的精度：{PLACE[x.entry.place.precision]}{x.band && <>（{bandLabel(x.band)}）</>}</span></dd>
                    <dt>类型</dt><dd>{x.entry.form} · {x.entry.tradition}</dd>
                    <dt>时期</dt><dd>第 {x.w.roman} 时期 · {x.w.label}</dd>
                  </dl>
                  <ul class="at-links">
                    {x.record && <li><a href={x.record}>藏品记录：来源、版权与全部信息</a></li>}
                    {x.official && <li><a href={x.official.url} rel="noopener">{x.official.label}</a></li>}
                    {x.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
                    {x.sources.map((s) => <li>{s.href ? <a href={s.href} rel="noopener">{s.label}</a> : s.label}</li>)}
                  </ul>
                </details>
                <p class="at-card-actions" data-js-only>
                  <button type="button" data-open={x.entry.id}>详情</button>
                  <button type="button" data-compare={x.entry.id} aria-pressed="false">加入比较</button>
                </p>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
    <button type="button" class="aw-more" data-more hidden></button>
    <!-- Before the works are painted: the selection's heading, counts and works, in the order renderWorks() gives them
         (balanced across parts of the world, the first dozen), so the module's first render changes nothing. -->
    <script is:inline>
      (function () {
        var aw = document.currentScript.parentElement, s = aw.closest('[data-at]')._sel;
        var A = function (y) { return y < 0 ? y + 1 : y; };
        var label = function (y) {
          if (y <= -10000) return '约公元前 ' + Math.round(-y / 1000) / 10 + ' 万年';
          return y < 0 ? '公元前 ' + -y + ' 年' : y + ' 年';
        };
        var b = JSON.parse(aw.closest('[data-at]').querySelector('[data-river]').dataset.windows)[s.i], near = s.mode === 'near';
        var cards = [].slice.call(aw.querySelectorAll('[data-card]'));
        var shown = cards.filter(function (c) { return Math.max(+c.dataset.y0, s.lo) <= Math.min(+c.dataset.y1, s.hi); });
        var groups = new Map(), counts = new Map(), ordered = [];
        shown.forEach(function (c) {
          var w = c.dataset.wall; if (!groups.has(w)) groups.set(w, []); groups.get(w).push(c); counts.set(w, (counts.get(w) || 0) + 1);
        });
        for (var k = 0; ordered.length < shown.length; k++) groups.forEach(function (g) { if (g[k]) ordered.push(g[k]); });
        cards.forEach(function (c) {
          var at = ordered.indexOf(c);
          c.style.order = String(at);
          if (at > -1 && at < 12) c.removeAttribute('data-later'); else c.setAttribute('data-later', '');
        });
        var even = A(s.year) - A(s.lo) === s.n && A(s.hi) - A(s.year) === s.n;
        aw.querySelector('[data-works-title]').textContent = near
          ? label(s.year) + '前后' + (even ? ' ' + s.n + ' 年' : '') + '：' + label(s.lo) + '至 ' + label(s.hi)
          : '整个第 ' + b[3] + ' 时期：' + b[4];
        var est = shown.filter(function (c) { return /^(approx|century|period|disputed|deep)$/.test(c.dataset.precision); }).length;
        aw.querySelector('[data-works-count]').textContent = '各地共 ' + shown.length + ' 件作品'
          + (near && est ? '；其中 ' + est + ' 件的年代是估计，只是范围与这段时间有交集' : '') + '。';
        aw.querySelectorAll('[data-wall-btn]').forEach(function (btn) {
          var id = btn.dataset.wallBtn, n = id === 'all' ? shown.length : counts.get(id) || 0;
          btn.querySelector('[data-n]').textContent = String(n);
          btn.hidden = id !== 'all' && !n;
          btn.setAttribute('aria-pressed', String(id === 'all'));
        });
        var more = aw.querySelector('[data-more]');
        more.hidden = shown.length <= 12; more.textContent = '显示全部 ' + shown.length + ' 件';
        if (near && shown.length < 3) {
          var whole = cards.filter(function (c) { return Math.max(+c.dataset.y0, b[0]) <= Math.min(+c.dataset.y1, b[1]); }).length;
          var empty = aw.querySelector('[data-empty]'), go = document.createElement('button');
          go.type = 'button'; go.dataset.act = 'broaden'; go.textContent = '看整个第 ' + b[3] + ' 时期（' + whole + ' 件）';
          empty.replaceChildren(shown.length ? '这段时间里本站只收录了 ' + shown.length + ' 件作品。' : '这段时间里本站没有收录作品。',
            document.createElement('br'), go);
          empty.hidden = false;
        }
      })();
    </script>  </section>

  <!-- Level 3: deeper into the window holding the selection, on request. -->
  <section class="dp" aria-labelledby="dp-t">
    <p class="dp-kicker" id="dp-t">深入这个时期</p>
    <div class="dp-tools" role="group" aria-labelledby="dp-t" data-js-only>
      <button type="button" data-tool="a" aria-pressed="false">时期全貌</button>
      <button type="button" data-tool="c" aria-pressed="false">制作地平面图</button>
      <button type="button" data-tool="d" aria-pressed="false">本站的对照</button>
    </div>

    {windows.map((w) => (
      <section class="at-window" id={`w${w.no}`} data-window={w.wi} data-current={w.wi === winOf(START) ? '' : undefined} data-from={w.from} data-to={w.to} aria-labelledby={`w${w.no}-t`}>
        <header class="at-window-head">
          <p class="at-window-no" lang="en">{w.roman} · {w.en}</p>
          <h2 id={`w${w.no}-t`} tabindex="-1">{w.label}</h2>
          <p class="at-orientation">{w.orientation}</p>
        </header>

        <!-- The overview: the window's works on its own time axis, and what the site lacks. -->
        <div class="at-view at-view-a" data-v="a">          <div class="at-axis-scroll">
            <div class="at-axis">
              <div class="at-ticks" aria-hidden="true">
