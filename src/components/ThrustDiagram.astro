---
// Interaction: where the outward push of the high vault goes. A schematic cross-section of a nave with its aisles;
// one toggle adds or removes the flying buttresses. Arrows show direction only (one stroke width throughout); no
// forces are calculated, and arch shapes are not compared.
---
<div class="module thrust" data-thrust data-state="on">
  <p class="module-label">互动 · 推力去哪里</p>
  <h3>去掉飞扶壁，这面墙会怎样？</h3>
  <svg viewBox="0 0 400 300" role="img" aria-labelledby="thrust-title" aria-describedby="thrust-out">
    <title id="thrust-title">示意的教堂横剖面：中间高的是中殿，两侧低的是侧廊，外侧是扶壁墩。</title>
    <defs>
      <marker id="thrust-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 Z" />
      </marker>
    </defs>
    <line class="t-ground" x1="10" y1="280.5" x2="390" y2="280.5" />
    <!-- aisles and their roofs -->
    <path class="t-stone" d="M80 280 V172 H92 V280 Z M308 280 V172 H320 V280 Z" />
    <path class="t-roof" d="M78 172 L150 140 M322 172 L250 140" />
    <!-- roof over the nave and the vault inside it -->
    <path class="t-roof" d="M140 92 L200 30 L260 92" />
    <path class="t-vault" d="M155 96 Q160 60 200 52 Q240 60 245 96" />
    <!-- with flying buttresses: thin walls, tall windows -->
    <g class="t-on">
      <path class="t-stone" d="M145 280 V92 H155 V280 Z M245 280 V92 H255 V280 Z" />
      <rect class="t-glass" x="146" y="100" width="8" height="52" />
      <rect class="t-glass" x="246" y="100" width="8" height="52" />
      <path class="t-stone" d="M30 280 V112 H58 V280 Z M342 280 V112 H370 V280 Z" />
      <path class="t-flyer" d="M58 118 Q100 96 145 104 M342 118 Q300 96 255 104" />
      <path class="t-arrow" d="M141 90 Q100 80 64 100" marker-end="url(#thrust-head)" />
      <path class="t-arrow" d="M44 122 V268" marker-end="url(#thrust-head)" />
      <path class="t-arrow" d="M259 90 Q300 80 336 100" marker-end="url(#thrust-head)" />
      <path class="t-arrow" d="M356 122 V268" marker-end="url(#thrust-head)" />
    </g>
    <!-- without: the wall must hold the push itself, so it thickens and the window shrinks -->
    <g class="t-off">
      <path class="t-stone" d="M131 280 V92 H155 V280 Z M245 280 V92 H269 V280 Z" />
      <rect class="t-glass" x="146" y="112" width="8" height="24" />
      <rect class="t-glass" x="246" y="112" width="8" height="24" />
      <path class="t-arrow" d="M140 104 H104" marker-end="url(#thrust-head)" />
      <path class="t-arrow" d="M260 104 H296" marker-end="url(#thrust-head)" />
    </g>
    <text class="t-label" x="200" y="200" text-anchor="middle">中殿</text>
    <text class="t-label" x="118" y="240" text-anchor="middle">侧廊</text>
    <text class="t-label" x="282" y="240" text-anchor="middle">侧廊</text>
  </svg>
  <div class="thrust-side">
    <button type="button" class="btn btn-secondary" aria-pressed="true" data-toggle>飞扶壁：有</button>
    <p class="thrust-out" id="thrust-out" aria-live="polite" data-thrust-out></p>
    <template data-text="on"><strong>有飞扶壁。</strong>拱顶向外的推力被飞扶壁接住，传到外侧的扶壁墩，再送进地基。中殿的高墙不必独自抵住推力，可以较薄，高侧窗可以开得很大。</template>
    <template data-text="off"><strong>去掉飞扶壁。</strong>推力并没有消失，只能由墙自己抵住。墙必须做得更厚，能开窗的面积就变小了。</template>
    <p class="schematic-label">示意，不是结构计算：箭头只表示推力的大致走向，不表示大小；图中没有画出风力和屋顶的重量，也不比较尖拱与圆拱的推力。</p>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-thrust]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const out = root.querySelector<HTMLElement>('[data-thrust-out]')!;
    const show = (state: 'on' | 'off') => {
      root.dataset.state = state;
      toggle.setAttribute('aria-pressed', String(state === 'on'));
      toggle.textContent = state === 'on' ? '飞扶壁：有' : '飞扶壁：无';
      out.replaceChildren(root.querySelector<HTMLTemplateElement>(`template[data-text="${state}"]`)!.content.cloneNode(true));
    };
    toggle.addEventListener('click', () => show(root.dataset.state === 'on' ? 'off' : 'on'));
    show('on');
  });
</script>
