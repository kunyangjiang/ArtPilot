---
// A building of a few rooms in a row, each with its own door, walked one room at a time. A small plan shows the rooms
// side by side (numbered as the site numbers them, left to right); choosing a room lights it on the plan and opens one
// photograph of what survives there, with three kinds of statement kept apart: what can be seen on the wall, what
// inscriptions or excavation establish, and what is still a reading. The plan is a schematic drawn by this site, not a
// survey. Nothing is scored or stored; without script every room is listed one after another.
import { getEntry } from 'astro:content';
interface Room { id: string; label: string; image: string; seen: string; known: string; reading: string }
interface Props { artwork: string; prompt: string; rooms: Room[]; caption: string }
const { artwork, prompt, rooms, caption } = Astro.props;
const record = (await getEntry('artworks', artwork))!.data;
const img = (key: string) => {
  const i = record.images.find((x) => x.key === key);
  if (!i) throw new Error(`RoomPlan: unknown image ${artwork}/${key}`);
  return i;
};
const w = 300, h = 96, gap = 6, rw = (w - gap * (rooms.length + 1)) / rooms.length;
---
<section class="module rp" data-rp>
  <p class="module-label">互动 · 一间一间走进去</p>
  <h3>{prompt}</h3>
  <svg class="rp-plan" viewBox={`0 0 ${w} ${h + 22}`} role="img" aria-label="建筑平面示意：三间并排的屋子，各有一道门">
    <rect class="rp-wall" x="1" y="1" width={w - 2} height={h} />
    {rooms.map((r, i) => {
      const x = gap + i * (rw + gap);
      return (
        <g class="rp-room" data-room-shape={r.id}>
          <rect x={x} y={gap} width={rw} height={h - gap * 2} />
          <rect class="rp-bench" x={x + 6} y={gap + 6} width={rw - 12} height={(h - gap * 2) * 0.45} />
          <rect class="rp-door" x={x + rw / 2 - 9} y={h - gap - 1} width="18" height={gap + 2} />
          <text x={x + rw / 2} y={h + 16} text-anchor="middle">{r.label}</text>
        </g>
      );
    })}
  </svg>
  <div class="rp-tabs" role="tablist" aria-label="选择一间屋子">
    {rooms.map((r, i) => (
      <button type="button" role="tab" id={`rp-tab-${r.id}`} aria-controls={`rp-panel-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-r={r.id}>{r.label}</button>
    ))}
  </div>
  {rooms.map((r, i) => {
    const im = img(r.image);
    return (
      <div class="rp-panel" role="tabpanel" id={`rp-panel-${r.id}`} aria-labelledby={`rp-tab-${r.id}`} data-panel={r.id} hidden={i !== 0}>
        <figure class="rp-fig">
          <img src={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" decoding="async" />
          <figcaption>{im.caption}<span class="credit">{im.credit ? `${im.credit.by ?? `摄影 ${im.credit.author}`} · ${im.credit.licence}` : ''}</span></figcaption>
        </figure>
        <dl class="rp-layers">
          <div class="is-seen"><dt>墙上看得见</dt><dd>{r.seen}</dd></div>
          <div class="is-known"><dt>铭文与考古能确认</dt><dd>{r.known}</dd></div>
          <div class="is-reading"><dt>仍是解读</dt><dd>{r.reading}</dd></div>
        </dl>
      </div>
    );
  })}
  <p class="rp-cap">{caption}</p>
</section>

<style>
  .rp-plan { display: block; width: 100%; max-width: 26rem; height: auto; margin: 0 auto 1rem; }
  .rp-wall { fill: #d9d3c4; stroke: var(--ink-3); stroke-width: 1; }
  .rp-room rect:first-child { fill: var(--paper); stroke: var(--ink-3); stroke-width: 1; transition: fill var(--t) var(--ease); }
  .rp-bench { fill: none; stroke: var(--rule); stroke-width: 1; stroke-dasharray: 3 2; }
  .rp-door { fill: var(--paper); stroke: none; }
  .rp-room text { font: 500 11px var(--sans); fill: var(--ink-2); }
  :global(.rp-room.is-on) rect:first-child { fill: #c9563c; }
  :global(.rp-room.is-on) .rp-bench { stroke: #f6efe2; }
  :global(.rp-room.is-on) text { fill: var(--ink); font-weight: 700; }
  .rp-tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem; }
  .rp-tabs button { padding: .45rem .9rem; border: 1px solid var(--rule); background: var(--paper); color: var(--ink-2); font: 500 .875rem/1.4 var(--sans); cursor: pointer; }
  .rp-tabs button[aria-selected="true"] { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .rp-panel { animation: rp-in 360ms var(--ease) both; }
  .rp-fig { margin: 0; }
  .rp-fig img { display: block; width: 100%; height: auto; }
  .rp-fig figcaption { display: grid; gap: .15rem; margin-top: .45rem; font: 400 .8125rem/1.7 var(--sans); color: var(--ink-3); }
  .rp-layers { display: grid; gap: .8rem; margin: 1rem 0 0; }
  .rp-layers div { padding: .7rem 1rem; border-left: 3px solid var(--ink); background: var(--mist); }
  .rp-layers .is-known { border-left-color: #2f6b4f; }
  .rp-layers .is-reading { border-left: 3px dashed var(--ink-3); }
  .rp-layers dt { font: 600 .75rem/1.5 var(--sans); letter-spacing: .12em; color: var(--ink-3); }
  .rp-layers dd { margin: .2rem 0 0; font: 400 .9375rem/1.85 var(--sans); color: var(--ink-2); }
  .rp-cap { margin: .9rem 0 0; font: 400 .75rem/1.6 var(--sans); color: var(--ink-3); }
  @keyframes rp-in { from { opacity: 0; transform: translateY(6px); } }
  :global(.rp:not(.is-ready)) .rp-panel[hidden] { display: block; margin-top: 1.5rem; }
  :global(.rp:not(.is-ready)) .rp-tabs { display: none; }
  @media (prefers-reduced-motion: reduce) { .rp-panel { animation: none; } .rp-room rect:first-child { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rp]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const shapes = [...root.querySelectorAll<SVGGElement>('[data-room-shape]')];
    root.classList.add('is-ready');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      shapes.forEach((s, k) => s.classList.toggle('is-on', k === i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault(); select((i + d + tabs.length) % tabs.length, true);
      });
    });
    // The plan's rooms are a second way in.
    shapes.forEach((s, i) => { s.style.cursor = 'pointer'; s.addEventListener('click', () => select(i)); });
    select(0);
  });
</script>
