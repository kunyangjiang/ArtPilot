---
// The homepage: a study table (accepted in the Phase 4.6 preview). Prints of the course works lie on a dark desk, each
// shown whole (scaled to fit its place, never cropped), dealt onto the table as the page opens; the one you point at
// lifts and its label shows on the note card. The rest of the courses are tucked into one stack per stage on the right:
// a stack opens in place into a spread of all its courses. The card box holds this browser's collected cards; a slip
// under the title resumes the last article read. Behind it all, a network of lines (src/lib/lineField.ts).
// Only what exists is on the table: stages without a course are left out. The halls still being built appear only in
// the site bar, as on every other page.
import '../../styles/fonts.css';
import SiteBar from '../SiteBar.astro';
import { getCollection, getEntry } from 'astro:content';
import { stages } from '../../data/curriculum';
import tableImages from '../../data/table-images.json';
import { inCourseOrder, cardNumber } from '../../lib/publication.js';
import { imageCredit } from '../../lib/credits.js';

// The table shows scaled-down copies (whole images; scripts/table-images.mjs makes them and records their sizes, so
// every print's box is known before it loads). A lesson or card without one stops the build with what to run.
const sized = (src: string) => {
  const t = (tableImages as Record<string, { large: { src: string; width: number; height: number }; small: { src: string; width: number; height: number } }>)[src];
  if (!t) throw new Error(`No table copy of ${src}: run node scripts/table-images.mjs`);
  return t;
};
// Every published lesson, with the image the table shows: the lesson's featured image when it has one, else the full work.
const lessons = inCourseOrder(await Promise.all((await getCollection('lessons')).map(async (l) => {
  const art = (await getEntry('artworks', l.data.artwork.id))!.data;
  const key = l.data.featured?.image ?? 'full';
  const img = art.images.find((i) => i.key === key) ?? art.images[0];
  return {
    id: l.id, title: l.data.title, course: l.data.course, workLabel: l.data.workLabel, artwork: l.data.artwork.id, no: cardNumber(l.data.course),
    image: { ...sized(img.src).large, alt: img.alt, small: sized(img.src).small.src }, credit: imageCredit(img, art),
  };
})));
const stageOf = (n: number) => stages.find((st) => n >= st.first && n <= st.last)!;
// Stages that have at least one course; the others are not shown.
const shelves = stages
  .map((st) => ({ ...st, lessons: lessons.filter((l) => stageOf(l.course) === st) }))
  .filter((st) => st.lessons.length);
// Places on the table (canvas 1440 × 820): the box a print may fill, and its turn. Place 0 is the largest, today's
// first work. A print is scaled to fit its box whole; a wide work in a tall box simply lies smaller.
const places = [
  { x: 430, y: 36, w: 340, h: 470, r: 2.5 },
  { x: 742, y: 70, w: 220, h: 310, r: -3 },
  { x: 968, y: 40, w: 170, h: 210, r: 4 },
  { x: 700, y: 420, w: 260, h: 250, r: 5 },
  { x: 418, y: 530, w: 200, h: 190, r: -6 },
  { x: 978, y: 470, w: 160, h: 200, r: 7 },
  { x: 980, y: 265, w: 160, h: 170, r: -4 },
];
const shown = lessons.slice(0, places.length);
const reserve = lessons.slice(places.length);
const courseOf = new Map(lessons.map((l) => [l.artwork, l.course]));
const cards = (await getCollection('artworks')).filter((a) => a.data.card && courseOf.has(a.id))
  .map((a) => ({ id: a.id, no: cardNumber(courseOf.get(a.id)!), title: a.data.titleZh, cabinet: stageOf(courseOf.get(a.id)!).no, src: sized((a.data.images.find((i: any) => i.key === 'full') ?? a.data.images[0]).src).small.src }))
  .sort((a, b) => a.no.localeCompare(b.no));
const registry = { lesson: { label: '课程', items: Object.fromEntries(lessons.map((l) => [l.id, { title: l.title, href: `/lessons/${l.id}/` }])) } };
const print = (l: (typeof lessons)[number], k: number) => ({
  href: `/lessons/${l.id}/`, 'data-print': l.id, 'data-stage': stageOf(l.course).no, 'data-order': k, 'data-no': l.no, 'data-label': l.workLabel, 'data-title': l.title,
});
// Today's prints: the first from the day's number, then one per stage in turn, both rotating daily. Run before first paint.
const dealScript = `(function(){var c=document.querySelector('[data-canvas]');if(!c)return;var tpl=c.querySelector('[data-reserve]');
var all=[].slice.call(c.querySelectorAll('[data-print]')).concat([].slice.call(tpl.content.querySelectorAll('[data-print]'))).sort(function(a,b){return a.getAttribute('data-order')-b.getAttribute('data-order')});
var d=new Date(),day=Math.floor(Date.UTC(d.getFullYear(),d.getMonth(),d.getDate())/864e5);var slots=[].slice.call(c.querySelectorAll('[data-slot]'));
var hero=all[day%all.length],hang=[hero],by={};all.forEach(function(p){if(p!==hero)(by[p.getAttribute('data-stage')]=by[p.getAttribute('data-stage')]||[]).push(p)});
var keys=Object.keys(by).sort();keys.forEach(function(k){var l=by[k],i=day%l.length;by[k]=l.slice(i).concat(l.slice(0,i))});var o=keys.length?day%keys.length:0;
for(var r=0;hang.length<slots.length&&r<all.length;r++)for(var j=0;j<keys.length&&hang.length<slots.length;j++){var l=by[keys[(j+o)%keys.length]];if(l[r])hang.push(l[r])}
slots.forEach(function(s,k){if(hang[k]){s.appendChild(hang[k]);var i=hang[k].querySelector('img');if(i)i.loading='eager'}});all.forEach(function(p){if(hang.indexOf(p)<0)tpl.content.appendChild(p)});
var ids=hang.map(function(p){return p.getAttribute('data-print')});[].slice.call(document.querySelectorAll('[data-credit-for]')).forEach(function(p){p.hidden=ids.indexOf(p.getAttribute('data-credit-for'))<0});
window.__stHero=hero})();`;
---
<div class="st" data-st>
  <!-- The desk's grain: a loose network of lines and faint facets that drifts with the pointer (and with scrolling). -->
  <canvas class="st-web" data-web aria-hidden="true"></canvas>
  <SiteBar tone="gallery" />

  <div class="st-table" data-table>
    <div class="st-canvas" data-canvas>
      <section class="st-paper st-title" aria-labelledby="st-h">
        <p class="st-kicker">全球艺术史 · 数字美术馆</p>
        <h1 id="st-h">从一件作品开始，<br />走进全球艺术史。</h1>
        <a class="st-go" href="/courses/"><span class="st-go-main">进入课程</span><span class="st-go-arrow" aria-hidden="true"></span></a>
        <p class="st-meta">共 {lessons.length} 门课程 · {shelves.length} 个阶段</p>
      </section>

      <a class="st-paper st-slip" data-continue hidden href="/courses/">
        <span class="st-slip-kind" data-continue-kind>继续阅读</span>
        <span class="st-slip-title" data-continue-title></span>
        <span class="st-slip-bar"><span class="st-meter" aria-hidden="true"><span data-continue-bar></span></span><span data-continue-p></span></span>
      </a>

      <div class="st-deck" data-deck>
        {places.map((p, k) => (
          <div class="st-slot" data-slot={k} style={`--x:${p.x}px;--y:${p.y}px;--w:${p.w}px;--h:${p.h}px;--r:${p.r}deg;--d:${k};--fx:${1250 - p.x - p.w / 2}px;--fy:${110 - p.y}px`}>
            {shown[k] && (
              <a class="st-print" {...print(shown[k], k)}>
                <img src={shown[k].image.src} alt={shown[k].image.alt} width={shown[k].image.width} height={shown[k].image.height} loading={k < 3 ? 'eager' : 'lazy'} />
                <span class="st-no" lang="en">No.{shown[k].no}</span>
              </a>
            )}
          </div>
        ))}
      </div>
      <p class="st-dots" aria-hidden="true" data-dots>{places.map((_, k) => <i class:list={{ 'is-on': k === 0 }}></i>)}</p>
      <template data-reserve>
        {reserve.map((l, k) => (
          <a class="st-print" {...print(l, k + places.length)}>
            <img src={l.image.src} alt={l.image.alt} width={l.image.width} height={l.image.height} loading="lazy" />
            <span class="st-no" lang="en">No.{l.no}</span>
          </a>
        ))}
      </template>
      <script is:inline set:html={dealScript}></script>

      <!-- The label of the print you are looking at (today's first, until you point at another). -->
      <p class="st-note" data-note aria-live="polite">
        <span class="st-note-no" lang="en" data-note-no>No.{shown[0]?.no}</span><span data-note-label>{shown[0]?.workLabel}</span>
        <span class="st-note-q" data-note-q>{shown[0]?.title}</span>
      </p>

      <a class="st-tray" href="/collection/" data-tray>
        <span class="st-tray-h">我的收藏</span>
        <span class="st-tray-n" data-tray-count>读完一门课程，在课末领取它的藏品卡</span>
        <span class="st-tray-cards" data-tray-cards>
          {[0, 1, 2, 3].map(() => <span class="st-mini st-mini-empty"></span>)}
        </span>
      </a>
      <script type="application/json" data-cards set:html={JSON.stringify(cards).replace(/</g, '\\u003c')}></script>

      <nav class="st-shelves" aria-label="按阶段浏览课程">
        <p class="st-kicker">{shelves.length} 个阶段 · {lessons.length} 门课程</p>
        {shelves.map((st) => (
          <button class="st-stack" type="button" data-open={st.no} aria-haspopup="dialog">
            <span class="st-deckpile" aria-hidden="true">
              {st.lessons.length > 2 && <i></i>}{st.lessons.length > 1 && <i></i>}
              <i class="st-top"><img src={st.lessons[0].image.small} alt="" loading="lazy" /></i>
            </span>
            <span class="st-stack-t"><b lang="en">{st.no}</b><span>{st.title}</span><em>第 {st.first}–{st.last} 课 · {st.lessons.length} 门</em></span>
          </button>
        ))}
        <a class="st-all" href="/courses/">翻开全部课程 →</a>
      </nav>
    </div>
  </div>

  <!-- A stage, opened: all its courses laid out as prints. -->
  <div class="st-spread" data-spread hidden>
    <div class="st-spread-back" data-close></div>
    {shelves.map((st) => (
      <section class="st-spread-panel" role="dialog" aria-modal="true" aria-labelledby={`st-s-${st.no}`} data-panel={st.no} hidden>
        <header class="st-spread-h">
          <p class="st-kicker">第 {st.no} 阶段 · 第 {st.first}–{st.last} 课</p>
          <h2 id={`st-s-${st.no}`}>{st.title}</h2>
          <button class="st-close" type="button" data-close>收起 <span aria-hidden="true">×</span></button>
        </header>
        <ol class="st-spread-list">
          {st.lessons.map((l, k) => (
            <li style={`--k:${k}`}>
              <a href={`/lessons/${l.id}/`}>
                <span class="st-sp-print"><img src={l.image.src} alt={l.image.alt} width={l.image.width} height={l.image.height} loading="lazy" /></span>
                <span class="st-sp-cap"><span lang="en">No.{l.no}</span>{l.workLabel}<em>{l.title}</em></span>
              </a>
            </li>
          ))}
        </ol>
        <a class="st-all" href="/courses/">在课程目录中查看 →</a>
      </section>
    ))}
  </div>

  <footer class="st-credits">
    <p class="st-kicker">图片来源</p>
    {lessons.map((l) => <p data-credit-for={l.id} hidden={!shown.includes(l)}>{l.workLabel}。{l.credit.by}，{l.credit.licenceUrl ? <a href={l.credit.licenceUrl}>{l.credit.licence}</a> : l.credit.licence}，<a href={l.credit.href}>来源</a>。</p>)}
    <p>完整的来源与授权，见各课程页的“来源与版权”。</p>
  </footer>
  <script type="application/json" data-reading-registry set:html={JSON.stringify(registry).replace(/</g, '\\u003c')}></script>
</div>

<style>
  :global(html:has(.st)) { background: #171716; }
  :global(body:has(.st)) { margin: 0; }
  .st {
    --serif: "ArtPilot Serif SC", "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
    --sans: "ArtPilot Sans SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
    --latin: "ArtPilot Bodoni", "Bodoni Moda", Didot, serif;
    --desk: #171716; --ink: #ecebe7; --ink-2: #a9a8a2; --ink-3: #6f6e69; --rule: rgb(255 255 255 / .14);
    --paper: #ecebe7; --paper-ink: #1b1b1a; --paper-ink-2: #5b5a56;
    --t: 180ms; --ease: cubic-bezier(.2, .7, .2, 1); --s: 1;
    position: relative; isolation: isolate; min-height: 100vh; color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased;
    background: radial-gradient(60% 55% at 45% 40%, rgb(255 244 225 / .06), transparent 70%), var(--desk);
  }
  .st-web { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
  .st a { color: inherit; }
  .st-kicker { margin: 0; font: 500 12px/1.5 var(--sans); letter-spacing: .2em; color: var(--ink-2); }

  /* The table: a fixed 1440 × 820 canvas, scaled to the window (--s, set by the script below). */
  .st-table { position: relative; height: calc(820px * var(--s)); overflow: hidden; }
  .st-canvas { position: absolute; left: 50%; top: 0; width: 1440px; height: 820px; transform: translateX(-50%) scale(var(--s)); transform-origin: top center; }

  .st .st-paper { position: absolute; background: var(--paper); color: var(--paper-ink); box-shadow: 0 1px 2px rgb(0 0 0 / .5), 0 18px 30px -12px rgb(0 0 0 / .8); }
  .st-title { left: 64px; top: 48px; width: 340px; padding: 28px 30px 30px; transform: rotate(-2deg); }
  .st-title .st-kicker { color: var(--paper-ink-2); }
  .st-title h1 { margin: 14px 0 0; font: 500 30px/1.4 var(--serif); letter-spacing: .04em; }
  .st-go { display: inline-flex; align-items: center; gap: 18px; margin-top: 22px; text-decoration: none; }
  .st-go-main { font: 500 21px/1.3 var(--serif); letter-spacing: .08em; text-decoration: underline 1px transparent; text-underline-offset: .32em; transition: text-decoration-color var(--t) var(--ease); }
  .st-go-arrow { position: relative; width: 44px; height: 1px; background: currentColor; transition: width var(--t) var(--ease); }
  .st-go-arrow::after { content: ""; position: absolute; right: 0; top: -4px; width: 8px; height: 8px; border-top: 1px solid; border-right: 1px solid; transform: rotate(45deg); }
  .st-go:hover .st-go-main, .st-go:focus-visible .st-go-main { text-decoration-color: var(--paper-ink-2); }
  .st-go:hover .st-go-arrow, .st-go:focus-visible .st-go-arrow { width: 60px; }
  .st-meta { margin: 6px 0 0; font: 400 12px/1.6 var(--sans); letter-spacing: .12em; color: var(--paper-ink-2); }

  /* Continue reading: a slip of paper tucked under the title card. */
  .st-slip { left: 92px; top: 336px; width: 290px; display: grid; gap: 6px; padding: 14px 18px 16px; transform: rotate(1.2deg); text-decoration: none; transition: transform var(--t) var(--ease); }
  .st-slip[hidden] { display: none; }
  .st-slip:hover, .st-slip:focus-visible { transform: rotate(0deg) translateY(-3px); }
  .st-slip-kind { font: 500 11px/1.5 var(--sans); letter-spacing: .18em; color: var(--paper-ink-2); }
  .st-slip-title { font: 400 15px/1.5 var(--serif); letter-spacing: .03em; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .st-slip-bar { display: flex; align-items: center; gap: 10px; font: 400 11px/1 var(--sans); color: var(--paper-ink-2); font-variant-numeric: tabular-nums; }
  .st-meter { flex: 1; height: 2px; background: rgb(0 0 0 / .14); }
  .st-meter > span { display: block; height: 100%; width: 0; background: var(--paper-ink-2); }

  /* Prints: the whole work on a paper mount, scaled to fit its place. */
  .st-deck { display: contents; }
  .st-slot { position: absolute; left: var(--x); top: var(--y); width: var(--w); height: var(--h); display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .st-slot:has(.st-print:hover, .st-print:focus-visible) { z-index: 5; }
  .st-print { position: relative; display: block; padding: 9px 9px 30px; background: var(--paper); text-decoration: none; pointer-events: auto;
    box-shadow: 0 1px 2px rgb(0 0 0 / .5), 0 18px 30px -12px rgb(0 0 0 / .8); transform: rotate(var(--r));
    transition: transform 320ms var(--ease), box-shadow 320ms var(--ease); }
  .st-print img { display: block; width: auto; height: auto; max-width: calc(var(--w) - 18px); max-height: calc(var(--h) - 39px); }
  .st-no { position: absolute; left: 10px; bottom: 9px; font: 400 12px/1 var(--latin); letter-spacing: .06em; color: #45443f; }
  .st-print:hover, .st-print:focus-visible { transform: rotate(0deg) translateY(-8px) scale(1.05); box-shadow: 0 2px 4px rgb(0 0 0 / .4), 0 50px 60px -24px rgb(0 0 0 / .95); outline: none; }
  .st-print:focus-visible { box-shadow: 0 0 0 2px var(--desk), 0 0 0 4px var(--ink), 0 50px 60px -24px rgb(0 0 0 / .95); }

  /* The note card: today's first work, or the one you point at. */
  .st-note { position: absolute; left: 640px; top: 700px; width: 300px; margin: 0; padding: 13px 16px 14px; background: #1f1f1d; border: 1px solid var(--rule); transform: rotate(-1deg);
    font: 400 13px/1.6 var(--sans); letter-spacing: .04em; color: var(--ink-2); box-shadow: 0 14px 26px -14px rgb(0 0 0 / .8); }
  .st-note-no { margin-right: 8px; font: 400 13px/1 var(--latin); letter-spacing: .06em; }
  .st-note-q { display: block; margin-top: 2px; font: 500 16px/1.6 var(--serif); color: var(--ink); }
  :global(.st-note.is-swapping) > * { opacity: 0; transform: translateY(4px); }
  .st-note > * { transition: opacity 160ms var(--ease), transform 160ms var(--ease); }

  /* The card box: this browser's collected cards. */
  .st-tray { position: absolute; left: 64px; top: 520px; width: 330px; height: 232px; padding: 18px 20px; display: block; text-decoration: none;
    border: 1px solid rgb(255 255 255 / .2); background: #121211; box-shadow: inset 0 10px 24px rgb(0 0 0 / .7), 0 18px 30px -12px rgb(0 0 0 / .7);
    transform: rotate(-1.5deg); transition: border-color var(--t) var(--ease); }
  .st-tray:hover, .st-tray:focus-visible { border-color: rgb(255 255 255 / .4); }
  .st-tray-h { display: block; font: 500 16px/1.4 var(--serif); letter-spacing: .05em; }
  .st-tray-h::after { content: " →"; font-family: var(--sans); color: var(--ink-2); }
  .st-tray-n { display: block; margin-top: 2px; font: 400 12px/1.6 var(--sans); letter-spacing: .06em; color: var(--ink-2); }
  .st-tray-cards { position: absolute; left: 22px; right: 22px; bottom: 26px; display: flex; gap: 12px; align-items: flex-end; }
  .st-mini { width: 62px; height: 86px; flex: none; }
  .st-mini-empty { border: 1px dashed rgb(255 255 255 / .2); }
  :global(.st-mini.is-held) { display: flex; align-items: center; justify-content: center; padding: 4px 4px 14px; background: var(--paper); box-shadow: 0 6px 12px rgb(0 0 0 / .6); position: relative; }
  :global(.st-mini.is-held img) { max-width: 100%; max-height: 100%; width: auto; height: auto; display: block; }
  :global(.st-mini.is-held span) { position: absolute; left: 4px; bottom: 3px; font: 400 9px/1 var(--latin); color: #45443f; }
  :global(.st-mini-more) { display: flex; align-items: center; justify-content: center; font: italic 400 15px/1 var(--latin); color: var(--ink-2); border: 1px dashed rgb(255 255 255 / .2); }
  .st-tray-cards > :nth-child(1) { transform: rotate(-4deg); } .st-tray-cards > :nth-child(2) { transform: rotate(3deg); }
  .st-tray-cards > :nth-child(3) { transform: rotate(-1deg); } .st-tray-cards > :nth-child(4) { transform: rotate(2deg); }

  /* The stacks: one per stage that has courses; a stack opens into a spread. */
  .st-shelves { position: absolute; left: 1176px; top: 44px; width: 220px; }
  .st-shelves .st-kicker { margin-bottom: 14px; font-size: 11px; }
  .st-stack { display: flex; align-items: center; gap: 16px; width: 100%; min-height: 84px; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; font: inherit; }
  .st-deckpile { position: relative; width: 52px; height: 66px; flex: none; }
  .st-deckpile i { position: absolute; inset: 0; border: 1px solid rgb(255 255 255 / .25); background: #1d1d1b; transition: transform 260ms var(--ease); }
  .st-deckpile i:nth-child(1):not(.st-top) { transform: translate(8px, -6px) rotate(4deg); }
  .st-deckpile i:nth-child(2):not(.st-top) { transform: translate(4px, -3px) rotate(2deg); }
  .st-deckpile .st-top { display: flex; align-items: center; justify-content: center; padding: 3px; border: 0; background: var(--paper); }
  .st-deckpile .st-top img { max-width: 100%; max-height: 100%; width: auto; height: auto; display: block; }
  .st-stack:hover .st-deckpile i:nth-child(1):not(.st-top), .st-stack:focus-visible .st-deckpile i:nth-child(1):not(.st-top) { transform: translate(14px, -10px) rotate(9deg); }
  .st-stack:hover .st-deckpile i:nth-child(2):not(.st-top), .st-stack:focus-visible .st-deckpile i:nth-child(2):not(.st-top) { transform: translate(7px, -5px) rotate(5deg); }
  .st-stack:hover .st-top, .st-stack:focus-visible .st-top { transform: translateY(-3px); }
  .st-stack:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .st-stack-t b { display: block; font: 400 13px/1 var(--latin); color: var(--ink-2); }
  .st-stack-t span { display: block; margin-top: 5px; font: 400 13.5px/1.35 var(--serif); }
  .st-stack-t em { display: block; margin-top: 4px; font: 400 11px/1 var(--sans); font-style: normal; letter-spacing: .08em; color: var(--ink-2); }
  .st-all { display: inline-block; margin-top: 18px; font: 500 13px/1.5 var(--sans); letter-spacing: .08em; text-decoration: none; border-bottom: 1px solid var(--ink-2); padding-bottom: 2px; }

  /* The dealing: each print slides off the stacks onto its place as the page opens. */
  @keyframes st-deal { from { opacity: 0; transform: translate(var(--fx), var(--fy)) rotate(calc(var(--r) + 16deg)) scale(.55); } }
  @keyframes st-rise { from { opacity: 0; transform: translateY(18px) rotate(var(--rr, 0deg)); } }
  /* The paper on the left (title card, reading slip, card box) is slid onto the desk from the left, turning as it lands,
     on the same curve and about the same length as the prints. */
  @keyframes st-slide { from { opacity: 0; transform: translate(-140px, 36px) rotate(calc(var(--rr, 0deg) - 9deg)) scale(.94); } 55% { opacity: 1; } }
  @media (prefers-reduced-motion: no-preference) {
    .st-print { animation: st-deal 900ms var(--ease) backwards; animation-delay: calc(240ms + var(--d) * 110ms); }
    .st-title { --rr: -2deg; animation: st-slide 1000ms var(--ease) 80ms backwards; }
    .st-slip { --rr: 1.2deg; animation: st-slide 1000ms var(--ease) 380ms backwards; }
    .st-tray { --rr: -1.5deg; animation: st-slide 1100ms var(--ease) 620ms backwards; }
    .st-note { --rr: -1deg; animation: st-rise 600ms var(--ease) 1100ms backwards; }
    .st-stack { animation: st-rise 500ms var(--ease) backwards; }
    .st-stack:nth-of-type(2) { animation-delay: 60ms; } .st-stack:nth-of-type(3) { animation-delay: 120ms; } .st-stack:nth-of-type(4) { animation-delay: 180ms; }
    .st-stack:nth-of-type(5) { animation-delay: 240ms; } .st-stack:nth-of-type(6) { animation-delay: 300ms; } .st-stack:nth-of-type(7) { animation-delay: 360ms; }
  }

  /* The spread */
  .st-spread { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 40px; }
  .st-spread[hidden] { display: none; }
  .st-spread-back { position: absolute; inset: 0; background: rgb(10 10 9 / .72); backdrop-filter: blur(3px); }
  .st-spread-panel { position: relative; width: min(1180px, 100%); max-height: calc(100vh - 80px); overflow: auto; padding: 30px 36px 34px; background: #1c1c1a; border: 1px solid var(--rule); box-shadow: 0 40px 80px -30px rgb(0 0 0 / .9); }
  .st-spread-panel[hidden] { display: none; }
  .st-spread-h { display: grid; grid-template-columns: 1fr auto; align-items: end; padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
  .st-spread-h .st-kicker { grid-column: 1; font-family: var(--latin); letter-spacing: .14em; }
  .st-spread-h h2 { grid-column: 1; margin: 6px 0 0; font: 500 24px/1.4 var(--serif); letter-spacing: .05em; }
  .st-close { grid-column: 2; grid-row: 1 / 3; padding: 8px 0 8px 16px; border: 0; background: none; color: var(--ink-2); font: 400 13px/1 var(--sans); letter-spacing: .1em; cursor: pointer; }
  .st-close:hover, .st-close:focus-visible { color: var(--ink); }
  .st-spread-list { display: flex; flex-wrap: wrap; gap: 34px 30px; margin: 30px 0 0; padding: 0; list-style: none; align-items: flex-end; }
  .st-spread-list li { width: 170px; }
  .st-spread-list a { display: block; text-decoration: none; }
  .st-sp-print { display: flex; align-items: flex-end; justify-content: center; height: 210px; }
  .st-sp-print img { display: block; max-width: 170px; max-height: 210px; width: auto; height: auto; padding: 7px 7px 7px; background: var(--paper); box-shadow: 0 16px 28px -12px rgb(0 0 0 / .85); transition: transform 260ms var(--ease); }
  .st-spread-list a:hover img, .st-spread-list a:focus-visible img { transform: translateY(-5px) rotate(-1deg); }
  .st-sp-cap { display: block; margin-top: 12px; font: 400 12px/1.6 var(--sans); letter-spacing: .03em; color: var(--ink-2); }
  .st-sp-cap span { margin-right: 6px; font: 400 12px/1 var(--latin); }
  .st-sp-cap em { display: block; margin-top: 2px; font: 500 14px/1.55 var(--serif); font-style: normal; color: var(--ink); }
  .st-spread-panel > .st-all { margin-top: 30px; }
  @keyframes st-fan { from { opacity: 0; transform: translate(calc(-40px - var(--k) * 6px), 30px) rotate(-6deg); } }
  @media (prefers-reduced-motion: no-preference) {
    .st-spread-list li { animation: st-fan 520ms var(--ease) backwards; animation-delay: calc(var(--k) * 55ms); }
    .st-spread-panel { animation: st-rise 360ms var(--ease) backwards; }
  }

  .st-dots { display: none; margin: 0; }

  /* The site bar, as on every page, but not pinned here (the homepage has always scrolled it away); the lines show
     faintly through it. */
  .st :global(.site-nav) { position: relative; z-index: 2; background: rgb(23 23 22 / .86); }

  .st-credits { position: relative; max-width: 1328px; margin: 0 auto; padding: 22px 56px 48px; border-top: 1px solid var(--rule); font: 400 12px/1.8 var(--sans); color: var(--ink-2); }
  .st-credits p { margin: 0; }
  .st-credits .st-kicker { margin-bottom: 6px; font-size: 11px; }

  /* ---------- Phones: the title, today's prints as one pile you swipe through, the stages as a row of stacks,
     the card box. Every print still whole. ---------- */
  @media (max-width: 900px) {
    .st-table { height: auto; overflow: visible; }
    .st-canvas { position: static; width: auto; height: auto; transform: none; display: flex; flex-direction: column; padding: 22px 0 10px; }
    .st .st-title { position: relative; left: auto; top: auto; width: auto; margin: 0 20px; padding: 22px 22px 24px; transform: rotate(-1deg); }
    .st-title h1 { font-size: 25px; }
    .st .st-slip { position: relative; left: auto; top: auto; width: auto; margin: -6px 34px 0; transform: rotate(1deg); }
    .st-deck { display: flex; order: 3; gap: 0; margin-top: 26px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 18px 0 12px; }
    .st-deck::-webkit-scrollbar { display: none; }
    /* Neighbouring prints show at the edges, so the pile reads as something to swipe through. */
    /* One size for every place (the inline boxes are the desk's); each print still keeps its own shape. */
    .st-slot { --fx: 50px; --fy: 30px; position: relative; left: auto; top: auto; flex: 0 0 74vw; width: auto; height: min(54vh, 430px); scroll-snap-align: center; }
    .st-print img { max-width: calc(68vw - 18px); max-height: calc(min(54vh, 430px) - 39px); }
    .st-slot:first-child { margin-left: 13vw; } .st-slot:last-child { margin-right: 13vw; }
    .st-dots { display: flex; justify-content: center; gap: 6px; margin: 4px 0 14px; }
    .st-dots i { width: 14px; height: 2px; background: var(--rule); transition: background var(--t) var(--ease), width var(--t) var(--ease); }
    .st-dots i.is-on { width: 24px; background: var(--ink); }
    .st-note { order: 4; position: relative; left: auto; top: auto; width: auto; margin: 6px 20px 0; transform: none; }
    .st-dots { order: 4; }
    .st-shelves { order: 5; position: relative; left: auto; top: auto; width: auto; margin-top: 34px; padding: 0 20px; }
    .st-shelves .st-kicker { margin-bottom: 8px; }
    .st-stack { width: auto; min-height: 76px; }
    .st-shelf-row { display: flex; }
    .st-tray { order: 6; position: relative; left: auto; top: auto; width: auto; height: 200px; margin: 26px 20px 0; transform: none; }
    .st-spread { padding: 0; place-items: end stretch; }
    .st-spread-panel { width: 100%; max-height: 88vh; padding: 22px 20px 28px; border-radius: 14px 14px 0 0; border-width: 1px 0 0; }
    .st-spread-list { gap: 26px 16px; justify-content: space-between; }
    .st-spread-list li { width: calc(50% - 8px); }
    .st-sp-print { height: 190px; }
    .st-sp-print img { max-width: 100%; max-height: 190px; }
    .st-credits { padding: 20px 20px 40px; }
    .st-print:hover { transform: rotate(var(--r)); }
  }
  /* Phones: the stacks in two columns, so every stage is in reach without a long list. */
  @media (max-width: 900px) {
    .st-shelves { display: grid; grid-template-columns: 1fr 1fr; column-gap: 14px; }
    .st-shelves .st-kicker, .st-shelves .st-all { grid-column: 1 / -1; }
    .st-stack { gap: 12px; }
    .st-deckpile { width: 44px; height: 56px; }
    .st-stack-t span { font-size: 13px; }
  }
</style>

<script>
  import { readReading, resolveEntry } from '../../lib/reading.js';
  import { readCollection } from '../../lib/collection.js';
  import { deviceStorage } from '../../lib/storage.js';
  import { startLineField } from '../../lib/lineField';

  const canvas = document.querySelector<HTMLElement>('[data-canvas]')!;
  const st = document.querySelector<HTMLElement>('[data-st]')!;
  const wide = matchMedia('(min-width: 901px)');
  // The table fits the window: the 1440 × 820 canvas scaled by the smaller of the two ratios (a little larger allowed).
  const fit = () => { st.style.setProperty('--s', wide.matches ? String(Math.min(1.25, innerWidth / 1440, (innerHeight - (document.querySelector('.site-nav')?.getBoundingClientRect().height ?? 56)) / 820)) : '1'); };
  fit();
  addEventListener('resize', fit);
  wide.addEventListener('change', fit);

  // The note card follows the print you point at, and returns to today's first when you leave the table.
  const note = document.querySelector<HTMLElement>('[data-note]')!;
  let current: Element | null = (window as any).__stHero ?? document.querySelector('[data-slot] [data-print]');
  const setNote = (p: Element | null) => {
    if (!p || p === current) return;
    current = p;
    note.classList.add('is-swapping');
    setTimeout(() => {
      note.querySelector('[data-note-no]')!.textContent = `No.${p.getAttribute('data-no')}`;
      note.querySelector('[data-note-label]')!.textContent = p.getAttribute('data-label');
      note.querySelector('[data-note-q]')!.textContent = p.getAttribute('data-title');
      note.classList.remove('is-swapping');
    }, 150);
  };
  const hero = () => document.querySelector('[data-slot="0"] [data-print]');
  current = null; setNote(hero());
  canvas.querySelectorAll('[data-slot]').forEach((s) => {
    s.addEventListener('mouseover', (e) => setNote((e.target as Element).closest('[data-print]')));
    s.addEventListener('focusin', (e) => setNote((e.target as Element).closest('[data-print]')));
  });
  document.querySelector('[data-deck]')!.addEventListener('mouseleave', () => { if (wide.matches) setNote(hero()); });
  // Phones: the note follows the print in the middle of the pile.
  const dots = [...document.querySelectorAll('[data-dots] i')];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (wide.matches || !e.isIntersecting) return;
    setNote(e.target.querySelector('[data-print]'));
    const k = Number((e.target as HTMLElement).dataset.slot);
    dots.forEach((d, i) => d.classList.toggle('is-on', i === k));
  }),
    { root: document.querySelector('[data-deck]'), threshold: 0.6 });
  canvas.querySelectorAll('[data-slot]').forEach((s) => io.observe(s));

  // The card box: this browser's cards, lowest numbers first, at most three and then how many more.
  const showCards = () => {
    const cards: { id: string; no: string; title: string; cabinet: string; src: string }[] = JSON.parse(document.querySelector('[data-cards]')!.textContent!);
    const held = readCollection(deviceStorage());
    const mine = cards.filter((c) => held[c.id]);
    const box = document.querySelector<HTMLElement>('[data-tray-cards]')!;
    document.querySelector('[data-tray-count]')!.textContent = mine.length ? `已收藏 ${mine.length} 件 · 陈列在 ${new Set(mine.map((c) => c.cabinet)).size} 个展柜` : '读完一门课程，在课末领取它的藏品卡';
    box.replaceChildren(...[0, 1, 2, 3].map((k) => {
      const el = document.createElement('span');
      const c = mine[k];
      if (k === 3 && mine.length > 4) { el.className = 'st-mini st-mini-more'; el.textContent = `+${mine.length - 3}`; return el; }
      if (!c) { el.className = 'st-mini st-mini-empty'; return el; }
      el.className = 'st-mini is-held';
      const img = new Image(); img.src = c.src; img.alt = ''; img.loading = 'lazy';
      const n = document.createElement('span'); n.textContent = `No.${c.no}`;
      el.append(img, n);
      return el;
    }));
    // Scoped styles reach the new elements through the attribute Astro gives this component's elements.
    const attr = [...box.attributes].find((a) => a.name.startsWith('data-astro-cid'));
    if (attr) box.querySelectorAll('*').forEach((x) => x.setAttribute(attr.name, ''));
  };

  // Continue reading: one slip, only when this browser has an article to resume.
  const showReading = () => {
    const slip = document.querySelector<HTMLAnchorElement>('[data-continue]')!;
    const hit = resolveEntry(readReading(deviceStorage()), JSON.parse(document.querySelector('[data-reading-registry]')!.textContent!));
    slip.hidden = !hit;
    if (!hit) return;
    slip.href = `${hit.href}#resume`;
    slip.querySelector('[data-continue-kind]')!.textContent = `继续阅读 · ${hit.label}`;
    slip.querySelector('[data-continue-title]')!.textContent = hit.title;
    slip.querySelector('[data-continue-p]')!.textContent = `${Math.round(hit.p * 100)}%`;
    slip.querySelector<HTMLElement>('[data-continue-bar]')!.style.width = `${Math.round(hit.p * 100)}%`;
  };
  showCards(); showReading();
  addEventListener('pageshow', (e) => { if (e.persisted) { showCards(); showReading(); } });

  // A stack opens into its spread; Escape, the backdrop or "收起" put it back and return focus to the stack.
  const spread = document.querySelector<HTMLElement>('[data-spread]')!;
  let opener: HTMLElement | null = null;
  const close = () => {
    spread.hidden = true;
    spread.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = true; });
    document.documentElement.style.overflow = '';
    opener?.focus();
  };
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
    opener = b;
    spread.hidden = false;
    const panel = spread.querySelector<HTMLElement>(`[data-panel="${b.dataset.open}"]`)!;
    panel.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    panel.querySelector<HTMLElement>('.st-close')!.focus();
  }));
  spread.querySelectorAll('[data-close]').forEach((x) => x.addEventListener('click', close));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !spread.hidden) close(); });

  // The desk's network (shared with the collection page).
  startLineField(document.querySelector<HTMLCanvasElement>('[data-web]')!);
</script>
