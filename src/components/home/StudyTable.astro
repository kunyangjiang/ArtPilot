</style>

<script>
  import { readReading, resolveEntry } from '../../lib/reading.js';
  import { readCollection } from '../../lib/collection.js';
  import { deviceStorage } from '../../lib/storage.js';
  import { startGround } from '../../lib/desk/ground';
  import { drawTurrell } from '../../lib/desk/turrell';
  import { startDeck } from '../../lib/deckSpring';
  import { startScrollFade } from '../../lib/scrollFade';

  const canvas = document.querySelector<HTMLElement>('[data-canvas]')!;
  const st = document.querySelector<HTMLElement>('[data-st]')!;
  const wide = matchMedia('(min-width: 901px)');
  // The table fits the window: the 1440 × 820 canvas scaled by the smaller of the two ratios (a little larger allowed).
  const fit = () => { st.style.setProperty('--s', wide.matches ? String(Math.min(1.25, innerWidth / 1440, (innerHeight - (document.querySelector('.site-nav')?.getBoundingClientRect().height ?? 56)) / 820)) : '1'); };
  fit();
  addEventListener('resize', fit);
  wide.addEventListener('change', fit);

  // The note card follows the print you point at, and returns to today's first when you leave the table.
  const note = document.querySelector<HTMLElement>('[data-note]')!;
  let current: Element | null = (window as any).__stHero ?? document.querySelector('[data-slot] [data-print]');
  const setNote = (p: Element | null) => {
    if (!p || p === current) return;
    current = p;
    note.classList.add('is-swapping');
    setTimeout(() => {
      note.querySelector('[data-note-no]')!.textContent = `No.${p.getAttribute('data-no')}`;
      note.querySelector('[data-note-label]')!.textContent = p.getAttribute('data-label');
      note.querySelector('[data-note-q]')!.textContent = p.getAttribute('data-title');
      note.classList.remove('is-swapping');
    }, 150);
  };
  const hero = () => document.querySelector('[data-slot="0"] [data-print]');
  current = null; setNote(hero());
  canvas.querySelectorAll('[data-slot]').forEach((s) => {
    s.addEventListener('mouseover', (e) => setNote((e.target as Element).closest('[data-print]')));
    s.addEventListener('focusin', (e) => setNote((e.target as Element).closest('[data-print]')));
  });
  document.querySelector('[data-deck]')!.addEventListener('mouseleave', () => { if (wide.matches) setNote(hero()); });
  // Phones: the pile is a sprung carousel (src/lib/deckSpring.ts); the note and the dots follow the print in the middle.
  const dots = [...document.querySelectorAll('[data-dots] i')];
  startDeck(document.querySelector<HTMLElement>('[data-deck]')!, matchMedia('(max-width: 900px)'), (k) => {
    setNote(document.querySelector(`[data-slot="${k}"] [data-print]`));
    dots.forEach((d, i) => d.classList.toggle('is-on', i === k));
  });

  // Everything on the desk dims and settles back as it nears the edge of the window (src/lib/scrollFade.ts).
  startScrollFade('.st-title, .st-slip, .st-print, .st-note, .st-tray, .st-shelves, .st-sto-label, .st-folder, .st-board, .st-case-label');

  // The card box: this browser's cards, lowest numbers first, at most three and then how many more.
  const showCards = () => {
    const cards: { id: string; no: string; title: string; cabinet: string; src: string }[] = JSON.parse(document.querySelector('[data-cards]')!.textContent!);
    const held = readCollection(deviceStorage());
    const mine = cards.filter((c) => held[c.id]);
    const box = document.querySelector<HTMLElement>('[data-tray-cards]')!;
    const pool = document.querySelector<HTMLTemplateElement>('[data-card-pool]')!;
    document.querySelector('[data-tray-count]')!.textContent = mine.length ? `已收藏 ${mine.length} 件 · 陈列在 ${new Set(mine.map((c) => c.cabinet)).size} 个展柜` : '读完一门课程，在课末领取它的藏品卡';
    box.replaceChildren(...[0, 1, 2, 3].map((k) => {
      const el = document.createElement('span');
      const c = mine[k];
      if (k === 3 && mine.length > 4) { el.className = 'st-mini st-mini-more'; el.textContent = `+${mine.length - 3}`; return el; }
      if (!c) { el.className = 'st-mini st-mini-empty'; return el; }
      // A copy of the card itself, scaled to the slot as the collection scales its thumbnails (the cover uses the
      // table's small copy of the image).
      el.className = 'st-mini is-held';
      const card = pool.content.querySelector<HTMLElement>(`[data-card="${c.id}"]`)?.cloneNode(true) as HTMLElement | undefined;
      if (!card) return el;
      card.querySelector('.art-card-locked')?.remove();
      card.removeAttribute('data-card'); card.removeAttribute('aria-label'); card.dataset.collected = 'true';
      card.querySelectorAll('img').forEach((i) => { i.src = c.src; i.alt = ''; i.loading = 'lazy'; });
      el.append(card);
      return el;
    }));
    // Scoped styles reach the new elements through the attribute Astro gives this component's elements.
    const attr = [...box.attributes].find((a) => a.name.startsWith('data-astro-cid'));
    if (attr) box.querySelectorAll('*').forEach((x) => x.setAttribute(attr.name, ''));
  };

  // Continue reading: one slip, only when this browser has an article to resume.
  const showReading = () => {
    const slip = document.querySelector<HTMLAnchorElement>('[data-continue]')!;
    const hit = resolveEntry(readReading(deviceStorage()), JSON.parse(document.querySelector('[data-reading-registry]')!.textContent!));
    slip.hidden = !hit;
    if (!hit) return;
    slip.href = `${hit.href}#resume`;
    slip.querySelector('[data-continue-kind]')!.textContent = `继续阅读 · ${hit.label}`;
    slip.querySelector('[data-continue-title]')!.textContent = hit.title;
    slip.querySelector('[data-continue-p]')!.textContent = `${Math.round(hit.p * 100)}%`;
    slip.querySelector<HTMLElement>('[data-continue-bar]')!.style.width = `${Math.round(hit.p * 100)}%`;
  };
  showCards(); showReading();
  addEventListener('pageshow', (e) => { if (e.persisted) { showCards(); showReading(); } });

  // The story folder: thread and cards come in when the folder is a third into view (at once with reduced motion).
  const folder = document.querySelector<HTMLElement>('[data-folder]');
  if (folder) {
    const fo = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { folder.classList.add('is-in'); fo.disconnect(); } }), { threshold: 0.3 });
    fo.observe(folder);
  }

  // The folder's thread and the board's ties run from one card to the next along the line between their centres, each
  // end tucked a little under its card so the line reads as attached, never as a loose dash in the gap. A piece of
  // evidence is tied by its picture, not its caption. They are measured from the cards at rest: on load, once the cards
  // have arrived, and when the window changes size, not while a card is lifted by the pointer (phones hide them).
  // Each line draws itself just after the second of its two cards has landed (its delay follows the cards' animations).
  const connect = (svg: SVGSVGElement | null, pairs: [Element, Element][], delay: (i: number) => number) => {
    const o = svg?.getBoundingClientRect();
    if (!svg || !o?.width) return;
    svg.setAttribute('viewBox', `0 0 ${o.width} ${o.height}`);
    const paths = svg.querySelectorAll('path');
    pairs.forEach(([a, b], i) => {
      const ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
      const ax = ra.left + ra.width / 2 - o.left, ay = ra.top + ra.height / 2 - o.top;
      const dx = rb.left + rb.width / 2 - o.left - ax, dy = rb.top + rb.height / 2 - o.top - ay, len = Math.hypot(dx, dy);
      // Where the centre line leaves a box, as a fraction of the way from one centre to the other.
      const out = (r: DOMRect) => Math.min(dx ? r.width / 2 / Math.abs(dx) : Infinity, dy ? r.height / 2 / Math.abs(dy) : Infinity);
      const tuck = len ? 8 / len : 0, t0 = out(ra) - tuck, t1 = 1 - out(rb) + tuck;
      // A line with less than 14px showing between the cards would read as a speck; cards that close need none.
      const p = paths[i];
      if (!p) return;
      p.setAttribute('d', (t1 - t0) * len - 16 > 14 ? `M${ax + dx * t0} ${ay + dy * t0} L${ax + dx * t1} ${ay + dy * t1}` : '');
      p.style.transition = `stroke-dashoffset 520ms cubic-bezier(.4, 0, .2, 1) ${delay(i)}ms`;
    });
  };
  const tie = () => {
    const cards = [...document.querySelectorAll('.st-life li')];
    // Card k is pinned at 300 + k × 300 ms and takes 560 ms; the line to it follows as it lands.
    connect(document.querySelector('.st-thread'), cards.slice(1).map((c, i) => [cards[i], c]), (i) => 300 + (i + 1) * 300 + 420);
    const question = document.querySelector('.st-question');
    // Evidence k settles at 200 + k × 220 ms and takes 600 ms.
    if (question) connect(document.querySelector('.st-ties'), [...document.querySelectorAll('.st-evidence')].map((e) => [e.querySelector('img') ?? e, question]), (i) => 200 + i * 220 + 460);
  };
  tie();
  addEventListener('resize', tie);
  addEventListener('load', tie);
  document.querySelectorAll('.st-life-area, .st-board-area').forEach((a) => a.addEventListener('animationend', tie));

  // The case board: comes in when a third in view.
  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
    const ro = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('is-in'); ro.disconnect(); } }), { threshold: 0.3 });
    ro.observe(el);
  });

  // On the homepage the site bar points at the desk itself rather than off the page: 课程 is the table already in view,
  // so it does nothing here; 藏品图鉴 brings the card box into view (and lights it briefly); 艺术家故事馆 and 案例库 lead
  // down to their folder and board, which then lead into the halls. On every other page, and without scripts, the
  // links go to their pages as usual.
  const sections: Record<string, { id: string; block: ScrollLogicalPosition }> = {
    '/collection/': { id: 'st-collection', block: 'center' },
    '/stories/': { id: 'st-stories', block: 'start' },
    '/cases/': { id: 'st-cases', block: 'start' },
  };
  document.querySelectorAll<HTMLAnchorElement>('.site-nav .nav-halls a').forEach((a) => {
    const href = a.getAttribute('href') ?? '';
    if (href === '/courses/') { a.addEventListener('click', (e) => e.preventDefault()); return; }
    const to = sections[href];
    if (!to) return;
    a.addEventListener('click', (e) => {
      const target = document.getElementById(to.id);
      if (!target) return;
      e.preventDefault();
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: to.block });
      history.replaceState(history.state, '', `#${to.id}`);
      if (to.id === 'st-collection') {
        target.classList.remove('is-called'); void target.offsetWidth; target.classList.add('is-called');
        target.focus({ preventScroll: true });
      } else target.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
    });
  });

  // A stack opens into its spread; Escape, the backdrop or "收起" put it back and return focus to the stack.
  const spread = document.querySelector<HTMLElement>('[data-spread]')!;
  let opener: HTMLElement | null = null;
  const close = () => {
    spread.hidden = true;
    spread.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = true; });
    document.documentElement.style.overflow = '';
    opener?.focus();
  };
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
    opener = b;
    spread.hidden = false;
    const panel = spread.querySelector<HTMLElement>(`[data-panel="${b.dataset.open}"]`)!;
    panel.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    panel.querySelector<HTMLElement>('.st-close')!.focus();
  }));
  spread.querySelectorAll('[data-close]').forEach((x) => x.addEventListener('click', close));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !spread.hidden) close(); });

  // The desk's ground: Scarpa's room with Proun's bodies in it and Turrell's opening (src/lib/desk/).
  startGround(document.querySelector<HTMLCanvasElement>('[data-web]')!, drawTurrell);
</script>
