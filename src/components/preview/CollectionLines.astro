---
// PREVIEW ONLY (/preview/collection-lines/): the deployed collection page (src/pages/collection.astro), unchanged, with the
// study table's line network behind it. Same site bar, same cabinets, same footer; only the background is new.
import SiteBar from '../SiteBar.astro';
import CollectionCabinets from '../CollectionCabinets.astro';
---
<div class="cl">
  <canvas class="cl-web" data-web aria-hidden="true"></canvas>
  <SiteBar tone="gallery" back={{ href: '/preview/home-study-table/', label: '首页' }} hall="collection" here />
  <section class="archive cl-archive">
    <CollectionCabinets />
    <footer class="archive-foot">
      <p>收集记录只保存在这台设备的浏览器中，不上传、不同步。</p>
      <button type="button" class="btn btn-secondary archive-clear" data-archive-clear>清除本机收集记录</button>
    </footer>
  </section>
</div>

<style>
  :global(html:has(.cl)), :global(body:has(.cl)) { background: var(--gallery); }
  .cl { position: relative; isolation: isolate; min-height: 100vh; }
  .cl-web { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
  /* The archive keeps its layout; its solid ground gives way to the lines. */
  .cl-archive, .cl-archive :global(.cc) { background: transparent; }
  .cl :global(.site-nav) { background: rgb(23 23 22 / .9); }
</style>

<script>
  import { clearCollection, deviceStorage } from '../../lib/collection.js';
  import { startLineField } from '../../lib/lineField';

  // The lines spread out from behind the page title.
  startLineField(document.querySelector<HTMLCanvasElement>('[data-web]')!, [0.3, 0.2]);
  document.querySelector('[data-archive-clear]')!.addEventListener('click', () => {
    if (!confirm('清除这台设备上的全部收集记录？此操作无法撤销。')) return;
    clearCollection(deviceStorage());
    dispatchEvent(new Event('artpilot:collected'));
  });
</script>
