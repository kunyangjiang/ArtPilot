<style>
  /* The course room: the day's hang, then the whole syllabus as one wall text. */
  .sw-courses { grid-template-columns: auto auto; }
  .sw-courses .sw-label { grid-column: 1; }
  .sw-map { grid-row: 1; align-self: center; width: clamp(17rem, 21vw, 19.5rem); margin-bottom: var(--floor-h); padding: 1.1rem 0 .6rem; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .sw-map ol { margin: .7rem 0 0; padding: 0; list-style: none; }
  .sw-map a { display: grid; grid-template-columns: 1.7rem 1fr auto; column-gap: .3rem; row-gap: .3rem; padding: .5rem 0; color: inherit; text-decoration: none; }
  .sw-map li + li a { border-top: 1px solid var(--rule); }
