---
// PREVIEW ONLY (/preview/home-salon-wall/): a new homepage design, a salon hang. One long wall, painted a deep colour,
// that the visitor walks along: on a desktop the page's vertical scroll moves the wall sideways; on a phone the same
// hang runs down the screen. The art leads and the type stays small: wall labels on a floor line, a slim index.
// Same content as the real homepage: the course works (today's two, chosen by src/lib/featured.js as in production,
// hung largest at eye level), the course entrance, one Continue Reading entry, the five halls (only open ones are links),
// this browser's cards, the credits. It reads production data read-only; its scripts only read this browser's records.
// Production is not touched.
import '../../styles/fonts.css';
import { getCollection, getEntry } from 'astro:content';
import { destinations, SOON, homeImages } from '../../data/home';
import featuredSource from '../../lib/featured.js?raw';
import { fitsWall, assignSlots } from '../../lib/featured.js';
import { imageCredit } from '../../lib/credits.js';
import { inCourseOrder, cardNumber, TOTAL_COURSES } from '../../lib/publication.js';
import { stages, courseTitles } from '../../data/curriculum';

const all = inCourseOrder(await Promise.all((await getCollection('lessons')).map(async (l) => {
  const base = { id: l.id, title: l.data.title, course: l.data.course, workLabel: l.data.workLabel, artwork: l.data.artwork.id };
  if (!l.data.featured) return base;
  const art = (await getEntry('artworks', l.data.artwork.id))!.data;
  const img = art.images.find((i) => i.key === l.data.featured!.image)!;
  if (!img.width || !img.height || !fitsWall(img.width, img.height)) return base;
  return { ...base, image: { src: img.src, alt: img.alt, width: img.width, height: img.height, credit: imageCredit(img, art) } };
})));
const stageOf = (n: number) => stages.find((st) => n >= st.first && n <= st.last)!.no;
const pool = all.flatMap((l: any, order: number) => (l.image ? [{ ...l, order, stage: stageOf(l.course), aspect: l.image.width / l.image.height }] : []));
// Default (no JavaScript) hang: the first pair as production shows it, then the rest in course order.
const first = assignSlots(pool.slice(0, 2));
const hang = [first.anchor, first.second, ...pool.filter((c) => c !== first.anchor && c !== first.second)].filter(Boolean) as typeof pool;
// Slots on the course wall, left to right: column of two small, the large anchor, the second over a small one, two
// columns of smaller works. Sizes are fractions of the wall's height.
const slots = [
  { col: 1, size: 'S' }, { col: 1, size: 'S' },
  { col: 2, size: 'A' },
  { col: 3, size: 'B' }, { col: 3, size: 'S' },
  { col: 4, size: 'M' },
  { col: 5, size: 'S' }, { col: 5, size: 'S' },
];
const slotNames = ['s1', 's2', 'a', 'b', 's3', 'm1', 's4', 's5'];
// The anchor and second go to slots a and b; the rest fill the others in order.
const order = ['a', 'b', 's1', 's2', 's3', 'm1', 's4', 's5'];
const placed = Object.fromEntries(order.map((slot, k) => [slot, hang[k]]));
// Every other work with a wall image waits in a <template> (its image is not loaded) for the day it is chosen.
const reserve = hang.slice(order.length);
// The whole syllabus, as a map: one tick per course, filled where the course is open.
const openCourses = new Map(all.map((l: any) => [l.course, l]));
const map = stages.map((st) => {
  const courses = Array.from({ length: st.last - st.first + 1 }, (_, k) => st.first + k)
    .map((n) => ({ n, open: openCourses.has(n), title: (openCourses.get(n) as any)?.title ?? courseTitles[n] }));
  return { ...st, courses, open: courses.filter((c) => c.open).length };
});
// The cabinet shows at most this many plates; past that, the rest are counted.
const CABINET = 24;
const courseOf = new Map(all.map((l: any) => [l.artwork, l.course]));
const cards = (await getCollection('artworks')).filter((a) => a.data.card && courseOf.has(a.id))
  .map((a) => ({ id: a.id, no: cardNumber(courseOf.get(a.id)!), title: a.data.titleZh, src: (a.data.images.find((i: any) => i.key === 'full') ?? a.data.images[0]).src }))
  .sort((a, b) => a.no.localeCompare(b.no));
const d = Object.fromEntries(destinations.map((x) => [x.id, x]));
const registry = {
  lesson: { label: '课程', items: Object.fromEntries(all.map((l) => [l.id, { title: l.title, href: `/lessons/${l.id}/` }])) },
  'artist-story': { label: d.stories.label, items: {} },
  case: { label: d.cases.label, items: {} },
};
const { wave, nataraja } = homeImages;
const soon = (x: (typeof destinations)[number]) => (x.href ? {} : { tabindex: 0, role: 'link', 'aria-disabled': 'true' });
// Today's two, from the same function as production; the rest keep their course order. Moves the works into their slots
// before first paint (the script sits right after the course wall).
const chooseScript = `(function(){${featuredSource.replace(/^\/\/.*\r?\n/gm, '').replace(/^export /gm, '')}
function run(){var wall=document.querySelector('[data-course-wall]');if(!wall)return;
var store=document.querySelector('[data-reserve]');var works=[].slice.call(wall.querySelectorAll('[data-work]')).concat(store?[].slice.call(store.content.querySelectorAll('[data-work]')):[]);var pool=works.map(function(e){return{id:e.getAttribute('data-work'),aspect:+e.getAttribute('data-aspect'),order:+e.getAttribute('data-order'),stage:e.getAttribute('data-stage'),el:e}}).sort(function(a,b){return a.order-b.order});
var day=dayNumber(),n=${order.length};var pick=pickFeatured(pool,day);var hang=[pick.anchor,pick.second].filter(Boolean);
var by={};pool.forEach(function(p){if(hang.indexOf(p)<0)(by[p.stage]=by[p.stage]||[]).push(p)});var keys=Object.keys(by).sort();
keys.forEach(function(k){var c=by[k],i=day%c.length;by[k]=c.slice(i).concat(c.slice(0,i))});var o=keys.length?day%keys.length:0;
for(var r=0;hang.length<n&&r<pool.length;r++)for(var j=0;j<keys.length&&hang.length<n;j++){var c=by[keys[(j+o)%keys.length]];if(c[r])hang.push(c[r])}
pool.forEach(function(p){if(hang.indexOf(p)<0&&store)store.content.appendChild(p.el)});
var order=${JSON.stringify(order)};order.forEach(function(slot,k){var s=wall.querySelector('[data-slot="'+slot+'"]');var w=hang[k];if(s&&w){s.appendChild(w.el);w.el.classList.toggle('is-today',k<2);var i=w.el.querySelector('img');if(k<2&&i)i.loading='eager'}});
[].slice.call(document.querySelectorAll('[data-credit-for]')).forEach(function(p){var id=p.getAttribute('data-credit-for');p.hidden=!(hang[0]&&hang[0].id===id||hang[1]&&hang[1].id===id)})}
window.__swPick=run;run();addEventListener('pageshow',function(e){if(e.persisted)run()})})();`;
---
<div class="sw">
  <!-- PREVIEW: the paint to compare, from ?wall=… (also colours the page behind the wall). -->
  <script is:inline set:html={`(function(){var p={'oxblood':'#4a2220','midnight':'#1c2334','graphite':'#2c2825','pompeian':'#7b3c28','stone':'#d8d1c4','white':'#eeece7','charcoal':'#1f2021','slate':'#2e3439','taupe':'#857a70','concrete':'#bdbcb7','fog':'#d5dade','sage':'#d2d6cd','clay':'#e2d3c8','oat':'#e9e2d6','duo':'#eeece7','alt':'#eeece7','house':'#171716','auto':(matchMedia('(prefers-color-scheme: dark)').matches?'#1f2021':'#eeece7')};var w=new URLSearchParams(location.search).get('wall');if(!p[w])w='house';document.currentScript.parentElement.setAttribute('data-wall',w);document.documentElement.style.background=p[w]})();`}></script>
  <header class="sw-bar">
    <span class="sw-mark">ArtPilot</span>
    <nav class="sw-index" aria-label="五个展区">
      {destinations.map((x) => <a href={`#sw-${x.id}`} data-index={x.id}><span lang="en">{x.no}</span><span class="sw-index-name">{x.id === 'cases' ? x.sub : x.id === 'collection' ? x.sub : x.label}</span></a>)}
    </nav>
  </header>

  <!-- The wall. Without JavaScript it is a strip that scrolls sideways; the script turns the page's vertical scroll into a
       walk along it (desktop only). -->
  <section class="sw-hall" data-hall>
    <div class="sw-view" data-view>
      <div class="sw-track" data-track>

        <!-- Entrance: a small wall text, not a headline. -->
        <div class="sw-text sw-intro">
          <p class="sw-kicker">全球艺术史 · 数字美术馆</p>
          <h1>从一件作品开始，<br />走进全球艺术史。</h1>
          <p class="sw-lede">一座数字美术馆，五个展区。沿着这面墙走下去。</p>
          <a class="sw-enter" href={d.courses.href}><span class="sw-enter-main">进入课程</span><span class="sw-enter-arrow" aria-hidden="true"></span><span class="sw-enter-meta">查看已开放的 {all.length} 门</span></a>
          <p class="sw-continue" data-continue>
            <span data-continue-kind>继续阅读</span>
            <a data-continue-link href="/courses/"></a>
            <span class="sw-bar-p"><span class="sw-meter" aria-hidden="true"><span data-continue-bar></span></span><span data-continue-p></span></span>
          </p>
          <p class="sw-hint" aria-hidden="true">向下滚动，沿墙前行 →</p>
        </div>

        <!-- 01 Courses: the open courses' works, hung salon-style; today's two largest, at eye level. -->
        <section class="sw-sec sw-courses" id="sw-courses" data-sec="courses" aria-labelledby="sw-h-courses">
          <div class="sw-hang" data-course-wall>
            {[1, 2, 3, 4, 5].map((col) => (
              <div class="sw-col">
                {slots.map((s, k) => s.col === col && (
                  <div class={`sw-slot sw-${s.size}`} data-slot={slotNames[k]}>
                    {placed[slotNames[k]] && (() => { const c = placed[slotNames[k]]; return (
                      <a class:list={['sw-work', { 'is-today': slotNames[k] === 'a' || slotNames[k] === 'b' }]} href={`/lessons/${c.id}/`} data-work={c.id} data-aspect={c.aspect.toFixed(4)} data-order={c.order} data-stage={c.stage}>
                        <img src={c.image.src} alt={c.image.alt} width={c.image.width} height={c.image.height} style={`aspect-ratio:${c.image.width}/${c.image.height}`} loading={slotNames[k] === 'a' || slotNames[k] === 'b' ? 'eager' : 'lazy'} />
                        <span class="sw-cap"><span lang="en">No.{cardNumber(c.course)}</span>{c.workLabel}<em>{c.title}</em></span>
                      </a>
                    ); })()}
                  </div>
                ))}
              </div>
            ))}
          </div>
          <template data-reserve>
            {reserve.map((c) => (
              <a class="sw-work" href={`/lessons/${c.id}/`} data-work={c.id} data-aspect={c.aspect.toFixed(4)} data-order={c.order} data-stage={c.stage}>
                <img src={c.image.src} alt={c.image.alt} width={c.image.width} height={c.image.height} style={`aspect-ratio:${c.image.width}/${c.image.height}`} loading="lazy" />
                <span class="sw-cap"><span lang="en">No.{cardNumber(c.course)}</span>{c.workLabel}<em>{c.title}</em></span>
              </a>
            ))}
          </template>
          <script is:inline set:html={chooseScript}></script>
          <!-- The whole syllabus as one wall text: seven stages, a tick for every course, filled where it is open. -->
          <nav class="sw-map" aria-label="课程全貌">
            <p class="sw-kicker">课程全貌 · {TOTAL_COURSES} 门 · 七个阶段</p>
            <ol>
              {map.map((st) => (
                <li>
                  <a href={d.courses.href}>
                    <span class="sw-map-no" lang="en">{st.no}</span>
                    <span class="sw-map-title">{st.title}</span>
                    <span class="sw-map-count">{st.open} / {st.courses.length}</span>
                    <span class="sw-ticks" aria-hidden="true">{st.courses.map((c) => <i class:list={{ 'is-open': c.open }}></i>)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
          <div class="sw-label">
            <p class="sw-no" lang="en">{d.courses.no}</p>
            <h2 id="sw-h-courses"><a href={d.courses.href}>{d.courses.label}</a></h2>
            <p class="sw-sub" lang="en">{d.courses.sub}</p>
            <p class="sw-premise">{d.courses.premise}</p>
            <a class="sw-go" href={d.courses.href}>已开放 {all.length} / {TOTAL_COURSES} 门 <span aria-hidden="true">→</span></a>
          </div>
        </section>

        <!-- 02 Artist stories -->
        <section class="sw-sec sw-stories" id="sw-stories" data-sec="stories" aria-labelledby="sw-h-stories">
          <figure class="sw-hung sw-wave"><img src={wave.img.src} width={wave.img.width} height={wave.img.height} alt={wave.alt} loading="lazy" /></figure>
          <div class="sw-label" {...soon(d.stories)}>
            <p class="sw-no" lang="en">{d.stories.no}</p>
            <h2 id="sw-h-stories">{d.stories.label}</h2>
            <p class="sw-sub" lang="en">{d.stories.sub}</p>
            <p class="sw-premise">{d.stories.premise}</p>
            <p class="sw-state">{SOON}</p>
          </div>
        </section>

        <!-- 03 Cases: no picture, a wall text -->
        <section class="sw-sec sw-cases" id="sw-cases" data-sec="cases" aria-labelledby="sw-h-cases">
          <div class="sw-text sw-panel" {...soon(d.cases)}>
            <p class="sw-no" lang="en">{d.cases.no}</p>
            <h2 id="sw-h-cases" lang="en">{d.cases.label}</h2>
            <p class="sw-sub">{d.cases.sub}</p>
            <p class="sw-quote">{d.cases.premise}</p>
            <p class="sw-state">{SOON}</p>
          </div>
        </section>

        <!-- 04 The world at the same time -->
        <section class="sw-sec sw-atlas" id="sw-atlas" data-sec="atlas" aria-labelledby="sw-h-atlas">
          <div class="sw-pair">
            <figure class="sw-hung sw-bronze"><img src={nataraja.img.src} width={nataraja.img.width} height={nataraja.img.height} alt={nataraja.alt} loading="lazy" /></figure>
            <figure class="sw-hung sw-glass"><img src="/img/chartres-samaritan.jpg" alt="沙特尔主教座堂“好撒马利亚人”窗中的一格：撒马利亚人照料受伤的路人。" loading="lazy" /></figure>
          </div>
          <div class="sw-label" {...soon(d.atlas)}>
            <p class="sw-no" lang="en">{d.atlas.no}</p>
            <h2 id="sw-h-atlas">{d.atlas.label}</h2>
            <p class="sw-sub" lang="en">{d.atlas.sub}</p>
            <p class="sw-premise">{d.atlas.premise}比如约 1200 年前后：泰米尔纳德的青铜舞王像，与沙特尔的彩色玻璃。</p>
            <p class="sw-state">{SOON}</p>
          </div>
        </section>

        <!-- 05 Collection: a vitrine -->
        <section class="sw-sec sw-collection" id="sw-collection" data-sec="collection" aria-labelledby="sw-h-collection">
          <!-- The cabinet: a plate for every card a course can award; a plate shows its work once this browser claims it. -->
          <a class="sw-cabinet" href={d.collection.href} aria-label="打开藏品图鉴" data-cabinet>
            {cards.slice(0, CABINET).map((c) => (
              <span class="sw-plate" data-plate={c.id} data-src={c.src}>
                <span class="sw-plate-no" lang="en">No.{c.no}</span>
                <span class="sw-plate-t">{c.title}</span>
              </span>
            ))}
            {cards.length > CABINET && <span class="sw-plate sw-plate-more" lang="en">+{cards.length - CABINET}</span>}
          </a>
          <a class="sw-vitrine" href={d.collection.href}>
            <p class="sw-no" lang="en">{d.collection.no}</p>
            <h2 id="sw-h-collection" lang="en">{d.collection.label}</h2>
            <p class="sw-sub">{d.collection.sub}</p>
            <p class="sw-premise">{d.collection.premise}</p>
            <p class="sw-held"><b data-held>0</b> / {cards.length} 张已收藏</p>
            <ol class="sw-cards" data-vitrine hidden>
              {cards.map((c) => <li data-card-row={c.id} hidden><span lang="en">No.{c.no}</span>{c.title}</li>)}
              <li data-card-total hidden>共 <b data-card-count></b> 张已收集</li>
            </ol>
            <span class="sw-go">进入藏品图鉴 <span aria-hidden="true">→</span></span>
          </a>
        </section>

        <!-- The end of the wall: the credits, as a wall label. -->
        <footer class="sw-text sw-credits">
          <p class="sw-kicker">图片与版权</p>
          <p>{wave.caption} {wave.credit}，<a href={wave.source}>来源</a>。</p>
          <p>{nataraja.caption} {nataraja.credit}，<a href={nataraja.source}>来源</a>。</p>
          {pool.map((c) => <p data-credit-for={c.id} hidden={c !== first.anchor && c !== first.second}>{c.workLabel}。图片：{c.image.credit.by}，{c.image.credit.licenceUrl ? <a href={c.image.credit.licenceUrl}>{c.image.credit.licence}</a> : c.image.credit.licence}，<a href={c.image.credit.href}>来源</a>。</p>)}
          <p>墙上其余课程作品与今日两件的完整来源，见各课程页的“来源与版权”。</p>
        </footer>
      </div>
    </div>
  </section>
  <script type="application/json" data-reading-registry set:html={JSON.stringify(registry).replace(/</g, '\\u003c')}></script>
</div>

<style>
  .sw {
    --serif: "ArtPilot Serif SC", "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
    --sans: "ArtPilot Sans SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
    --latin: "ArtPilot Bodoni", "Bodoni Moda", Didot, serif;
    /* A salon wall: the paint, a little lighter where the light falls, a darker floor. PREVIEW: several paints to
       compare, chosen with ?wall=… in the address (oxblood by default). */
    --wall: #4a2220; --wall-lit: #5d2c28; --floor: #2b1312; --bar: 43 19 18;
    --ink: #f3ebe1; --ink-2: #d2bdad; --rule: rgb(255 255 255 / .18);
    --bar-h: 3.25rem; --floor-h: clamp(6.25rem, 16vh, 9rem);
    color: var(--ink); background: var(--wall);
  }
  .sw[data-wall="midnight"] { --wall: #1c2334; --wall-lit: #27314a; --floor: #11151f; --bar: 17 21 31; --ink: #eeece6; --ink-2: #b3b8c4; --rule: rgb(255 255 255 / .16); }
  .sw[data-wall="graphite"] { --wall: #2c2825; --wall-lit: #3a3430; --floor: #181513; --bar: 24 21 19; --ink: #f0eae2; --ink-2: #bab1a6; --rule: rgb(255 255 255 / .16); }
  .sw[data-wall="pompeian"] { --wall: #7b3c28; --wall-lit: #8e4831; --floor: #4a2216; --bar: 74 34 22; --ink: #f8f0e7; --ink-2: #e6cdbb; --rule: rgb(255 255 255 / .22); }
  .sw[data-wall="stone"] { --wall: #d8d1c4; --wall-lit: #e5e0d6; --floor: #c1b8a8; --bar: 216 209 196; --ink: #1f1c18; --ink-2: #5c564d; --rule: rgb(0 0 0 / .2); }
  .sw[data-wall="white"] { --wall: #eeece7; --wall-lit: #f7f6f3; --floor: #dcd8cf; --bar: 238 236 231; --ink: #1b1b1a; --ink-2: #5b5a56; --rule: rgb(0 0 0 / .16); }
  .sw[data-wall="charcoal"] { --wall: #1f2021; --wall-lit: #2a2b2d; --floor: #141515; --bar: 20 21 21; --ink: #efefec; --ink-2: #b2b2ad; --rule: rgb(255 255 255 / .15); }
  .sw[data-wall="slate"] { --wall: #2e3439; --wall-lit: #3a4248; --floor: #1d2226; --bar: 29 34 38; --ink: #eef0f1; --ink-2: #b3bac0; --rule: rgb(255 255 255 / .16); }
  .sw[data-wall="taupe"] { --wall: #857a70; --wall-lit: #93887d; --floor: #665d55; --bar: 102 93 85; --ink: #faf6f1; --ink-2: #ebe2d8; --rule: rgb(255 255 255 / .28); }
  .sw[data-wall="concrete"] { --wall: #bdbcb7; --wall-lit: #cac9c4; --floor: #a5a49f; --bar: 189 188 183; --ink: #1c1c1b; --ink-2: #4c4b48; --rule: rgb(0 0 0 / .2); }
  .sw[data-wall="fog"] { --wall: #d5dade; --wall-lit: #e1e5e8; --floor: #bcc2c7; --bar: 213 218 222; --ink: #1b1f23; --ink-2: #4f565d; --rule: rgb(0 0 0 / .17); }
  .sw[data-wall="sage"] { --wall: #d2d6cd; --wall-lit: #dee1d9; --floor: #b9beb3; --bar: 210 214 205; --ink: #1c1f1b; --ink-2: #50554d; --rule: rgb(0 0 0 / .17); }
  .sw[data-wall="clay"] { --wall: #e2d3c8; --wall-lit: #ebdfd6; --floor: #cdbcae; --bar: 226 211 200; --ink: #24201d; --ink-2: #5e534b; --rule: rgb(0 0 0 / .17); }
  .sw[data-wall="oat"] { --wall: #e9e2d6; --wall-lit: #f1ece3; --floor: #d4cbbd; --bar: 233 226 214; --ink: #1f1c18; --ink-2: #5a544b; --rule: rgb(0 0 0 / .16); }
  /* Light paints: a lighter shadow under the works, and a paler vitrine. */
  .sw[data-wall="stone"], .sw[data-wall="white"], .sw[data-wall="concrete"], .sw[data-wall="fog"], .sw[data-wall="sage"], .sw[data-wall="clay"], .sw[data-wall="oat"] { --shadow: rgb(60 50 40 / .28); --case: rgb(255 255 255 / .35); }
  .sw a { color: inherit; }
  .sw :focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .sw [hidden] { display: none !important; }
  .sw img { display: block; }

  /* The slim bar: the name, and an index of the five halls that also shows where you are. */
  .sw-bar { position: fixed; inset: 0 0 auto; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    height: var(--bar-h); padding: 0 clamp(1rem, 3vw, 2.5rem); background: linear-gradient(to bottom, rgb(var(--bar) / .85), transparent); }
  .sw-mark { font: 400 .9375rem/1 var(--latin); letter-spacing: .32em; text-transform: uppercase; }
  .sw-index { display: flex; gap: clamp(.75rem, 2vw, 1.75rem); font: 400 .75rem/1 var(--sans); letter-spacing: .08em; }
  .sw-index a { display: inline-flex; align-items: baseline; gap: .4rem; min-height: 2.75rem; align-items: center; color: var(--ink-2); text-decoration: none; }
  .sw-index a span:first-child { font: italic 400 .875rem/1 var(--latin); }
  .sw-index a.is-here { color: var(--ink); }
  .sw-index a.is-here span:first-child { text-decoration: underline 1px; text-underline-offset: .35em; }

  /* ---------- Desktop: the wall ---------- */
  .sw-hall { position: relative; }
  .sw-view { height: 100svh; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
    background:
      radial-gradient(90% 60% at 50% 38%, var(--wall-lit), transparent 70%),
      linear-gradient(to bottom, transparent calc(100% - var(--floor-h)), var(--floor) calc(100% - var(--floor-h)));
    background-attachment: local, scroll; }
  :global(.sw-hall.is-walk) .sw-view { position: sticky; top: 0; overflow: hidden; }
  .sw-track { --h: calc(100svh - var(--bar-h) - var(--floor-h) - 2.5rem);
    display: flex; align-items: stretch; gap: clamp(5rem, 9vw, 9rem); width: max-content; height: 100%;
    padding: calc(var(--bar-h) + 1.5rem) clamp(2rem, 6vw, 6rem) 0; will-change: transform;
    /* The floor line runs the length of the wall. */
    background: linear-gradient(var(--rule), var(--rule)) 0 calc(100% - var(--floor-h)) / 100% 1px no-repeat; }
  .sw-sec { display: grid; grid-template-rows: var(--h) var(--floor-h); column-gap: 3rem; align-items: center; }
  /* Wall labels sit on the floor line, small. */
  .sw-label { grid-row: 2; align-self: start; max-width: 22rem; padding-top: .85rem; font: 400 .75rem/1.7 var(--sans); color: var(--ink-2); }
  .sw-no { margin: 0; font: italic 400 .9375rem/1 var(--latin); color: var(--ink-2); }
  .sw-label h2, .sw-panel h2, .sw-vitrine h2 { margin: .25rem 0 0; font: 500 1rem/1.4 var(--serif); letter-spacing: .06em; color: var(--ink); }
  .sw h2 a { text-decoration: none; }
  .sw h2 span { margin-left: .6rem; font: italic 400 .8125rem/1 var(--latin); color: var(--ink-2); }
  .sw-premise { margin: .3rem 0 0; }
  .sw-state { display: inline-block; margin: .45rem 0 0; padding: .1rem .55rem; border: 1px dashed var(--rule); border-radius: 999px; font-size: .6875rem; letter-spacing: .12em; }
  .sw-go { display: inline-flex; align-items: center; min-height: 2.5rem; color: var(--ink); text-decoration: none; letter-spacing: .06em; border-bottom: 1px solid var(--ink-2); line-height: 1; }
  .sw-go:hover span, .sw-go:focus-visible span { transform: translateX(3px); display: inline-block; }
  .sw-today { margin: .6rem 0 0; font-size: .6875rem; letter-spacing: .08em; }
  [aria-disabled="true"] { cursor: default; }

  /* Entrance and end: small wall texts, vertically centred on the wall. */
  .sw-text { align-self: center; width: clamp(16rem, 24vw, 22rem); font: 400 .8125rem/1.8 var(--sans); color: var(--ink-2); }
  .sw-intro { align-self: center; margin-bottom: var(--floor-h); }
  .sw-kicker { margin: 0; font: 500 .6875rem/1.6 var(--sans); letter-spacing: .22em; }
  .sw-intro h1 { margin: .9rem 0 0; font: 500 clamp(1.375rem, 1.8vw, 1.75rem)/1.45 var(--serif); letter-spacing: .04em; color: var(--ink); }
  .sw-lede { margin: .9rem 0 0; }
  .sw-enter { display: inline-flex; align-items: center; min-height: 2.75rem; margin-top: 1.1rem; font: 500 1rem/1 var(--serif); letter-spacing: .1em; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink-2); }
  .sw-continue { display: none; margin: 1.4rem 0 0; padding-top: .8rem; border-top: 1px solid var(--rule); font-size: .6875rem; letter-spacing: .14em; }
  :global(.sw-continue.is-on) { display: grid; gap: .2rem; }
  .sw-continue a { display: block; min-height: 2.25rem; padding-top: .25rem; font: 400 .9375rem/1.5 var(--serif); letter-spacing: .02em; color: var(--ink); text-decoration: none; }
  .sw-continue a::after { content: " →"; font-family: var(--sans); }
  .sw-bar-p { display: flex; align-items: center; gap: .6rem; font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .sw-meter { flex: 1; height: 2px; background: var(--rule); }
  .sw-meter > span { display: block; height: 100%; width: 0; background: var(--ink-2); }
  .sw-hint { margin: 2rem 0 0; font-size: .6875rem; letter-spacing: .18em; }

  /* The course wall: five columns, salon-hung, centred on the eye line. Sizes are fractions of the wall's height. */
  .sw-hang { grid-row: 1; display: flex; align-items: center; gap: clamp(1.25rem, 2vw, 2rem); height: 100%; }
  .sw-col { display: flex; flex-direction: column; justify-content: center; gap: clamp(1rem, 2vh, 1.5rem); height: 100%; }
  /* Room under each work for its caption (two lines for today's pair), so a work hung below never covers it. */
  .sw-slot { display: flex; justify-content: center; padding-bottom: 1.6rem; }
  .sw-slot:has(.is-today) { padding-bottom: 2.75rem; }
  .sw-slot:empty { display: none; }
  .sw-A img { height: calc(var(--h) * .8); }
  .sw-B img { height: calc(var(--h) * .46); }
  .sw-M img { height: calc(var(--h) * .6); }
  .sw-S img { height: calc(var(--h) * .33); }
  .sw-work { position: relative; display: block; text-decoration: none; }
  .sw-work img { width: auto; max-width: none; box-shadow: 0 1px 2px rgb(0 0 0 / .3), 0 18px 40px -18px var(--shadow, rgb(0 0 0 / .7)); transition: transform var(--t) var(--ease); }
  .sw-work:hover img, .sw-work:focus-visible img { transform: translateY(-3px); }
  /* Captions: small, below each work; the two of today a touch brighter. */
  .sw-cap { position: absolute; left: 0; right: 0; top: 100%; padding-top: .4rem; font: 400 .6875rem/1.45 var(--sans); letter-spacing: .03em; color: var(--ink-2);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sw-cap span { margin-right: .45rem; font: italic 400 .75rem/1 var(--latin); }
  .sw-cap em { display: none; font-style: normal; }
  .sw-work.is-today .sw-cap { color: var(--ink); }
  .sw-work:hover .sw-cap em, .sw-work:focus-visible .sw-cap em, .sw-work.is-today .sw-cap em { display: block; font-style: normal; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; }

  .sw-stories, .sw-atlas { grid-template-columns: auto auto; }
  .sw-wave { grid-row: 1; margin: 0; }
  .sw-wave img { height: calc(var(--h) * .62); width: auto; box-shadow: 0 18px 40px -18px var(--shadow, rgb(0 0 0 / .7)); }
  .sw-stories .sw-label, .sw-atlas .sw-label { grid-column: 1 / -1; }
  .sw-pair { grid-row: 1; display: flex; align-items: center; gap: 2.5rem; }
  .sw-hung { margin: 0; }
  .sw-bronze img { height: calc(var(--h) * .7); width: auto; }
  .sw-glass img { height: calc(var(--h) * .34); width: auto; }
  .sw-cases { grid-template-rows: var(--h) var(--floor-h); }
  .sw-panel { grid-row: 1; width: clamp(16rem, 22vw, 20rem); padding: 1.5rem 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .sw-quote { margin: .9rem 0 0; font: 400 1.125rem/1.75 var(--serif); color: var(--ink); }
  .sw-collection { grid-template-rows: var(--h) var(--floor-h); }
  .sw-vitrine { grid-row: 1; display: block; width: clamp(16rem, 22vw, 20rem); padding: 1.5rem; border: 1px solid var(--rule); background: var(--case, rgb(0 0 0 / .14));
    font: 400 .8125rem/1.75 var(--sans); color: var(--ink-2); text-decoration: none; }
  .sw-vitrine:hover { border-color: var(--ink-2); }
  .sw-cards { margin: .9rem 0 0; padding: 0; list-style: none; font: 400 .875rem/1.7 var(--serif); color: var(--ink); }
  .sw-cards span { margin-right: .5rem; font: italic 400 .75rem/1 var(--latin); color: var(--ink-2); }
  .sw-vitrine .sw-go { margin-top: 1rem; }
  .sw-credits { align-self: end; margin-bottom: calc(var(--floor-h) + 1rem); font-size: .6875rem; line-height: 1.7; }
  .sw-credits p { margin: .35rem 0 0; }

  /* ---------- Phones: the same hang, down the screen ---------- */
  @media (max-width: 900px) {
    .sw { --floor-h: 0px; }
    .sw-bar { position: sticky; background: var(--wall); border-bottom: 1px solid var(--rule); }
    .sw-index { gap: .2rem; }
    .sw-index a { min-width: 2.25rem; justify-content: center; }
    .sw-index-name { display: none; }
    .sw-view { height: auto; overflow: visible; background: radial-gradient(120% 40% at 50% 10%, var(--wall-lit), transparent 70%); }
    .sw-track { display: block; width: auto; height: auto; padding: 0 1.25rem 3rem; background: none; transform: none !important; }
    .sw-text, .sw-panel, .sw-vitrine { width: auto; }
    .sw-intro { margin: 0; padding: 2.5rem 0 0; }
    .sw-intro h1 { font-size: 1.625rem; }
    .sw-hint { display: none; }
    .sw-sec { display: block; margin-top: 4rem; padding-top: 1rem; border-top: 1px solid var(--rule); scroll-margin-top: calc(var(--bar-h) + 1rem); }
    .sw-label { max-width: none; padding-top: 1rem; }
    /* The course wall as a salon cluster: today's first work across the width, the rest in two uneven columns. */
    .sw-hang { display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem .9rem; align-items: start; height: auto; }
    .sw-col { display: contents; }
    .sw-slot { display: block; padding-bottom: 0; }
    .sw-slot:has(.is-today) { padding-bottom: 0; }
    .sw-slot { order: 2; }
    .sw-slot:has(.is-today) { order: 1; }
    .sw-slot[data-slot="a"] { grid-column: 1 / -1; width: 78%; order: 0; }
    .sw-slot img, .sw-A img, .sw-B img, .sw-M img, .sw-S img { width: 100%; height: auto; max-width: 100%; }
    .sw-cap { position: static; white-space: normal; }
    .sw-work.is-today .sw-cap em, .sw-cap em { display: block; }
    .sw-wave img, .sw-bronze img, .sw-glass img { width: 100%; height: auto; }
    .sw-wave { margin: 0 -1.25rem; }
    .sw-pair { display: grid; grid-template-columns: 3fr 2fr; align-items: end; gap: 1rem; }
    .sw-panel { border-bottom: 0; padding-top: 0; border-top: 0; }
    .sw-credits { margin: 4rem 0 0; padding-bottom: env(safe-area-inset-bottom); }
  }
  @media (prefers-reduced-motion: reduce) { .sw-work img { transition: none; } }
</style>

<script>
  import { readReading, resolveEntry } from '../../lib/reading.js';
  import { readCollection, previewClaimed } from '../../lib/collection.js';
  import { deviceStorage } from '../../lib/storage.js';

  // The walk: on a wide screen, scrolling down moves the wall sideways. The hall is made as tall as the wall is long; the
  // view sticks to the top, and the track is shifted by the share of the hall scrolled through. Nothing on a timer.
  const hall = document.querySelector<HTMLElement>('[data-hall]')!;
  const view = hall.querySelector<HTMLElement>('[data-view]')!;
  const track = hall.querySelector<HTMLElement>('[data-track]')!;
  const wide = matchMedia('(min-width: 901px)');
  let travel = 0;
  const layout = () => {
    if (!wide.matches) { hall.classList.remove('is-walk'); hall.style.height = ''; track.style.transform = ''; travel = 0; return; }
    hall.classList.add('is-walk');
    travel = Math.max(0, track.scrollWidth - view.clientWidth);
    hall.style.height = `${travel + innerHeight}px`;
    move();
  };
  const move = () => {
    if (!travel) return;
    const p = Math.min(1, Math.max(0, -hall.getBoundingClientRect().top / travel));
    track.style.transform = `translate3d(${-p * travel}px, 0, 0)`;
    mark(p > 0.97 ? Infinity : p * travel + view.clientWidth * 0.4);
    light();
  };
  // The room's lights: each hall is lit by how close it is to the middle of what you see (--lit), and its label rises
  // onto the floor as the hall arrives (--reveal). With reduced motion everything stays fully lit and in place.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const lightables = [...track.querySelectorAll<HTMLElement>('[data-sec], .sw-intro')];
  const light = () => {
    const across = wide.matches, size = across ? innerWidth : innerHeight;
    for (const el of lightables) {
      if (still.matches) { el.style.setProperty('--lit', '1'); el.style.setProperty('--reveal', '1'); continue; }
      const r = el.getBoundingClientRect();
      const mid = across ? r.left + r.width / 2 : r.top + Math.min(r.height, size) / 2;
      const lit = 1 - Math.min(1, Math.abs(mid - size / 2) / (size * (across ? 0.75 : 0.9)));
      const lead = across ? r.left : r.top;
      const reveal = Math.min(1, Math.max(0, (size * 0.95 - lead) / (size * 0.35)));
      el.style.setProperty('--lit', lit.toFixed(3));
      el.style.setProperty('--reveal', reveal.toFixed(3));
    }
  };
  // The index: which hall is in front of you, and a way to walk straight to one.
  const secs = [...track.querySelectorAll<HTMLElement>('[data-sec]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-index]')];
  const mark = (x: number) => {
    let here = secs[0]?.dataset.sec;
    for (const s of secs) if (s.offsetLeft <= x) here = s.dataset.sec;
    links.forEach((a) => a.classList.toggle('is-here', a.dataset.index === here));
  };
  const goTo = (el: HTMLElement) => {
    if (!travel) return false;
    const x = Math.min(travel, Math.max(0, el.offsetLeft - view.clientWidth * 0.12));
    scrollTo({ top: hall.offsetTop + x, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    return true;
  };
  links.forEach((a) => a.addEventListener('click', (e) => {
    const s = secs.find((x) => x.dataset.sec === a.dataset.index);
    if (s && goTo(s)) e.preventDefault();
  }));
  // Keyboard: a focused link off to the side brings the wall to it.
  track.addEventListener('focusin', (e) => {
    if (!travel) return;
    const el = e.target as HTMLElement;
    const left = el.getBoundingClientRect().left, right = el.getBoundingClientRect().right;
    if (left < 0 || right > innerWidth) goTo(el.closest<HTMLElement>('.sw-slot, .sw-sec, .sw-text') ?? el);
  });
  let queued = false;
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; move(); }); } }, { passive: true });
  addEventListener('resize', layout);
  wide.addEventListener('change', layout);
  addEventListener('load', layout);
  new ResizeObserver(() => layout()).observe(track);
  layout();
  // Phones: the hall whose top has passed the middle of the screen is the one you are in; none above the first.
  const markDown = () => {
    if (wide.matches) return;
    let here: string | undefined;
    for (const s of secs) if (s.getBoundingClientRect().top < innerHeight * 0.45) here = s.dataset.sec;
    links.forEach((a) => a.classList.toggle('is-here', a.dataset.index === here));
    light();
  };
  addEventListener('scroll', () => requestAnimationFrame(markDown), { passive: true });
  markDown();

  // This browser's cards and the one article to resume, as on the production homepage (read only).
  const showCards = () => {
    const list = document.querySelector<HTMLElement>('[data-vitrine]');
    if (!list) return;
    const rows = [...list.querySelectorAll<HTMLElement>('[data-card-row]')];
    const { shown, total } = previewClaimed(readCollection(deviceStorage()), rows.map((r) => ({ id: r.dataset.cardRow! })));
    const visible = new Set(shown.map((c) => c.id));
    rows.forEach((r) => { r.hidden = !visible.has(r.dataset.cardRow!); });
    list.querySelector<HTMLElement>('[data-card-count]')!.textContent = String(total);
    list.querySelector<HTMLElement>('[data-card-total]')!.hidden = total <= 2;
    list.hidden = total === 0;
    // The cabinet: a claimed card's plate shows its work.
    const held = readCollection(deviceStorage());
    document.querySelectorAll<HTMLElement>('[data-plate]').forEach((p) => {
      const on = !!held[p.dataset.plate!];
      p.classList.toggle('is-held', on);
      if (on && !p.querySelector('img')) { const i = new Image(); i.src = p.dataset.src!; i.alt = ''; i.loading = 'lazy'; p.prepend(i); }
    });
    const count = document.querySelector('[data-held]');
    if (count) count.textContent = String(total);
  };
  const show = () => {
    const root = document.querySelector<HTMLElement>('[data-continue]');
    const raw = document.querySelector('[data-reading-registry]')?.textContent;
    if (!root || !raw) return;
    const hit = resolveEntry(readReading(deviceStorage()), JSON.parse(raw));
    if (!hit) { root.classList.remove('is-on'); return; }
    root.querySelector('[data-continue-kind]')!.textContent = `继续阅读 · ${hit.label}`;
    root.querySelector('[data-continue-p]')!.textContent = `${Math.round(hit.p * 100)}%`;
    const link = root.querySelector<HTMLAnchorElement>('[data-continue-link]')!;
    link.textContent = hit.title;
    link.href = `${hit.href}#resume`;
    root.querySelector<HTMLElement>('[data-continue-bar]')!.style.width = `${Math.round(hit.p * 100)}%`;
    root.classList.add('is-on');
    layout();
  };
  showCards(); show();
  addEventListener('pageshow', (e) => { if (e.persisted) { showCards(); show(); layout(); } });
</script>

<style>
  /* PREVIEW: Gallery white and Charcoal combined, three ways (?wall=duo, alt, auto). */
  .sw:is([data-wall="duo"], [data-wall="alt"], [data-wall="auto"]) {
    --wall: #eeece7; --wall-lit: #f7f6f3; --floor: #dcd8cf; --bar: 238 236 231; --ink: #1b1b1a; --ink-2: #5b5a56; --rule: rgb(0 0 0 / .16);
    --shadow: rgb(60 50 40 / .28); --case: rgb(255 255 255 / .35);
  }
  /* The charcoal set, for whatever part of the wall is dark. */
  .sw[data-wall="duo"] :is(.sw-label, .sw-bar), .sw[data-wall="alt"] :is(.sw-stories, .sw-atlas) {
    --ink: #efefec; --ink-2: #b2b2ad; --rule: rgb(255 255 255 / .15); --shadow: rgb(0 0 0 / .7); --case: rgb(0 0 0 / .14); color: var(--ink);
  }

  /* 1 · duo: white walls standing on a charcoal floor, with a charcoal bar above. The wall labels sit on the floor. */
  .sw[data-wall="duo"] { --floor: #1f2021; }
  .sw[data-wall="duo"] .sw-bar { background: #1f2021; }

  /* 2 · alt: the rooms alternate, white and charcoal, as you walk; 02 and 04 are the charcoal rooms. */
  .sw[data-wall="alt"] .sw-bar { background: var(--wall); border-bottom: 1px solid var(--rule); }
  @media (min-width: 901px) {
    .sw[data-wall="alt"] :is(.sw-stories, .sw-atlas) {
      --pad: clamp(2.5rem, 4.5vw, 4.5rem);
      margin: calc(-1 * (var(--bar-h) + 1.5rem)) calc(-1 * var(--pad)) 0; padding: calc(var(--bar-h) + 1.5rem) var(--pad) 0;
      background: linear-gradient(to bottom, #232425, #1f2021 calc(100% - var(--floor-h)), #141515 calc(100% - var(--floor-h)));
    }
  }
  @media (max-width: 900px) {
    .sw[data-wall="alt"] :is(.sw-stories, .sw-atlas) { margin: 4rem -1.25rem 0; padding: 2rem 1.25rem 2.5rem; border-top: 0; background: #1f2021; }
    .sw[data-wall="duo"] .sw-label { --ink: #1b1b1a; --ink-2: #5b5a56; --rule: rgb(0 0 0 / .16); }
    .sw[data-wall="duo"] .sw-credits { margin: 4rem -1.25rem 0; padding: 1.5rem 1.25rem max(2rem, env(safe-area-inset-bottom)); background: #1f2021;
      --ink: #efefec; --ink-2: #b2b2ad; color: var(--ink-2); }
  }

  /* 3 · auto: Gallery white in light mode, Charcoal in dark mode, following the visitor's device. */
  @media (prefers-color-scheme: dark) {
    .sw[data-wall="auto"] { --wall: #1f2021; --wall-lit: #2a2b2d; --floor: #141515; --bar: 20 21 21; --ink: #efefec; --ink-2: #b2b2ad; --rule: rgb(255 255 255 / .15);
      --shadow: rgb(0 0 0 / .7); --case: rgb(0 0 0 / .14); }
  }
</style>

<style>
  /* PREVIEW, option 1 refined (the default): one room, white walls standing on a charcoal floor, made to belong together.
     The wall darkens gently towards the floor and the floor catches a little reflected light where they meet, so there is
     no hard cut; each work hangs in a pool of light that comes up as you reach it and dims as you walk on; the wall labels
     rise onto the floor as their hall arrives. Phones: the same room vertically, each hall's label on a charcoal plinth. */
  .sw[data-wall="duo"] { --wall: #e7e5df; --wall-lit: #f3f2ee; overflow-x: clip; }
  @media (min-width: 901px) {
    .sw[data-wall="duo"] .sw-view {
      background:
        radial-gradient(70% 55% at 50% 28%, rgb(255 255 255 / .5), transparent 70%),
        linear-gradient(to bottom, transparent 52%, rgb(70 62 54 / .13) calc(100% - var(--floor-h) - 1px), transparent calc(100% - var(--floor-h))),
        linear-gradient(to bottom, var(--wall) calc(100% - var(--floor-h)), #303133 calc(100% - var(--floor-h)), #1f2021 calc(100% - var(--floor-h) + 3rem), #151617);
      background-attachment: scroll;
    }
    .sw[data-wall="duo"] .sw-bar { box-shadow: 0 10px 28px -14px rgb(0 0 0 / .5); }
    .sw[data-wall="duo"] .sw-label { opacity: calc(.3 + .7 * var(--reveal, 1)); transform: translateY(calc((1 - var(--reveal, 1)) * 16px)); }
  }
  /* The pools of light: drawn behind each work, brighter the nearer it is to you (--lit, 0 to 1, set by the walk). */
  .sw[data-wall="duo"] :is(.sw-work, .sw-hung) { position: relative; }
  .sw[data-wall="duo"] :is(.sw-work, .sw-hung)::before {
    content: ""; position: absolute; left: -38%; right: -38%; top: -24%; bottom: -8%; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 50% 58% at 50% 32%, rgb(255 253 246 / .95), rgb(255 253 246 / .35) 45%, transparent 72%);
    opacity: calc(.2 + .8 * var(--lit, 1));
  }
  .sw[data-wall="duo"] :is(.sw-work, .sw-hung) img { filter: brightness(calc(.88 + .12 * var(--lit, 1))); }

  @media (max-width: 900px) {
    /* Each hall stands on a charcoal plinth: its label, set just below its works. */
    .sw[data-wall="duo"] :is(.sw-label, .sw-panel, .sw-vitrine) {
      --ink: #efefec; --ink-2: #b2b2ad; --rule: rgb(255 255 255 / .15); --case: transparent; color: var(--ink-2);
      margin: 1.5rem -1.25rem 0; padding: 1.25rem 1.25rem 1.5rem; border: 0;
      background: linear-gradient(to bottom, #2a2b2d, #1f2021 2.5rem, #1a1b1c);
