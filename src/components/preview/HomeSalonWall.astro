  .sw-map-title { font: 400 .8125rem/1.3 var(--serif); color: var(--ink); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .sw-map-count { font: 400 .6875rem/1.6 var(--sans); font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .sw-ticks { grid-column: 2 / -1; display: flex; gap: 3px; }
  .sw-ticks i { width: 5px; height: 11px; background: var(--rule); }
  .sw-ticks i.is-open { background: var(--ink); }
  .sw-map a:hover .sw-map-title, .sw-map a:focus-visible .sw-map-title { text-decoration: underline; text-underline-offset: .2em; }

  /* The collection room: a cabinet of plates that grows sideways, three rows high, and the vitrine text beside it. */
  .sw-collection { grid-template-columns: auto auto; }
  .sw-cabinet { --plate: calc(var(--h) * .235); grid-row: 1; display: grid; grid-auto-flow: column; grid-template-rows: repeat(3, var(--plate)); grid-auto-columns: calc(var(--plate) * .75);
    gap: clamp(.75rem, 1.4vw, 1.1rem); margin-bottom: calc(var(--floor-h) * .3); text-decoration: none; }
  .sw-plate { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: .55rem .6rem; border: 1px solid var(--rule); background: var(--case, rgb(0 0 0 / .1));
    color: var(--ink-2); overflow: hidden; transition: border-color var(--t) var(--ease); }
  .sw-plate-no { font: italic 400 .8125rem/1 var(--latin); }
  .sw-plate-t { font: 400 .6875rem/1.45 var(--sans); opacity: .7; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sw-plate-more { justify-content: center; align-items: center; font: italic 400 1rem/1 var(--latin); }
  .sw-cabinet:hover .sw-plate { border-color: var(--ink-2); }
  /* A claimed plate: the work, matted, with its number. */
