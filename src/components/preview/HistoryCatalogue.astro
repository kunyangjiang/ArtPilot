---
// Phase 4.1B-0 — History Catalogue. The course index as an exhibition catalogue: an opening spread, a contents
// page of the seven stages, then two sample stage spreads (01 and 04) with their real course lists. Only lessons
// that exist are links; every other course is listed, numbered and marked as not yet open.
import { stages, courseTitles, implemented, sampleIntro, TOTAL_COURSES } from './curriculum';
import type { PreviewImages } from './images';
interface Props { lessons: { id: string; title: string; kicker: string }[]; images: PreviewImages }
const { lessons, images } = Astro.props;
const { wave, nataraja } = images;
const byId = Object.fromEntries(lessons.map((l) => [l.id, l]));
const pad = (n: number) => String(n).padStart(2, '0');

// The artwork each open lesson reads closely, shown as the row's descriptor.
const work: Record<string, string> = { 'mountain-and-smallness': '范宽《溪山行旅图》', 'stone-and-light': '沙特尔主教座堂' };
const courses = (first: number, last: number) =>
  Array.from({ length: last - first + 1 }, (_, i) => first + i).map((n) => {
    const lesson = implemented[n] ? byId[implemented[n]] : undefined;
    return lesson
      ? { n, title: lesson.title, href: `/lessons/${lesson.id}/`, descriptor: `${work[lesson.id]} · ${lesson.kicker}` }
      : { n, title: courseTitles[n] };
  });
const s1 = stages[0], s4 = stages[3];
const open = Object.values(implemented).map((id) => byId[id]).filter(Boolean);
---
<div class="hc">
  <header class="hc-top">
    <span class="hc-mark">ArtPilot</span>
    <a class="hc-back" href="/preview/home-exhibition-wall/"><span aria-hidden="true">←</span> 返回首页概念 · 展墙</a>
    <span class="hc-tag">课程目录概念 · 本地预览</span>
  </header>

  <section class="hc-open" aria-labelledby="hc-title">
    <div class="hc-open-text">
      <p class="hc-kicker"><span lang="en">Global Art History Courses</span>全球艺术史课程</p>
      <h1 id="hc-title">
        <span class="hc-fig"><span class="hc-num" lang="en">{TOTAL_COURSES}</span><span class="hc-unit">门核心课程</span></span>
        <span class="hc-fig"><span class="hc-num" lang="en">{stages.length}</span><span class="hc-unit">个历史阶段</span></span>
      </h1>
      <p class="hc-lede">从“学会欣赏艺术”开始，沿着大致的时间顺序，走到当代世界。课程按阶段编排，陆续开放；目前已开放 {open.length} 门。</p>
      <div class="hc-entry">
        <a class="hc-go" href="#stage-01"><span class="hc-go-main">从第 01 阶段开始</span><span class="hc-go-arrow" aria-hidden="true"></span></a>
        <p class="hc-open-list"><span>已开放</span>{open.map((l) => <a href={`/lessons/${l.id}/`}>{l.title}</a>)}</p>
      </div>
    </div>
    <figure class="hc-cover">
      <img src={wave.img.src} width={wave.img.width} height={wave.img.height} alt={wave.alt} />
      <figcaption><span class="hc-cap-no" lang="en">48</span>第 05 阶段《浮世绘为什么成为城市流行艺术？》· 筹备中<br />葛饰北斋《神奈川冲浪里》，约 1830–1832 年</figcaption>
    </figure>
  </section>

  <nav class="hc-contents" aria-labelledby="hc-contents-h">
    <h2 id="hc-contents-h" class="hc-label">目录 <span lang="en">Contents</span></h2>
    <ol>
      {stages.map((s) => {
        const sample = s.no === '01' || s.no === '04';
        const inner = <><span class="hc-c-no" lang="en">{s.no}</span><span class="hc-c-title">{s.title}</span><span class="hc-c-range">第 {s.first}–{s.last} 课 · {s.last - s.first + 1} 门</span><span class="hc-c-state">{sample ? '本页示例' : ''}</span></>;
        return <li>{sample ? <a class="hc-c is-sample" href={`#stage-${s.no}`}>{inner}</a> : <span class="hc-c">{inner}</span>}</li>;
      })}
    </ol>
    <p class="hc-note">第 02、03、05、06、07 阶段的课程列表在本概念中未展开。</p>
  </nav>

  <section id="stage-01" class="hc-stage hc-stage-a" aria-labelledby="hc-s1-h">
    <p class="hc-big" lang="en" aria-hidden="true">{s1.no}</p>
    <header class="hc-stage-head">
      <p class="hc-label">第 {s1.no} 阶段 · 第 {s1.first}–{s1.last} 课</p>
      <h2 id="hc-s1-h">{s1.title}</h2>
      <p class="hc-intro"><span class="hc-sample">示例文案</span>{sampleIntro['01']}</p>
    </header>
    <figure class="hc-plate hc-plate-tall">
      <img src="/img/fan-kuan-full.jpg" width="900" height="1805" alt="范宽《溪山行旅图》全幅：一座高耸的主峰占据画面大部分，右侧有细长瀑布，山脚树丛中有极小的驮队。" loading="lazy" />
      <figcaption><span class="hc-cap-no" lang="en">01</span>范宽《溪山行旅图》，约公元 1000 年前后，绢本水墨淡设色。国立故宫博物院（台北）藏。</figcaption>
    </figure>
    <ol class="hc-list">
      {courses(s1.first, s1.last).map((c) => <li>{c.href
        ? <a class="hc-row is-open" href={c.href}><span class="hc-r-no" lang="en">{pad(c.n)}</span><span class="hc-r-title">{c.title}<span class="hc-r-desc">{c.descriptor}</span></span><span class="hc-r-state">已开放<span class="hc-r-arrow" aria-hidden="true"></span></span></a>
        : <div class="hc-row"><span class="hc-r-no" lang="en">{pad(c.n)}</span><span class="hc-r-title">{c.title}</span><span class="hc-r-state">筹备中</span></div>}</li>)}
    </ol>
  </section>

  <section id="stage-04" class="hc-stage hc-stage-b" aria-labelledby="hc-s4-h">
    <p class="hc-big" lang="en" aria-hidden="true">{s4.no}</p>
    <header class="hc-stage-head">
      <p class="hc-label">第 {s4.no} 阶段 · 第 {s4.first}–{s4.last} 课</p>
      <h2 id="hc-s4-h">{s4.title}</h2>
      <p class="hc-intro"><span class="hc-sample">示例文案</span>{sampleIntro['04']}</p>
    </header>
    <ol class="hc-list">
      {courses(s4.first, s4.last).map((c) => <li>{c.href
        ? <a class="hc-row is-open" href={c.href}><span class="hc-r-no" lang="en">{pad(c.n)}</span><span class="hc-r-title">{c.title}<span class="hc-r-desc">{c.descriptor}</span></span><span class="hc-r-state">已开放<span class="hc-r-arrow" aria-hidden="true"></span></span></a>
        : <div class="hc-row"><span class="hc-r-no" lang="en">{pad(c.n)}</span><span class="hc-r-title">{c.title}</span><span class="hc-r-state">筹备中</span></div>}</li>)}
    </ol>
    <div class="hc-plates">
      <figure class="hc-plate hc-plate-tall">
        <img src="/img/chartres-west.jpg" width="1067" height="1600" alt="沙特尔主教座堂中殿向西回望：交叉的石肋拱顶下，是圆形的西玫瑰窗和三扇长窗。" loading="lazy" />
        <figcaption><span class="hc-cap-no" lang="en">30</span>沙特尔主教座堂，中殿向西回望（2022 年摄）。</figcaption>
      </figure>
      <figure class="hc-plate hc-plate-small">
        <img src={nataraja.img.src} width={nataraja.img.width} height={nataraja.img.height} alt={nataraja.alt} loading="lazy" />
        <figcaption><span class="hc-cap-no" lang="en">33</span>《舞王湿婆》，印度泰米尔纳德，12 世纪末至 13 世纪初 · 课程筹备中</figcaption>
      </figure>
    </div>
  </section>

  <footer class="hc-credits">
    <p>本页为课程目录概念预览，不是正式页面。课程编号、阶段与标题依据已批准的核心课程大纲（83 门，八个推荐阶段）；第 30 课显示的是 Phase 4.0-A 批准的新标题（大纲工作标题为《{courseTitles[30]}》）。阶段简介为示例文案，未经批准。</p>
    <p>{wave.caption} {wave.credit}，<a href={wave.source}>来源</a>。</p>
    <p>{nataraja.caption} {nataraja.credit}，<a href={nataraja.source}>来源</a>。</p>
    <p>范宽《溪山行旅图》：公有领域（Wikimedia Commons，PD-Art），派生缩小版，详见课程页“来源与版权”。沙特尔主教座堂中殿向西：Ludvig14，<a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>，2022 年，缩小并重新压缩，未裁切、未调色，<a href="https://commons.wikimedia.org/wiki/File:Chartres_Notre-Dame_Interior_018_2904.jpg">来源</a>。</p>
  </footer>
</div>

<style>
  .hc { --gut: clamp(1.5rem, 4.5vw, 5.5rem); min-height: 100vh; background: #fbfbfa; color: var(--ink); padding: 0 var(--gut) 4rem; }
  .hc a { color: inherit; text-decoration: none; }
  .hc :focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .hc [lang="en"] { font-family: var(--latin); }

  .hc-top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: baseline; padding: 1.6rem 0 1.25rem; border-bottom: 1px solid var(--rule); }
  .hc-mark { font: 400 1.0625rem/1 var(--latin); letter-spacing: .32em; text-transform: uppercase; }
  .hc-back { font: 400 .8125rem/1 var(--sans); letter-spacing: .06em; color: var(--ink-2); padding: .4rem 0; border-bottom: 1px solid transparent; transition: border-color var(--t) var(--ease), color var(--t) var(--ease); }
  .hc-back:hover, .hc-back:focus-visible { color: var(--ink); border-bottom-color: var(--ink); }
  .hc-tag { justify-self: end; font: 400 .75rem/1 var(--sans); letter-spacing: .14em; color: var(--ink-3); }
  .hc-label { margin: 0; font: 500 .75rem/1.5 var(--sans); letter-spacing: .2em; color: var(--ink-3); }
  .hc-label [lang="en"] { margin-left: .5em; font-style: italic; letter-spacing: .04em; }

  /* Opening spread: the two figures set as type on the left page, one plate on the right. */
  .hc-open { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(2.5rem, 6vw, 7rem); align-items: end; padding: clamp(3rem, 9vh, 6.5rem) 0 clamp(3.5rem, 9vh, 6rem); }
  .hc-kicker { margin: 0 0 clamp(1.5rem, 4vh, 2.5rem); font: 500 .8125rem/1.5 var(--sans); letter-spacing: .2em; color: var(--ink-2); }
  .hc-kicker [lang="en"] { display: block; margin-bottom: .35rem; font-size: 1.0625rem; font-style: italic; letter-spacing: .02em; color: var(--ink); }
  .hc h1 { margin: 0; font-weight: 400; }
  .hc-fig { display: flex; align-items: baseline; gap: 1.25rem; }
  .hc-fig + .hc-fig { margin-top: -.15em; padding-left: clamp(4rem, 11vw, 12rem); }
  .hc-num { font: 400 clamp(8rem, 15vw, 15rem)/.86 var(--latin); letter-spacing: -.04em; font-variant-numeric: lining-nums; }
  .hc-unit { font: 500 clamp(1.375rem, 2vw, 1.875rem)/1.2 var(--serif); letter-spacing: .08em; }
  .hc-lede { max-width: 30rem; margin: clamp(2rem, 5vh, 3rem) 0 0; font: 400 1.0625rem/1.9 var(--serif); color: var(--ink-2); }
  .hc-entry { display: flex; flex-wrap: wrap; align-items: end; gap: 1.25rem 3rem; margin-top: 2.25rem; }
  .hc-go { display: inline-flex; align-items: center; gap: 1rem; padding: .35rem 0; border-bottom: 1px solid var(--ink); }
  .hc-go-main { font: 500 clamp(1.375rem, 1.8vw, 1.75rem)/1.2 var(--serif); letter-spacing: .04em; }
  .hc-go-arrow, .hc-r-arrow { position: relative; display: inline-block; width: 2.75rem; height: 1px; background: currentColor; transition: width var(--t) var(--ease); }
  .hc-go-arrow::after, .hc-r-arrow::after { content: ''; position: absolute; right: 0; top: -4px; width: 8px; height: 8px; border: solid currentColor; border-width: 1px 1px 0 0; transform: rotate(45deg); }
  .hc-go:hover .hc-go-arrow, .hc-go:focus-visible .hc-go-arrow { width: 4rem; }
  .hc-open-list { display: flex; flex-direction: column; gap: .3rem; margin: 0; font: 400 .875rem/1.5 var(--serif); }
  .hc-open-list span { font: 500 .6875rem/1.5 var(--sans); letter-spacing: .2em; color: var(--ink-3); }
  .hc-open-list a { color: var(--ink-2); border-bottom: 1px solid var(--rule); justify-self: start; width: fit-content; transition: color var(--t) var(--ease), border-color var(--t) var(--ease); }
  .hc-open-list a:hover, .hc-open-list a:focus-visible { color: var(--ink); border-bottom-color: var(--ink); }
  .hc-cover { margin: 0; }
  .hc-cover img { display: block; width: 100%; height: auto; }
  .hc figcaption { display: flex; gap: .75rem; margin-top: .75rem; font: 400 .75rem/1.7 var(--sans); color: var(--ink-3); }
  .hc-cover figcaption { display: block; padding-left: 2.25rem; text-indent: -2.25rem; }
  .hc-cap-no { display: inline-block; min-width: 1.5rem; margin-right: .75rem; text-indent: 0; font-size: .875rem; color: var(--ink); }

  /* Contents page: seven stages on hairlines; only the two sample stages are links. */
  .hc-contents { padding: 2.5rem 0 1rem; border-top: 1px solid var(--ink); }
  .hc-contents ol { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2.5rem, 6vw, 7rem); }
  .hc-c { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr) auto; grid-template-areas: 'no title state' 'no range state'; column-gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--rule); color: var(--ink-3); }
  .hc-c-no { grid-area: no; font-size: 1.75rem; line-height: 1; }
  .hc-c-title { grid-area: title; font: 500 1.0625rem/1.5 var(--serif); }
  .hc-c-range { grid-area: range; font: 400 .75rem/1.6 var(--sans); }
  .hc-c-state { grid-area: state; align-self: center; font: 400 .75rem/1 var(--sans); letter-spacing: .1em; }
  .hc-c.is-sample { color: var(--ink); transition: background-color var(--t) var(--ease); }
  .hc-c.is-sample .hc-c-range, .hc-c.is-sample .hc-c-state { color: var(--ink-2); }
  .hc-c.is-sample:hover, .hc-c.is-sample:focus-visible { background: var(--mist); }
  .hc-note { margin: 1rem 0 0; font: 400 .75rem/1.6 var(--sans); color: var(--ink-3); }

  /* Stage spreads. The numeral is set huge and pale, behind the opening of each spread. */
  .hc-stage { position: relative; display: grid; column-gap: clamp(2.5rem, 6vw, 7rem); row-gap: 2.5rem; padding: clamp(5rem, 12vh, 8rem) 0 clamp(2rem, 6vh, 4rem); scroll-margin-top: 1rem; }
  .hc-stage-a { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-areas: 'big head' 'plate list'; }
  .hc-stage-b { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: 'head big' 'list plates'; }
  .hc-big { grid-area: big; align-self: end; margin: 0; font: 300 clamp(12rem, 24vw, 24rem)/.72 var(--latin); letter-spacing: -.05em; color: var(--ink); }
  .hc-stage-b .hc-big { justify-self: end; }
  .hc-stage-head { grid-area: head; align-self: end; padding-bottom: .5rem; border-bottom: 1px solid var(--ink); }
  .hc-stage h2 { margin: .75rem 0 0; font: 500 clamp(2rem, 3.2vw, 3rem)/1.3 var(--serif); letter-spacing: .04em; }
  .hc-intro { max-width: 34rem; margin: 1.25rem 0 1.5rem; font: 400 1rem/1.9 var(--serif); color: var(--ink-2); }
  .hc-sample { display: inline-block; margin-right: .75rem; padding: 0 .4rem; border: 1px solid var(--rule); font: 400 .6875rem/1.6 var(--sans); letter-spacing: .12em; color: var(--ink-3); vertical-align: .1em; }
  .hc-plate { grid-area: plate; margin: 0; }
  .hc-plate img { display: block; width: 100%; height: auto; }
  .hc-plate-tall img { max-height: 88vh; width: auto; max-width: 100%; }
  .hc-plates { grid-area: plates; display: flex; flex-direction: column; gap: 2.5rem; }
  .hc-plate-small { width: 58%; align-self: flex-end; }

  /* Course list: number, title, state. Open courses are links with a directional cue; the rest are plain text. */
  .hc-list { grid-area: list; list-style: none; margin: 0; padding: 0; align-self: start; }
  .hc-row { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) 6.5rem; column-gap: 1rem; align-items: baseline; padding: 1.05rem .5rem 1.05rem 0; border-bottom: 1px solid var(--rule); color: var(--ink-3); }
  .hc-r-no { font-size: 1.25rem; line-height: 1; font-variant-numeric: lining-nums tabular-nums; }
  .hc-r-title { font: 400 1.0625rem/1.6 var(--serif); }
  .hc-r-desc { display: block; margin-top: .2rem; font: 400 .75rem/1.6 var(--sans); letter-spacing: .04em; color: var(--ink-3); }
  .hc-r-state { justify-self: end; display: inline-flex; align-items: center; gap: .6rem; font: 400 .75rem/1 var(--sans); letter-spacing: .1em; }
  .hc-r-arrow { width: 1.5rem; }
  .hc-row.is-open { color: var(--ink); transition: background-color var(--t) var(--ease), padding var(--t) var(--ease); }
  .hc-row.is-open .hc-r-no { font-size: 1.5rem; }
  .hc-row.is-open .hc-r-title { font-weight: 500; font-size: 1.1875rem; }
  .hc-row.is-open:hover, .hc-row.is-open:focus-visible { background: var(--mist); padding-left: .75rem; }
  .hc-row.is-open:hover .hc-r-arrow, .hc-row.is-open:focus-visible .hc-r-arrow { width: 2.5rem; }
  .hc-row.is-open:focus-visible { outline-offset: 0; }

  .hc-credits { margin-top: clamp(4rem, 10vh, 6rem); padding-top: 1.25rem; border-top: 1px solid var(--rule); font: 400 .75rem/1.8 var(--sans); color: var(--ink-3); }
  .hc-credits p { margin: 0 0 .25rem; max-width: 62rem; }
  .hc-credits a { text-decoration: underline; text-underline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .hc *, .hc *::after { transition: none !important; }
    html:has(.hc) { scroll-behavior: auto; }
  }
  @media (prefers-reduced-motion: no-preference) { html:has(.hc) { scroll-behavior: smooth; } }

  /* Narrow screens: one column in reading order. Not a mobile design, just safe. */
  @media (max-width: 900px) {
    .hc-top { grid-template-columns: 1fr auto; row-gap: .75rem; }
    .hc-back { grid-column: 1 / -1; grid-row: 2; justify-self: start; }
    .hc-open, .hc-stage-a, .hc-stage-b { grid-template-columns: 1fr; }
    .hc-stage-a { grid-template-areas: 'big' 'head' 'plate' 'list'; }
    .hc-stage-b { grid-template-areas: 'big' 'head' 'list' 'plates'; }
    .hc-stage-b .hc-big { justify-self: start; }
    .hc-open { row-gap: 2.5rem; }
    .hc-fig + .hc-fig { padding-left: 2.5rem; }
    .hc-contents ol { grid-template-columns: 1fr; }
    .hc-row { grid-template-columns: 2.75rem minmax(0, 1fr) auto; }
    .hc-plate-small { width: 70%; }
  }
</style>
