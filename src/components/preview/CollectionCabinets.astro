---
// Concept spike, local preview only: Collection Cabinets (私人收藏展柜). The collection as three views on one page:
// an overview of the cabinets that hold something (one per approved stage), a cabinet's compact wall of thumbnails,
// and one card in focus with its existing front/back. Views are hash locations (#cabinets, #cabinet-04, #card-<id>),
// so links, Back/Forward and keyboard all behave natively; no modal, no framework.
// Data: the real published cards (as this browser has claimed them, or included in a sample set) and clearly marked
// sample cards for layout stress tests. Samples are never stored, never claimable and never look like artworks.
import '../../styles/fonts.css';
import { getCollection } from 'astro:content';
import ArtworkCard from '../ArtworkCard.astro';
import { stages, courseTitles } from '../../data/curriculum';
import { cardNumber } from '../../lib/publication.js';

const lessons = await getCollection('lessons');
const courseOf = new Map(lessons.map((l) => [l.data.artwork.id, l.data.course]));
const real = (await getCollection('artworks')).filter((a) => a.data.card && courseOf.has(a.id))
  .map((a) => ({ id: a.id, course: courseOf.get(a.id)!, title: a.data.titleZh }));
const stageOf = (n: number) => stages.find((s) => n >= s.first && n <= s.last)!.no;
const item = (n: number) => {
  const r = real.find((x) => x.course === n);
  return r ? { id: r.id, no: cardNumber(n), title: r.title, cabinet: stageOf(n), real: true }
    : { id: `sample-${cardNumber(n)}`, no: cardNumber(n), title: courseTitles[n], cabinet: stageOf(n), real: false };
};
const realCourses = real.map((r) => r.course);
const twenty = [1, 3, 5, 8, 11, 13, 16, 19, 22, 26, 28, 30, 33, 36, 41, 45, 52, 57, 63, 70];
// "Other series" stands in for content whose cards and numbering are not yet approved: unnumbered, sample only.
const others = Array.from({ length: 7 }, (_, i) => ({ id: `sample-other-${i + 1}`, no: '', title: `其他系列示例 ${i + 1}`, cabinet: 'other', real: false }));
const sets = {
  three: [...realCourses, 8].sort((a, b) => a - b).map(item),
  twenty: twenty.map(item),
  eighty: [...Array.from({ length: 73 }, (_, i) => item(i + 1)), ...others],
};
const cabinets = [...stages.map((s) => ({ id: s.no, no: s.no, title: s.title, range: `第 ${s.first}–${s.last} 课` })),
  { id: 'other', no: '—', title: '其他系列（示例；编号与归属规则未定）', range: '' }];
const data = { realCards: real.map((r) => item(r.course)), sets, cabinets };
---
<div class="cc" data-cc>
  <nav class="cc-sample" aria-label="预览数据">
    <span>概念预览 · 数据：</span>
    <a href="?set=real">本机真实收藏</a><a href="?set=empty">空</a><a href="?set=three">3 件</a><a href="?set=twenty">约 20 件</a><a href="?set=eighty">约 80 件</a>
    <span class="cc-sample-note" data-sample-note></span>
  </nav>

  <!-- 1. Overview: the cabinets that hold something. -->
  <section class="cc-view" data-view="cabinets" aria-labelledby="cc-title">
    <header class="cc-head">
      <p class="cc-kicker">藏品图鉴 · 私人收藏展柜</p>
      <h1 id="cc-title" tabindex="-1">我的收藏</h1>
      <p class="cc-total" data-total></p>
    </header>
    <p class="cc-intro" data-empty-intro hidden>读完一门课程，在课末领取它的藏品卡。你收藏的作品会按照课程的七个阶段，陈列在各自的展柜里。</p>
    <ol class="cc-cabinets" data-cabinet-list></ol>
    <div class="cc-more" aria-hidden="true"><span class="cc-plus"></span><p>更多作品，等待发现</p></div>
  </section>

  <!-- 2. One cabinet: a compact wall of its cards. -->
  <section class="cc-view" data-view="cabinet" aria-labelledby="cc-cabinet-title" hidden>
    <a class="cc-back" href="#cabinets"><span aria-hidden="true">←</span> 全部展柜</a>
    <header class="cc-cabinet-head">
      <p class="cc-cabinet-no" data-cabinet-no aria-hidden="true"></p>
      <div>
        <h2 id="cc-cabinet-title" tabindex="-1" data-cabinet-title></h2>
        <p class="cc-cabinet-meta" data-cabinet-meta></p>
      </div>
    </header>
    <ol class="cc-wall" data-wall></ol>
  </section>

  <!-- 3. One card in focus, full size, with its own front and back. -->
  <section class="cc-view" data-view="card" aria-labelledby="cc-card-title" hidden>
    <a class="cc-back" data-card-back href="#cabinets"><span aria-hidden="true">←</span> <span data-card-back-label></span></a>
    <h2 class="sr-only" id="cc-card-title" tabindex="-1" data-card-title></h2>
    <div class="cc-stage" data-stage></div>
    <nav class="cc-steps" aria-label="同一展柜中的其他作品">
      <a data-prev href="#cabinets"><span aria-hidden="true">←</span> 上一件</a>
      <span data-position></span>
      <a data-next href="#cabinets">下一件 <span aria-hidden="true">→</span></a>
    </nav>
  </section>

  <!-- Parts the views are built from: the real cards (full and mini) and the sample card. -->
  <div class="cc-pool" hidden>
    {real.map((r) => <div data-pool-full={r.id}><ArtworkCard artwork={r.id} /></div>)}
    {real.map((r) => <div data-pool-mini={r.id}><ArtworkCard artwork={r.id} variant="mini" /></div>)}
    <div data-pool-sample class="cc-sample-card"><p class="cc-sample-tag">示例</p><p class="cc-sample-no" data-s-no></p><p class="cc-sample-title" data-s-title></p><p class="cc-sample-foot">预览用示例卡 · 非真实藏品</p></div>
  </div>
  <script type="application/json" data-cc-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
</div>

<style is:global>
  .cc { --pad: max(1.25rem, calc((100% - 70rem) / 2)); min-height: 100vh; padding: 0 var(--pad) 5rem; background: var(--gallery); color: var(--gallery-ink);
    --serif: "ArtPilot Serif SC", "Noto Serif SC", "Source Han Serif SC", serif; --latin-d: "ArtPilot Bodoni", "Bodoni Moda", Didot, serif; }
  .cc a { color: inherit; }
  .cc :focus-visible { outline: 2px solid var(--gallery-ink); outline-offset: 4px; }
  .cc-sample { display: flex; flex-wrap: wrap; gap: .4rem .9rem; padding: .9rem 0; border-bottom: 1px dashed var(--gallery-rule); font: 400 .75rem/1.6 var(--sans); color: var(--gallery-ink-2); }
  .cc-sample a { text-decoration: none; border-bottom: 1px solid transparent; }
  .cc-sample a[aria-current="true"] { color: var(--gallery-ink); border-bottom-color: var(--gallery-ink-2); }
  .cc-sample-note { flex-basis: 100%; }
  .cc-view[hidden] { display: none; }
  .cc .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Overview */
  .cc-head { padding: clamp(2.5rem, 6vw, 4.5rem) 0 0; }
  .cc-kicker { margin: 0 0 1rem; font: 500 .75rem/1.5 var(--sans); letter-spacing: .2em; color: var(--gallery-ink-2); }
  .cc h1 { margin: 0; font: 500 clamp(2.25rem, 5vw, 3.25rem)/1.2 var(--serif); letter-spacing: .12em; }
  .cc-total { margin: 1rem 0 0; font: 400 .9375rem/1.6 var(--sans); letter-spacing: .06em; color: var(--gallery-ink-2); }
  .cc-total b { font: 400 1.75rem/1 var(--latin-d); color: var(--gallery-ink); margin: 0 .2em; }
  .cc-intro { max-width: 30rem; margin: 1.25rem 0 0; font: 400 .9375rem/1.85 var(--sans); color: var(--gallery-ink-2); }
  .cc-cabinets { margin: 2.5rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--gallery-ink-2); }
  .cc-cabinets li { border-bottom: 1px solid var(--gallery-rule); }
  .cc-cab { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) auto; grid-template-areas: 'no name count' 'no strip strip'; column-gap: 1rem; row-gap: .8rem;
    padding: 1.25rem 0 1.4rem; text-decoration: none; }
  .cc-cab-no { grid-area: no; font: 400 3rem/.85 var(--latin-d); }
  .cc-cab-name { grid-area: name; display: grid; gap: .2rem; }
  .cc-cab-title { font: 500 1.125rem/1.45 var(--serif); letter-spacing: .04em; }
  .cc-cab-range { font: 400 .75rem/1.5 var(--sans); letter-spacing: .08em; color: var(--gallery-ink-2); }
  .cc-cab-count { grid-area: count; align-self: start; font: 400 .8125rem/1.4 var(--sans); letter-spacing: .08em; color: var(--gallery-ink-2); white-space: nowrap; }
  .cc-cab-count b { font: 400 1.375rem/1 var(--latin-d); color: var(--gallery-ink); margin-right: .15em; }
  .cc-strip { grid-area: strip; display: flex; align-items: flex-end; gap: .45rem; margin: 0; padding: 0; list-style: none; }
  .cc-strip > li { width: 2.9rem; border: 0; }
  .cc-strip-more { font: 400 .75rem/1 var(--sans); color: var(--gallery-ink-2); padding: 0 0 .2rem .3rem; }
  .cc-strip-go { margin-left: auto; font: 500 .8125rem/1 var(--sans); letter-spacing: .08em; padding-bottom: .2rem; }
  .cc-cab:hover .cc-cab-title, .cc-cab:focus-visible .cc-cab-title { text-decoration: underline 1px; text-underline-offset: .3em; }
  .cc-more { display: grid; place-content: center; justify-items: center; gap: .75rem; width: 9rem; aspect-ratio: 63 / 88; margin-top: 2.5rem; padding: 1rem;
    border: 1px dashed var(--gallery-rule); border-radius: .6rem; text-align: center; }
  .cc-more p { margin: 0; font: 400 .75rem/1.7 var(--sans); color: var(--gallery-ink-2); }
  .cc-plus { position: relative; width: 1.25rem; height: 1.25rem; }
  .cc-plus::before, .cc-plus::after { content: ""; position: absolute; left: 50%; top: 50%; background: var(--gallery-ink-2); transform: translate(-50%, -50%); }
  .cc-plus::before { width: 100%; height: 1px; } .cc-plus::after { width: 1px; height: 100%; }

  /* Any card at any size: real cards are em-sized, so a thumbnail is the same cover scaled to its box. */
  .cc-fit { container-type: inline-size; }
  .cc-fit .art-card { font-size: calc(100cqw / 18); width: 18em; }
  .cc-fit .cc-sample-card { font-size: calc(100cqw / 18); }

  /* Cabinet */
  .cc-back { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; margin-top: 1.5rem; font: 400 .875rem/1 var(--sans); letter-spacing: .08em; text-decoration: none; color: var(--gallery-ink-2); }
  .cc-back:hover, .cc-back:focus-visible { color: var(--gallery-ink); }
  .cc-cabinet-head { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: end; column-gap: 1.25rem; margin-top: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--gallery-ink-2); }
  .cc-cabinet-no { margin: 0; font: 400 clamp(3.5rem, 9vw, 5.5rem)/.8 var(--latin-d); }
  .cc h2 { margin: 0; font: 500 clamp(1.25rem, 2.6vw, 1.75rem)/1.4 var(--serif); letter-spacing: .05em; }
  .cc-cabinet-meta { margin: .35rem 0 0; font: 400 .8125rem/1.5 var(--sans); letter-spacing: .08em; color: var(--gallery-ink-2); }
  .cc-wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(9rem, calc(50% - .6rem)), 1fr)); gap: 1.75rem 1.1rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  @media (min-width: 720px) { .cc-wall { grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 2.25rem 1.75rem; } }
  .cc-thumb { display: block; text-decoration: none; border-radius: .45rem; }
  .cc-thumb .art-card { transition: transform var(--t, .25s) var(--ease); }
  .cc-thumb:hover .art-card, .cc-thumb:focus-visible .art-card { transform: translateY(-3px); }
  .cc-cap { display: block; margin-top: .6rem; font: 400 .8125rem/1.5 var(--serif); }
  .cc-cap span { display: block; font: italic 400 .75rem/1.4 var(--latin-d); color: var(--gallery-ink-2); }

  /* Focus */
  .cc-stage { display: grid; justify-items: center; margin-top: 1.25rem; }
  .cc-stage .art-card { font-size: min(1.3rem, calc((100vw - 2.5rem) / 18)); }
  .cc-stage .cc-sample-card { font-size: min(1.3rem, calc((100vw - 2.5rem) / 18)); }
  .cc-steps { display: flex; justify-content: space-between; align-items: center; gap: 1rem; max-width: 26rem; margin: 2rem auto 0; font: 400 .875rem/1 var(--sans); letter-spacing: .06em; color: var(--gallery-ink-2); }
  .cc-steps a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; text-decoration: none; color: var(--gallery-ink); }
  .cc-steps a[aria-disabled="true"] { visibility: hidden; }

  /* Sample card: card-shaped, plainly a stand-in. */
  .cc-sample-card { position: relative; display: grid; align-content: space-between; width: 18em; aspect-ratio: 63 / 88; padding: 1em; border: 1px dashed rgb(255 255 255 / .28);
    border-radius: .45em; background: repeating-linear-gradient(135deg, rgb(255 255 255 / .03) 0 .6em, transparent .6em 1.2em), #121211; color: var(--gallery-ink-2); }
  .cc-sample-tag { justify-self: start; margin: 0; padding: .2em .7em; border: 1px solid var(--gallery-ink-2); border-radius: 999px; font: 500 .75em/1.4 var(--sans); letter-spacing: .3em; }
  .cc-sample-no { margin: 0; font: 400 4em/1 var(--latin-d); color: transparent; -webkit-text-stroke: 1px var(--gallery-ink-2); }
  .cc-sample-title { margin: 0; font: 400 1em/1.6 var(--serif); color: var(--gallery-ink); }
  .cc-sample-foot { margin: 0; font: 400 .7em/1.5 var(--sans); letter-spacing: .12em; }
  .cc-strip .cc-sample-card { padding: .5em; }
  .cc-strip .cc-sample-card > * { display: none; } /* at strip size a sample is just its hatched outline */

  @media (max-width: 520px) {
    .cc-cab { grid-template-columns: 3.5rem minmax(0, 1fr) auto; }
    .cc-cab-no { font-size: 2.5rem; }
    .cc-strip > li { width: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cc-thumb .art-card { transition: none; } }
</style>

<script>
  type Item = { id: string; no: string; title: string; cabinet: string; real: boolean };
  type Cabinet = { id: string; no: string; title: string; range: string };
  import { readCollection } from '../../lib/collection.js';
  import { deviceStorage } from '../../lib/storage.js';

  const root = document.querySelector<HTMLElement>('[data-cc]')!;
  const data = JSON.parse(root.querySelector('[data-cc-data]')!.textContent!) as { realCards: Item[]; sets: Record<string, Item[]>; cabinets: Cabinet[] };
  const set = new URLSearchParams(location.search).get('set') ?? 'real';
  root.querySelectorAll<HTMLAnchorElement>('.cc-sample a').forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `?set=${set}`)));
  root.querySelector('[data-sample-note]')!.textContent = set === 'real'
    ? '本机真实收藏：只读取这台浏览器已领取的卡片，不写入任何数据。'
    : '示例数据：用于检验排版。示例卡带有“示例”标记，不会被保存，也不能领取。';
  const items: Item[] = set === 'real'
    ? data.realCards.filter((c) => readCollection(deviceStorage())[c.id])
    : set === 'empty' ? [] : data.sets[set] ?? [];
  // Card order: by number within the numbered series; unnumbered samples last. Never by claim date.
  items.sort((a, b) => (a.no || '999').localeCompare(b.no || '999'));
  const inCabinet = (id: string) => items.filter((c) => c.cabinet === id);
  const filled = data.cabinets.filter((k) => inCabinet(k.id).length);

  // Real cards shown here count as collected: in sample sets they are included without being claimed (nothing is saved).
  const asCollected = (el: Element) => el.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => {
    c.dataset.collected = 'true';
    c.querySelector<HTMLButtonElement>('.art-card-flip')?.removeAttribute('hidden');
  });
  const visual = (c: Item, size: 'mini' | 'strip') => {
    const box = document.createElement('div'); box.className = 'cc-fit';
    if (c.real) box.append(root.querySelector(`[data-pool-mini="${c.id}"] .art-card`)!.cloneNode(true));
    else {
      const s = root.querySelector('[data-pool-sample]')!.cloneNode(true) as HTMLElement;
      s.removeAttribute('data-pool-sample');
      s.querySelector('[data-s-no]')!.textContent = c.no ? `No.${c.no}` : '—';
      s.querySelector('[data-s-title]')!.textContent = c.title;
      box.append(s);
    }
    if (size === 'strip') box.setAttribute('aria-hidden', 'true');
    asCollected(box);
    return box;
  };

  // Overview
  const total = root.querySelector<HTMLElement>('[data-total]')!;
  total.innerHTML = items.length ? `已收藏<b>${items.length}</b>件 · 陈列在 ${filled.length} 个展柜` : '还没有收藏';
  root.querySelector<HTMLElement>('[data-empty-intro]')!.hidden = items.length > 0;
  const list = root.querySelector<HTMLElement>('[data-cabinet-list]')!;
  for (const k of filled) {
    const cards = inCabinet(k.id);
    const li = document.createElement('li');
    const a = document.createElement('a'); a.className = 'cc-cab'; a.href = `#cabinet-${k.id}`;
    a.setAttribute('aria-label', `${k.title}，${cards.length} 件`);
    a.innerHTML = `<span class="cc-cab-no" lang="en"></span><span class="cc-cab-name"><span class="cc-cab-title"></span><span class="cc-cab-range"></span></span><span class="cc-cab-count"><b></b>件</span><ul class="cc-strip"></ul>`;
    a.querySelector('.cc-cab-no')!.textContent = k.no;
    a.querySelector('.cc-cab-title')!.textContent = k.title;
    a.querySelector('.cc-cab-range')!.textContent = k.range;
    a.querySelector('.cc-cab-count b')!.textContent = String(cards.length);
    const strip = a.querySelector('.cc-strip')!;
    cards.slice(0, 4).forEach((c) => { const s = document.createElement('li'); s.append(visual(c, 'strip')); strip.append(s); });
    if (cards.length > 4) { const m = document.createElement('li'); m.className = 'cc-strip-more'; m.textContent = `+${cards.length - 4}`; m.style.width = 'auto'; strip.append(m); }
    const go = document.createElement('li'); go.className = 'cc-strip-go'; go.style.width = 'auto'; go.textContent = '打开展柜 →'; strip.append(go);
    li.append(a); list.append(li);
  }

  // Views
  const views = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-view]')].map((v) => [v.dataset.view!, v]));
  let first = true;
  const show = (name: string, focus: HTMLElement) => {
    for (const [k, v] of Object.entries(views)) v.hidden = k !== name;
    // Moving between views: start at the top, with focus on the new view's heading (not on first arrival).
    if (!first) { scrollTo({ top: 0, behavior: 'instant' }); focus.focus({ preventScroll: true }); }
    first = false;
  };
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  const park = () => stage.querySelectorAll('[data-park]').forEach((el) => {
    const card = el.querySelector('.art-card')!;
    if (card.getAttribute('data-flipped') === 'true') (card.querySelector('.art-card-flip') as HTMLButtonElement).click(); // put it back face up
    root.querySelector(`[data-pool-full="${el.getAttribute('data-park')}"]`)!.append(card); el.remove();
  });
  const render = () => {
    const h = location.hash.slice(1);
    park(); stage.replaceChildren();
    const cab = h.startsWith('cabinet-') ? data.cabinets.find((k) => k.id === h.slice(8)) : undefined;
    const card = h.startsWith('card-') ? items.find((c) => c.id === h.slice(5)) : undefined;
    if (cab && inCabinet(cab.id).length) {
      const cards = inCabinet(cab.id);
      root.querySelector('[data-cabinet-no]')!.textContent = cab.no;
      root.querySelector('[data-cabinet-title]')!.textContent = cab.title;
      root.querySelector('[data-cabinet-meta]')!.textContent = `${cab.range ? cab.range + ' · ' : ''}已收藏 ${cards.length} 件`;
      const wall = root.querySelector<HTMLElement>('[data-wall]')!; wall.replaceChildren();
      for (const c of cards) {
        const li = document.createElement('li');
        const a = document.createElement('a'); a.className = 'cc-thumb'; a.href = `#card-${c.id}`;
        a.setAttribute('aria-label', `${c.no ? 'No.' + c.no + ' ' : ''}${c.title}${c.real ? '' : '（示例）'}`);
        a.append(visual(c, 'mini'));
        const cap = document.createElement('span'); cap.className = 'cc-cap'; cap.setAttribute('aria-hidden', 'true');
        cap.innerHTML = '<span></span>'; cap.firstElementChild!.textContent = c.no ? `No.${c.no}` : '未编号'; cap.append(c.real ? c.title : `示例 · ${c.title}`);
        a.append(cap); li.append(a); wall.append(li);
      }
      show('cabinet', root.querySelector('[data-cabinet-title]')!);
    } else if (card) {
      const cab = data.cabinets.find((k) => k.id === card.cabinet)!;
      const peers = inCabinet(cab.id), i = peers.indexOf(card);
      const back = root.querySelector<HTMLAnchorElement>('[data-card-back]')!; back.href = `#cabinet-${cab.id}`;
      root.querySelector('[data-card-back-label]')!.textContent = cab.id === 'other' ? '返回其他系列' : `返回第 ${cab.no} 展柜`;
      root.querySelector('[data-card-title]')!.textContent = `${card.no ? 'No.' + card.no + ' ' : ''}${card.title}`;
      if (card.real) {
        const slot = document.createElement('div'); slot.setAttribute('data-park', card.id);
        const full = root.querySelector(`[data-pool-full="${card.id}"] .art-card`)!; slot.append(full); asCollected(slot); stage.append(slot);
      } else stage.append(visual(card, 'mini').firstElementChild!);
      const step = (sel: string, to?: Item) => { const a = root.querySelector<HTMLAnchorElement>(sel)!; a.href = to ? `#card-${to.id}` : '#'; a.setAttribute('aria-disabled', String(!to)); a.tabIndex = to ? 0 : -1; };
      step('[data-prev]', peers[i - 1]); step('[data-next]', peers[i + 1]);
      root.querySelector('[data-position]')!.textContent = `${i + 1} / ${peers.length}`;
      show('card', root.querySelector('[data-card-title]')!);
    } else {
      show('cabinets', root.querySelector<HTMLElement>('#cc-title')!);
    }
  };
  addEventListener('hashchange', render);
  // The real cards' own script marks them collected or not from storage; keep focus-view copies collected.
  document.addEventListener('artpilot:cards-synced', () => root.querySelectorAll('.cc-view [data-card]').forEach((c) => asCollected(c.parentElement!)));
  render();
</script>
