---
// The site search: one field, and the results grouped by kind — courses, artist stories, cases and artwork records.
// It reads the index written at build time (src/pages/search-index.json.ts) the first time it is opened; the matching
// itself is in src/lib/search.js, the place register (search a city or a country) in src/data/places.js, the other
// names of artists (凡高, Monet) in src/data/aliases.js. A query typed without spaces that finds nothing is read as its
// words, and the status line says how. Artwork results show the small copy of their card image (src/lib/thumbs.js).
// The query lives in the address (/search/?q=华盛顿), so a search can be shared, bookmarked and gone back to.
import Base from '../layouts/Base.astro';
import BackToTop from '../components/BackToTop.astro';
// Starting points, each chosen to show one way in: a place, a medium, a movement, a person, a country.
const tries = ['华盛顿', '青铜', '印象派', '浮世绘', '张大千', '日本'];
---
<Base title="搜索 · ArtPilot" description="在 ArtPilot 的课程、艺术家故事、叙事案例与藏品记录中查找：作品、艺术家、地点、博物馆或术语。" nav={{ back: { href: '/', label: '首页' } }}>
  <section class="sr" aria-labelledby="sr-title">
    <header class="sr-head">
      <p class="kicker">搜索 · <span lang="en">Search</span></p>
      <h1 id="sr-title" tabindex="-1">在 ArtPilot 里查找</h1>
      <form class="sr-form" action="/search/" method="get" role="search" data-form>
        <label class="sr-only" for="sr-q">搜索课程、故事、案例与藏品</label>
        <svg class="sr-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"
          stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 20 20" /></svg>
        <input id="sr-q" name="q" type="search" autocomplete="off" enterkeyhint="search" spellcheck="false"
          placeholder="作品、艺术家、城市或博物馆" data-q />
        <button type="submit" class="sr-submit">搜索</button>
      </form>
      <!-- Before the page paints: the field shows the query from the address, so the page never shows an empty field first. -->
      <script is:inline>(function(){var q=new URLSearchParams(location.search).get('q');var i=document.querySelector('[data-q]');if(q&&i)i.value=q;if(q)document.documentElement.dataset.searching='';})();</script>
      <p class="sr-hint">可以输入城市或国家：搜“华盛顿”，会找到收藏在那里的作品，以及写到那里各家博物馆的课程与故事，即使它们的名字里没有“华盛顿”。输入几个词时，结果会同时包含每一个词；词与词之间可以加空格，也可以直接连着写，比如“华盛顿青铜”。艺术家的不同译名与外文名都能找到，比如“凡高”“Monet”。</p>
    </header>

    <p class="sr-status" role="status" aria-live="polite" data-status></p>
    <!-- When a search finds nothing: the same explanation as above, under the message, and the examples after it. -->
    <div class="sr-again"><p class="sr-hint">可以输入作品名、艺术家、城市、国家或博物馆。艺术家的不同译名与外文名都能找到；几个词连着写也可以，比如“华盛顿青铜”。</p></div>
    <div class="sr-tries" data-tries>
      <p class="kicker">试试看</p>
      <ul>{tries.map((t) => <li><a href={`/search/?q=${encodeURIComponent(t)}`} data-try={t}>{t}</a></li>)}</ul>
    </div>

    <div class="sr-results" data-results></div>
    <!-- Coming back to a search (Back, or the way back from a result): its saved state, from this history entry or,
         where the browser opened it afresh, from this tab's session. The page stands where the reader left it before it
         paints; the results then fill the space they had (the script below draws them and lets the space go). -->
    <script is:inline>(function(){try{if('scrollRestoration' in history)history.scrollRestoration='manual';var st=history.state,u=location.pathname+location.search;if(!(st&&st.u===u)){var r=document.referrer&&new URL(document.referrer);if(r&&r.origin===location.origin&&r.pathname!=='/search/'){st=JSON.parse(sessionStorage.getItem('artpilot:search')||'null');if(!(st&&st.u===u))st=null;}else st=null;}if(st&&st.y>0){var box=document.querySelector('[data-results]');box.style.minHeight=st.h+'px';window.__srBack=st;window.scrollTo({top:st.y,behavior:'instant'});}else if(st){window.__srBack=st;}}catch(e){}})();</script>
  </section>
  <BackToTop />
</Base>

<style>
  .sr { max-width: 48rem; margin: 0 auto; padding: clamp(2.5rem, 6vw, 4.5rem) 1.25rem 5rem; }
  .sr-head h1 { margin: .75rem 0 0; font: 500 clamp(1.75rem, 4vw, 2.5rem)/1.3 var(--serif); letter-spacing: .05em; }

  /* The field: one hairline underneath, the magnifier in front, the button at the end; no box. */
  .sr-form { display: flex; align-items: center; gap: .75rem; margin-top: 2rem; border-bottom: 1px solid var(--ink); }
  .sr-icon { flex: none; color: var(--ink-3); }
  .sr-form input {
    flex: 1; min-width: 0; height: 3.25rem; padding: 0; border: 0; background: none; color: var(--ink);
    font: 400 clamp(1.125rem, 2.4vw, 1.375rem)/1.4 var(--serif); letter-spacing: .03em; outline: none;
  }
  .sr-form input::placeholder { color: var(--ink-3); opacity: 1; }
  .sr-form input::-webkit-search-cancel-button { cursor: pointer; }
  .sr-form:focus-within { box-shadow: 0 1px 0 var(--ink); }
  .sr-submit {
    flex: none; min-height: 2.75rem; padding: 0 .25rem; border: 0; background: none; color: var(--ink); cursor: pointer;
    font: 500 .875rem/1 var(--sans); letter-spacing: .12em;
  }
  .sr-submit:hover { text-decoration: underline; text-underline-offset: .35em; }
  .sr-hint { max-width: 38em; margin: 1rem 0 0; font: 400 .8125rem/1.8 var(--sans); color: var(--ink-3); }

  .sr-tries { margin-top: 2.5rem; }
  /* While there are results, the explanations give way to them; when a search finds nothing, they come back under it. */
  html[data-searching]:not([data-empty]) .sr-tries, html[data-searching]:not([data-empty]) .sr-hint { display: none; }
  html[data-empty] .sr-head .sr-hint { display: none; }
  .sr-again .sr-hint { display: block; margin-top: 1.5rem; }
  .sr-again { display: none; }
  html[data-empty] .sr-again { display: block; }
  html[data-empty] .sr-tries { margin-top: 1.5rem; }
  .sr-tries ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: .75rem 0 0; padding: 0; list-style: none; }
  .sr-tries a {
    display: inline-flex; align-items: center; min-height: 2.25rem; padding: 0 .9rem; border: 1px solid var(--rule);
    font: 400 .875rem/1 var(--sans); letter-spacing: .06em; text-decoration: none; color: var(--ink-2);
    transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .sr-tries a:hover { border-color: var(--ink); color: var(--ink); }

  .sr-status { min-height: 1.5rem; margin: 2rem 0 .5rem; font: 400 .875rem/1.7 var(--sans); color: var(--ink-3); }
  .sr-status:empty { margin: 0; min-height: 0; }
  html[data-empty] .sr-status { color: var(--ink); }
  .sr-status :global(.sr-retry) { margin-left: .5rem; min-height: 2.75rem; padding: 0 1rem; border: 1px solid var(--ink); background: none;
    color: var(--ink); cursor: pointer; font: 500 .8125rem/1 var(--sans); letter-spacing: .08em; }

  /* Results are drawn by the script; their styles reach into what it writes. */
  .sr-results :global(.sr-place) { margin-top: 0; padding: 1.25rem 0 1.5rem; border-bottom: 1px solid var(--rule); }
  .sr-results :global(.sr-place h2) { margin: .35rem 0 0; font: 500 1.375rem/1.4 var(--serif); letter-spacing: .05em; }
  .sr-results :global(.sr-place p) { margin: .5rem 0 0; font: 400 .875rem/1.8 var(--sans); color: var(--ink-2); }
  .sr-results :global(.sr-place ul) { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin: .75rem 0 0; padding: 0; list-style: none;
    font: 400 .8125rem/1.7 var(--sans); color: var(--ink-3); }
  .sr-results :global(.sr-place b) { font-weight: 500; color: var(--ink); }

  /* The tabs: pinned under the site bar while a list scrolls, so the other kinds and their counts stay in view. */
  .sr-results { scroll-margin-top: var(--nav-h, 3.5rem); }
  .sr-results :global(.sr-tabs) { position: sticky; top: var(--nav-h, 3.5rem); z-index: 5; display: flex; gap: clamp(1.25rem, 3vw, 2rem);
    background: var(--paper); border-bottom: 1px solid var(--rule); overflow-x: auto; scrollbar-width: none; }
  .sr-results :global([role="tab"]) { position: relative; flex: none; display: inline-flex; align-items: baseline; gap: .4rem; height: 3rem;
    padding: 0; border: 0; background: none; color: var(--ink-3); cursor: pointer; font: 500 .875rem/3rem var(--sans); letter-spacing: .1em;
    transition: color var(--t-fast) var(--ease); }
  .sr-results :global([role="tab"] span) { font-weight: 400; font-size: .8125rem; letter-spacing: .02em; }
  .sr-results :global([role="tab"] b) { font-weight: inherit; }
  .sr-results :global([role="tab"]::after) { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--ink);
    transform: scaleX(0); transform-origin: left; transition: transform var(--t) var(--ease); }
  .sr-results :global([role="tab"]:hover), .sr-results :global([role="tab"][aria-selected="true"]) { color: var(--ink); }
  .sr-results :global([role="tab"][aria-selected="true"]::after) { transform: scaleX(1); }
  .sr-results :global([role="tab"]:focus-visible) { outline-offset: -2px; }

  .sr-results :global(.sr-group) { margin-top: 2.5rem; }
  .sr-results :global(.sr-panel > .sr-group:first-child) { margin-top: 0; }
  .sr-results :global(.sr-brief) { padding: .85rem 0; }
  .sr-results :global(.sr-brief .sr-title) { font-size: 1rem; }
  .sr-results :global(.sr-open) { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.75rem; margin-top: .5rem; padding: 0;
    border: 0; background: none; color: var(--ink); cursor: pointer; font: 500 .8125rem/1 var(--sans); letter-spacing: .08em; }
  .sr-results :global(.sr-open span) { transition: transform var(--t) var(--ease); }
  .sr-results :global(.sr-open:hover span) { transform: translateX(3px); }
  .sr-results :global(.sr-group > h2) { display: flex; align-items: baseline; gap: .6rem; margin: 0; padding-bottom: .75rem;
    border-bottom: 1px solid var(--ink); font: 500 .875rem/1.5 var(--sans); letter-spacing: .16em; color: var(--ink); }
  .sr-results :global(.sr-group > h2 span) { font-weight: 400; letter-spacing: .04em; color: var(--ink-3); }
  .sr-results :global(.sr-list) { margin: 0; padding: 0; list-style: none; }
  .sr-results :global(.sr-item) { padding: 1.25rem 0; border-bottom: 1px solid var(--rule); }
  .sr-results :global(.sr-meta) { margin: 0; font: 400 .75rem/1.6 var(--sans); letter-spacing: .08em; color: var(--ink-3); }
  .sr-results :global(.sr-title) { display: inline-block; margin-top: .2rem; font: 500 1.125rem/1.55 var(--serif); letter-spacing: .03em;
    color: var(--ink); text-decoration: none; }
  .sr-results :global(.sr-title:hover) { text-decoration: underline; text-decoration-color: currentColor; }
  .sr-results :global(.sr-why) { margin: .35rem 0 0; font: 400 .8125rem/1.7 var(--sans); color: var(--ink-2); }
  .sr-results :global(.sr-why b) { font-weight: 500; color: var(--ink); }
  .sr-results :global(.sr-passage) { margin: .5rem 0 0; font: 400 .9375rem/1.85 var(--serif); color: var(--ink-2); }
  .sr-results :global(.sr-passage a) { margin-right: .4rem; font: 400 .75rem/1 var(--sans); letter-spacing: .04em; color: var(--ink-3); }
  .sr-results :global(mark) { background: var(--mist); color: var(--ink); font-weight: 500; padding: 0 .1em; box-shadow: inset 0 -1px 0 var(--ink-3); }
  .sr-results :global(.sr-more) { margin-top: 1rem; min-height: 2.75rem; padding: 0 1rem; border: 1px solid var(--rule); background: none;
    color: var(--ink); cursor: pointer; font: 500 .8125rem/1 var(--sans); letter-spacing: .08em; }
  .sr-results :global(.sr-more:hover) { border-color: var(--ink); }
  .sr-results :global(.sr-work) { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0 1.25rem; align-items: start; }
  .sr-results :global(.sr-work > div) { min-width: 0; }
  .sr-results :global(.sr-thumb), .sr-results :global(.sr-tile) { grid-row: 1 / span 9; width: 4.5rem; height: 4.5rem; margin-top: .2rem; }
  .sr-results :global(.sr-thumb) { display: block; object-fit: cover; background: var(--mist); }
  .sr-results :global(.sr-tile) { display: grid; place-items: center; border: 1px solid var(--rule); color: var(--ink-3);
    font: 500 1.375rem/1 var(--serif); }

  @media (max-width: 640px) {
    .sr { padding-top: 2rem; }
    .sr-form { margin-top: 1.5rem; gap: .5rem; }
    .sr-form input { height: 3rem; font-size: 1.0625rem; }
    .sr-hint { font-size: .75rem; }
    .sr-results :global(.sr-group) { margin-top: 2rem; }
    .sr-results :global(.sr-tabs) { justify-content: space-between; gap: .75rem; }
    .sr-results :global([role="tab"]) { font-size: .8125rem; letter-spacing: .04em; }
    .sr-results :global([role="tab"] span) { font-size: .75rem; }
    .sr-results :global(.sr-item) { padding: 1rem 0; }
    .sr-results :global(.sr-title) { font-size: 1rem; }
    .sr-results :global(.sr-passage) { font-size: .875rem; line-height: 1.8; }
    .sr-results :global(.sr-work) { grid-template-columns: 3.5rem 1fr; gap: 0 1rem; }
    .sr-results :global(.sr-thumb), .sr-results :global(.sr-tile) { width: 3.5rem; height: 3.5rem; }
  }
</style>

<script>
  import { prepare, search, placeLine } from '../lib/search.js';

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const input = document.querySelector<HTMLInputElement>('[data-q]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  // One name per kind, the same in the tabs, the overview's headings and its buttons, at every width (five tabs must fit
  // a phone's row).
  const NAMES: Record<string, string> = { all: '概览', lesson: '课程', story: '故事', case: '案例', artwork: '藏品' };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // The index is fetched once, on the first search; a failed fetch says so, with a button to try again.
  let index: ReturnType<typeof prepare> | null = null;
  let loading: Promise<ReturnType<typeof prepare>> | null = null;
  const load = () => (loading ??= fetch('/search-index.json').then((r) => {
    if (!r.ok) throw new Error(String(r.status));
    return r.json();
  }).then((docs) => (index = prepare(docs))).catch((e) => { loading = null; throw e; }));

  type Result = ReturnType<typeof search>;
  type Item = Result['groups'][number]['items'][number];

  // An artwork's picture in a result: the small copy of its card image, or, for a card shown as text only (or a copy
  // that fails to load), a tile with the first character of its title. Never another image in its place.
  const tile = (title: string) => `<span class="sr-tile" aria-hidden="true">${esc([...title][0] ?? '')}</span>`;
  const picture = (d: Item['doc']) => d.img
    ? `<img class="sr-thumb" src="${d.img}" alt="" loading="lazy" decoding="async" data-tile="${esc([...d.title][0] ?? '')}"${d.focus ? ` style="object-position:${esc(d.focus)}"` : ''} />`
    : tile(d.title);

  // One result. `brief`: the overview's form — what it is, why it was found, and its one best passage.
  function item(it: Item, here: string, brief = false) {
    const d = it.doc;
    const why: string[] = [];
    if (it.where.length) why.push(it.where.map((p) => `<b>${esc(placeLine(p))}</b>`).join('；'));
    if (it.via.length) why.push(`本篇的作品 ${it.via.map((t) => `《${esc(t)}》`).join('')} 收藏在${esc(here)}`);
    // A work found by its place says where it is; the passage would only repeat its record's holding line.
    const byPlace = it.where.length > 0;
    const passages = (byPlace ? [] : brief ? it.passages.slice(0, 1) : it.passages).map((p) => `<p class="sr-passage">${p.h ? `<a href="${d.url}${p.a ? `#${encodeURIComponent(p.a)}` : ''}">${esc(p.h)}</a>` : ''}${p.html}</p>`).join('');
    const body = `${d.meta ? `<p class="sr-meta">${esc(d.meta)}</p>` : ''}<a class="sr-title" href="${d.url}">${esc(d.title)}</a>`
      + (why.length ? `<p class="sr-why">${why.join(' · ')}</p>` : '') + passages;
    return d.type === 'artwork'
      ? `<li class="sr-item sr-work${brief ? ' sr-brief' : ''}">${picture(d)}<div>${body}</div></li>`
      : `<li class="sr-item${brief ? ' sr-brief' : ''}">${body}</li>`;
  }

  // The results in sections: an overview (the place, then the first few of each kind) and one tab per kind, so a
  // reader sees the whole answer at a glance and opens one list at a time. The open tab is kept in the address.
  const BRIEF = 3; // per kind, in the overview
  const PAGE = 10; // per kind, before "再显示"
  let current: { r: Result; q: string; here: string; tab: string; shown: Record<string, number> } | null = null;

  // What a return to this page needs to find it as it was: the query and tab (also in the address), how far each list
  // was opened, where the page stood and how tall the results were. Kept in this history entry, for Back, and in this
  // tab's session, for the way back from a result when the browser opens the page afresh.
  type Saved = { u: string; tab: string; shown: Record<string, number>; y: number; h: number };
  const url = () => location.pathname + location.search;
  function remember() {
    if (!current) return;
    const st: Saved = { u: url(), tab: current.tab, shown: current.shown, y: Math.round(scrollY), h: results.offsetHeight };
    history.replaceState(st, '');
    try { sessionStorage.setItem('artpilot:search', JSON.stringify(st)); } catch {}
  }

  function placePanel(r: Result) {
    if (!r.places.length) return '';
    const works = r.placeWorks;
    const by = new Map<string, number>();
    for (const p of works) by.set(p.by, (by.get(p.by) ?? 0) + 1);
    const name = r.places.length === 1 ? `${r.places[0].name}${r.places[0].country ? ` · ${r.places[0].country}` : ''}` : r.places[0].country;
    return `<section class="sr-place" aria-label="地点"><p class="kicker">地点</p><h2>${esc(name)}</h2>`
      + `<p>${works.length ? `ArtPilot 收录的作品中，有 ${new Set(works.map((w) => w.id)).size} 件收藏或位于这里。` : 'ArtPilot 收录的作品中，暂时没有收藏在这里的。'}`
      + `结果也包括写到这里各家博物馆的课程与故事。</p>`
      + (by.size ? `<ul>${[...by].sort((a, b) => b[1] - a[1]).map(([k, n]) => `<li><b>${esc(k)}</b> ${n} 件</li>`).join('')}</ul>` : '') + '</section>';
  }

  function panel(tab: string) {
    const { r, here } = current!;
    if (tab === 'all') {
      return placePanel(r) + r.overview.map((t) => r.groups.find((g) => g.type === t)!).map((g) => `<section class="sr-group"><h2>${NAMES[g.type]}<span>${g.items.length} 条</span></h2>`
        + `<ol class="sr-list">${g.items.slice(0, BRIEF).map((it) => item(it, here, true)).join('')}</ol>`
        + `<button type="button" class="sr-open" data-open="${g.type}">查看全部 ${g.items.length} 条${NAMES[g.type]} <span aria-hidden="true">→</span></button></section>`).join('');
    }
    const g = r.groups.find((x) => x.type === tab)!;
    const n = current!.shown[tab] ?? PAGE;
    return (r.groups.length === 1 ? placePanel(r) : '')
      + `<section class="sr-group"><ol class="sr-list">${g.items.map((it, i) => (i < n ? item(it, here) : item(it, here).replace('<li class="sr-item">', '<li class="sr-item" hidden>'))).join('')}</ol>`
      + (g.items.length > n ? `<button type="button" class="sr-more" data-more>${moreLabel(g.items.length - n, g.items.length)}</button>` : '') + '</section>';
  }
  const moreLabel = (left: number, total: number) => `再显示 ${Math.min(PAGE, left)} 条 · 共 ${total} 条`;

  function show(tab: string, focus = false) {
    const { r, q } = current!;
    const tabs = ['all', ...r.groups.map((g) => g.type)];
    if (r.groups.length === 1) tab = r.groups[0].type;
    else if (!tabs.includes(tab)) tab = 'all';
    results.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
      const on = b.dataset.tab === tab;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && focus) b.focus();
    });
    const box = results.querySelector<HTMLElement>('[data-panel]')!;
    if (r.groups.length > 1) box.setAttribute('aria-labelledby', `sr-tab-${tab}`);
    current!.tab = tab;
    box.innerHTML = panel(tab);
    history.replaceState(history.state, '', `/search/?q=${encodeURIComponent(q)}${tab === 'all' || r.groups.length === 1 ? '' : `&in=${tab}`}`);
    remember();
  }

  function draw(q: string, tab: string, shown: Record<string, number> = {}) {
    const r = search(index!, q);
    const total = r.groups.reduce((n, g) => n + g.items.length, 0);
    if (!total) {
      const words = r.words.map((w) => `“${w}”`).join('');
      status.textContent = r.words.length > 1
        ? `没有同时包含${words}的内容。去掉一个词再试，或者从下面的例子开始。`
        : `没有找到包含${words}的内容。换成作品名、艺术家、城市或博物馆再试，或者从下面的例子开始。`;
      document.documentElement.dataset.empty = '';
      results.innerHTML = '';
      current = null;
      return;
    }
    delete document.documentElement.dataset.empty;
    status.textContent = r.split ? `按“${r.split.join(' ')}”查找“${q}”：共 ${total} 条结果。` : `“${q}”：共 ${total} 条结果。`;
    current = { r, q, here: r.places.length === 1 ? r.places[0].name : r.places[0]?.country ?? '', tab, shown: { ...shown } };
    // One kind only: no tabs, just the list.
    const tabs = r.groups.length > 1
      ? `<div class="sr-tabs" role="tablist" aria-label="结果分类">`
        + [['all', '概览', total] as const, ...r.groups.map((g) => [g.type, NAMES[g.type], g.items.length] as const)]
          .map(([id, label, n]) => `<button type="button" role="tab" id="sr-tab-${id}" data-tab="${id}" aria-controls="sr-panel" aria-label="${label} ${n} 条">`
            + `<b aria-hidden="true">${label}</b><span aria-hidden="true">${n}</span></button>`).join('')
        + '</div>'
      : '';
    results.innerHTML = tabs + `<div class="sr-panel" id="sr-panel"${tabs ? ' role="tabpanel"' : ''} data-panel></div>`;
    show(tab);
  }

  // Opening a tab from further down the page brings its list back to the top, under the bars.
  function open(tab: string, focus: boolean) {
    show(tab, focus);
    if (results.getBoundingClientRect().top < navHeight()) results.scrollIntoView({ block: 'start' });
  }

  // The site bar's height, for the tabs to pin beneath it (it is two rows on a phone).
  const navHeight = () => document.querySelector<HTMLElement>('.site-nav')?.offsetHeight ?? 56;
  const setNav = () => document.documentElement.style.setProperty('--nav-h', `${navHeight()}px`);
  setNav();
  addEventListener('resize', setNav);

  let ticket = 0;
  async function run(q: string, push: boolean, tab = 'all', back?: Saved) {
    q = q.trim();
    if (push) history.replaceState(null, '', q ? `/search/?q=${encodeURIComponent(q)}` : '/search/');
    document.title = q ? `${q} · 搜索 · ArtPilot` : '搜索 · ArtPilot';
    if (q) document.documentElement.dataset.searching = ''; else delete document.documentElement.dataset.searching;
    if (!q) { status.textContent = ''; results.innerHTML = ''; current = null; delete document.documentElement.dataset.empty; return; }
    const mine = ++ticket;
    if (!index) {
      const slow = setTimeout(() => { if (mine === ticket) status.textContent = '正在载入搜索索引…'; }, 250);
      try { await load(); } catch {
        clearTimeout(slow);
        if (mine === ticket) status.innerHTML = '搜索数据没有载入成功，请检查网络。<button type="button" class="sr-retry" data-retry>重新载入</button>';
        return;
      }
      clearTimeout(slow);
    }
    if (mine !== ticket) return;
    draw(q, back?.tab ?? tab, back?.shown);
    if (back) {
      // Back where the reader was: the reserved space goes once the results stand in it.
      scrollTo({ top: back.y, behavior: 'instant' });
      results.style.minHeight = '';
      remember();
      // Once more after the next layout, should the page have moved under it (a phone settling its bars or fonts).
      requestAnimationFrame(() => { if (Math.abs(scrollY - back.y) > 1) scrollTo({ top: back.y, behavior: 'instant' }); remember(); });
    }
  }

  // As the reader types, after a short pause; Enter searches at once.
  let timer = 0;
  input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => run(input.value, true), 220); });
  form.addEventListener('submit', (e) => { e.preventDefault(); clearTimeout(timer); run(input.value, true); input.blur(); });
  status.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-retry]')) run(input.value, false, current?.tab ?? new URLSearchParams(location.search).get('in') ?? 'all');
  });
  // A small copy that fails to load gives way to the work's tile.
  results.addEventListener('error', (e) => {
    const img = e.target as HTMLElement;
    if (img instanceof HTMLImageElement && img.classList.contains('sr-thumb')) img.outerHTML = tile(img.dataset.tile ?? '');
  }, true);
  results.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const tab = t.closest<HTMLButtonElement>('[role="tab"]');
    if (tab) return open(tab.dataset.tab!, false);
    const go = t.closest<HTMLButtonElement>('[data-open]');
    if (go) return open(go.dataset.open!, true);
    const more = t.closest<HTMLButtonElement>('[data-more]');
    if (!more) return;
    const list = [...more.parentElement!.querySelectorAll('.sr-item')];
    const hidden = list.filter((li) => li.hasAttribute('hidden'));
    hidden.slice(0, PAGE).forEach((li) => li.removeAttribute('hidden'));
    const left = hidden.length - PAGE;
    current!.shown[current!.tab] = list.length - Math.max(0, left);
    if (left > 0) more.textContent = moreLabel(left, list.length); else more.remove();
    remember();
  });
  // Where the page stands, kept as the reader scrolls and as they leave (by a link, Back, or closing the tab).
  // While the page is being left (and while the browser keeps it aside for Back), scrolls it makes on its own are not the
  // reader's and must not overwrite the place.
  let still = 0, leaving = false, kept = 0;
  addEventListener('scroll', () => { if (leaving) return; clearTimeout(still); still = window.setTimeout(remember, 150); }, { passive: true });
  addEventListener('pagehide', () => { clearTimeout(still); remember(); kept = Math.round(scrollY); leaving = true; });
  // Back to the page as it was kept (Safari and Chrome on iPhone keep it whole, but with the scroll ours to restore,
  // and may show it at the top): put the reader back where they left.
  addEventListener('pageshow', (e) => {
    leaving = false;
    if (!e.persisted || !current) return;
    const y = kept;
    const put = () => { if (Math.abs(scrollY - y) > 1) scrollTo({ top: y, behavior: 'instant' }); };
    put();
    requestAnimationFrame(() => { put(); remember(); });
  });
  // The tabs from the keyboard: the arrows move between them, Home and End go to the ends.
  results.addEventListener('keydown', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
    if (!tab) return;
    const all = [...results.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const i = all.indexOf(tab);
    const j = e.key === 'ArrowRight' ? (i + 1) % all.length : e.key === 'ArrowLeft' ? (i - 1 + all.length) % all.length
      : e.key === 'Home' ? 0 : e.key === 'End' ? all.length - 1 : -1;
    if (j < 0) return;
    e.preventDefault();
    open(all[j].dataset.tab!, true);
  });
  // Warm the index as soon as the reader shows intent, so the first results are not kept waiting.
  input.addEventListener('focus', () => { load().catch(() => {}); }, { once: true });

  const params = new URLSearchParams(location.search);
  const q = params.get('q') ?? '';
  const back = (window as unknown as { __srBack?: Saved }).__srBack;
  if (q) run(q, false, params.get('in') ?? 'all', back); else input.focus({ preventScroll: true });
</script>
