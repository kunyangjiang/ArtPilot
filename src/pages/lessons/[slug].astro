---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GlossaryTags from '../../components/GlossaryTags.astro';
import ArtworkFigure from '../../components/ArtworkFigure.astro';
import BackToTop from '../../components/BackToTop.astro';
import ArtworkRights from '../../components/ArtworkRights.astro';
import ReadingTracker from '../../components/ReadingTracker.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const artworkId = entry.data.artwork.id;
const art = (await getEntry('artworks', artworkId))!.data;
// Break display titles after the Chinese comma so each clause sits on its own line.
const titleLines = entry.data.title.split(/(?<=，)/);
---
<Base title={`${entry.data.title} · ArtPilot`} description={entry.data.summary} nav={{
  tone: 'gallery',
  back: { href: '/courses/', label: '课程目录' },
  hall: 'courses',
  links: [{ href: '#glossary', label: '术语' }, { href: '#rights', label: '来源与版权' }],
}}>
  <header class="opening">
    <div class="opening-art"><ArtworkFigure artwork={artworkId} image="full" hero /></div>
    <div class="opening-label">
      <p class="kicker">{entry.data.kicker}</p>
      <h1 tabindex="-1">{titleLines.map((line) => <span>{line}</span>)}</h1>
      <p class="work">
        <span class="zh">{art.kind === 'painting' ? `${art.artist}《${art.titleZh}》` : art.titleZh}</span>
        <span class="en" lang="en">{art.titleEn}</span>
      </p>
      <p class="lede">{entry.data.summary}</p>
      {art.kind === 'object' ? (
        <dl class="meta">
          <dt>年代</dt><dd>{art.dateApprox}</dd>
          <dt>类型</dt><dd>{art.objectType}</dd>
          <dt>尺寸</dt><dd>{art.dimensions}</dd>
          <dt>收藏</dt><dd>{art.collection}</dd>
        </dl>
      ) : art.kind === 'building' ? (
        <dl class="meta">
          <dt>年代</dt><dd>{art.dateApprox}</dd>
          <dt>地点</dt><dd>{art.location}</dd>
          {art.facts?.map((f) => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}
        </dl>
      ) : (
        <dl class="meta">
          <dt>年代</dt><dd>{art.dateApprox}</dd>
          <dt>材质</dt><dd>{art.medium}</dd>
          <dt>尺寸</dt><dd>{art.dimensionsCm!.height} × {art.dimensionsCm!.width} cm</dd>
          <dt>收藏</dt><dd>{art.collection}</dd>
        </dl>
      )}
    </div>
  </header>

  <article class="lesson">
    <Content />
    <GlossaryTags ids={entry.data.glossary.map((g) => g.id)} />
    <ArtworkRights artwork={artworkId} />
  </article>
  <BackToTop />
  <ReadingTracker kind="lesson" id={entry.id} />
</Base>
