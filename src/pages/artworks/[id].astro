---
// Artwork record pages: one plain catalogue sheet per artwork, for paintings and buildings alike.
// About the object itself: the work, its facts, what the pictures show, where the images come from. The reading
// of the work belongs to its lessons, so there is no narrative here.
import { getCollection } from 'astro:content';
import { publishedCards } from '../../lib/cards';
import Base from '../../layouts/Base.astro';
import ArtworkRights from '../../components/ArtworkRights.astro';
import BackToTop from '../../components/BackToTop.astro';
import WorkPlate from '../../components/WorkPlate.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((record) => ({ params: { id: record.id }, props: { record } }));
}
const { record } = Astro.props;
const ID = record.id;
const art = record.data;
const image = (key: string) => art.images.find((i) => i.key === key)!;
// A work that cannot be reproduced here has no full image: the sheet shows its plate and official page instead, and
// none of the record's other images (they are other works or documents, shown in its lessons with their own labels).
const full = art.officialPage ? undefined : image('full');
const lessons = (await getCollection('lessons')).filter((l) => l.data.artwork.id === ID || l.data.cards?.some((c) => c.id === ID)); // a course's own work, or one of its further cards
const building = art.kind === 'building';
const object = art.kind === 'object'; // a vessel or a statue held by a museum, often an unsigned work or a later copy
const photographed = building || object; // records whose pictures are photographs, each with its own credit
const cardNo = art.card ? (await publishedCards()).get(ID)?.no : undefined;
// A building's or an object's other photographs, in the order the record lists them.
const photos = photographed && full ? art.images.filter((i) => i.key !== 'full') : [];
const description = building
  ? `${art.titleZh}的藏品记录：建筑信息、照片与图像来源。`
  : object
    ? `${art.titleZh}的藏品记录：器物信息、原作与复制、流传与图像来源。`
    : `${art.artist}《${art.titleZh}》的藏品记录：作品信息、画面内容与图像来源。`;
---
<Base title={`${art.titleZh} · 藏品记录 · ArtPilot`} description={description} nav={{
  back: { href: '/collection/', label: '藏品图鉴' },
  hall: 'collection',
  links: [{ href: '#rights', label: '来源与版权' }],
}}>
  <article class="object">
    {full ? (
      <figure class="object-image">
        <img src={full.src} alt={full.alt} loading="eager" decoding="async" />
        <figcaption>
          {photographed ? <>{full.caption} {full.credit?.by ?? `摄影 ${full.credit?.author}`} · {full.credit?.licence}</> : '全图（缩小版），未经修饰。'}
        </figcaption>
      </figure>
    ) : (
      <div class="object-image object-plate"><WorkPlate artwork={ID} tone="paper" /></div>
    )}

    <div class="object-sheet">
      <header class="object-head">
        <p class="object-no">藏品 No.{cardNo}{art.card && <span>{art.card.type} · {art.card.period}</span>}</p>
        <h1>{art.titleZh}</h1>
        <p class="object-en" lang="en">{art.titleEn}</p>
      </header>

      {building ? (
        <dl class="object-data">
          <dt>地点</dt>
          <dd>{art.location}</dd>
          <dt>年代</dt>
          <dd>{art.dateApprox} <span class="flag">近似</span></dd>
          <dt>类型</dt>
          <dd>{art.buildingType}</dd>
          <dt>结构与材料</dt>
          <dd>{art.materials}</dd>
          {art.facts && <><dt>主要数据</dt><dd>{art.facts.map((f) => <span class="object-fact">{f.label} {f.value}</span>)}<span class="object-sub">据主教座堂官方资料。</span></dd></>}
          <dt>设计者</dt>
          <dd class="object-missing">{art.attributionNote}</dd>
          {art.notes && <><dt>改动与保护</dt><dd><ol class="object-notes">{art.notes.map((n) => <li>{n}</li>)}</ol></dd></>}
        </dl>
      ) : object ? (
        <dl class="object-data">
          <dt>制作者</dt>
          <dd class="object-missing">{art.attributionNote}</dd>
          <dt>年代</dt>
          <dd>{art.dateApprox} <span class="flag">近似</span></dd>
          <dt>类型</dt>
          <dd>{art.objectType}</dd>
          <dt>材质</dt>
          <dd>{art.medium}</dd>
          <dt>尺寸</dt>
          <dd>{art.dimensions}<span class="object-sub">{art.dimensionsSource ?? "据收藏机构公布的数据"}</span></dd>
          <dt>原作与现状</dt>
          <dd>{art.originalStatus}</dd>
          <dt>收藏</dt>
          <dd>{art.collection}</dd>
          <dt>流传经历</dt>
          <dd>{art.provenance}</dd>
        </dl>
      ) : (
        <dl class="object-data">
          <dt>作者</dt>
          <dd>{art.artist}<span class="object-sub">{art.attributionNote}</span></dd>
          <dt>年代</dt>
          <dd>{art.dateApprox} <span class="flag">近似</span></dd>
          <dt>材质与形制</dt>
          <dd>{art.medium}</dd>
          <dt>尺寸</dt>
          <dd>{art.dimensionsCm?.height} × {art.dimensionsCm?.width} cm（高 × 宽）<span class="object-sub">{art.dimensionsSource ?? (art.officialPage ? "据收藏机构公布的数据。" : "据图像来源所附元数据；未注明是否含装裱。")}</span></dd>
          <dt>收藏</dt>
          <dd>{art.collection}</dd>
          <dt>流传经历</dt>
          <dd class="object-missing">暂无可核实的流传与递藏信息，未作补写。 <span class="flag">待补充</span></dd>
        </dl>
      )}

      {art.contents && (
        <section class="object-contents" aria-labelledby="contents-h">
          <h2 class="kicker" id="contents-h">画面内容 · 由上而下</h2>
          <ol>
            {art.contents.map((c) => {
              const img = image(c.key);
              return (
                <li>
                  <button type="button" class="object-thumb" data-view={img.src} data-alt={img.alt} data-caption={`${c.where}：${c.what}（纵向约 ${c.span}）`} aria-label={`查看局部大图：${c.where}`}>
                    <img src={img.src} alt="" loading="lazy" decoding="async" />
                  </button>
                  <p><span class="object-where">{c.where}</span>{c.what}</p>
                  <span class="object-span">{c.span}</span>
                </li>
              );
            })}
          </ol>
          <p class="object-note">局部均由同一图像裁切；百分比为纵向位置，按裁切范围估算。</p>
        </section>
      )}

      {photos.length > 0 && (
        <section class="object-contents object-photos" aria-labelledby="photos-h">
          <h2 class="kicker" id="photos-h">照片</h2>
          <ol>
            {photos.map((img) => (
              <li>
                <button type="button" class="object-thumb" data-view={img.src} data-alt={img.alt} data-caption={`${img.caption} ${img.credit?.by ?? `摄影 ${img.credit?.author}`} · ${img.credit?.licence}`} aria-label={`查看大图：${img.caption}`}>
                  <img src={img.src} alt="" loading="lazy" decoding="async" />
                </button>
                <p><span class="object-where">{img.subject ?? art.titleZh} · {img.credit?.by ?? `摄影 ${img.credit?.author}`} · {img.credit?.licence}</span>{img.caption}</p>
              </li>
            ))}
          </ol>
          <p class="object-note">{art.imagesNote ?? (building ? '照片均来自 Wikimedia Commons，只做了缩小与压缩，未裁切、未调色；完整署名与许可证链接见“来源与版权”。' : '照片均来自收藏机构的开放获取图像，只做了缩小与压缩，未裁切、未调色；来源与许可见“来源与版权”。')}</p>
        </section>
      )}

      {lessons.length > 0 && (
        <section class="object-lessons" aria-labelledby="lessons-h">
          <h2 class="kicker" id="lessons-h">相关课程</h2>
          {lessons.map((l) => <a class="object-lesson" href={`/lessons/${l.id}/`}>{l.data.title}<span aria-hidden="true">→</span></a>)}
        </section>
      )}

      <ArtworkRights artwork={ID} />
    </div>
  </article>

  <!-- Viewer: a picture opens at full size over the page instead of leaving it for the bare image file. -->
  <dialog class="object-viewer" aria-label={photographed ? '照片大图' : '局部大图'}>
    <button type="button" class="object-viewer-close" data-close>关闭</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
  </dialog>
  <BackToTop />
</Base>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('.object-viewer')!;
  const img = viewer.querySelector('img')!;
  const caption = viewer.querySelector('figcaption')!;
  let opener: HTMLButtonElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      img.src = thumb.dataset.view!;
      img.alt = thumb.dataset.alt!;
      caption.textContent = thumb.dataset.caption!;
      opener = thumb;
      viewer.showModal(); // Esc closes it
    });
  });
  viewer.addEventListener('close', () => opener?.focus({ preventScroll: true })); // back to the thumbnail it came from
  viewer.querySelector('[data-close]')!.addEventListener('click', () => viewer.close());
  viewer.addEventListener('click', (event) => { if (event.target === viewer) viewer.close(); }); // the dark surround
</script>
