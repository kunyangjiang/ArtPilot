---
import Base from '../layouts/Base.astro';
import StudyTable from '../components/home/StudyTable.astro';
import BackToTop from '../components/BackToTop.astro';
import HomeOpening from '../components/home/HomeOpening.astro';
// The homepage: the study table (src/components/home/StudyTable.astro), which reads the lessons, artworks and syllabus
// itself. On a fresh load or a reload, the seal opening plays first (src/components/home/HomeOpening.astro).
---
<Base title="ArtPilot · 全球艺术史与艺术鉴赏" description="ArtPilot 是一座数字美术馆：从一件作品开始，走进全球艺术史。" bare dark>
  <link slot="head" rel="preload" href="/fonts/noto-serif-sc-300-600.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href="/fonts/noto-sans-sc-300-500.woff2" as="font" type="font/woff2" crossorigin />
  <HomeOpening />
  <StudyTable />
  <BackToTop />
</Base>
