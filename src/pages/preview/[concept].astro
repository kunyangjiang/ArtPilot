---
// Phase 4.1A: two homepage concepts for comparison; Phase 4.1B-0 and 4.1C: two course catalogue concepts. Local only.
// The routes exist in `astro dev`, or in a build run with PUBLIC_ARTPILOT_PREVIEW=1; a normal production build generates
// no preview pages. The real homepage (src/pages/index.astro) is untouched.
import '../../styles/global.css';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const enabled = import.meta.env.DEV || import.meta.env.PUBLIC_ARTPILOT_PREVIEW === '1';
  if (!enabled) return [];
  return [
    { params: { concept: 'home-exhibition-wall' }, props: { name: 'A · Exhibition Wall' } },
    { params: { concept: 'home-museum-atlas' }, props: { name: 'B · Museum Atlas' } },
    { params: { concept: 'history-catalogue' }, props: { name: 'History Catalogue' } },
    { params: { concept: 'book-catalogue' }, props: { name: 'Archive Desk' } },
  ];
}
const { concept } = Astro.params;
const { name } = Astro.props;
const lessons = (await getCollection('lessons')).map((l) => ({ id: l.id, title: l.data.title, kicker: l.data.kicker }));
// Components and images are loaded only when previews are enabled: in a normal build this branch is dead code, so
// neither the preview styles and scripts nor the images are emitted.
const preview = import.meta.env.DEV || import.meta.env.PUBLIC_ARTPILOT_PREVIEW === '1'
  ? {
      images: (await import('../../components/preview/images')).previewImages,
      Concept: (await ({
        'home-exhibition-wall': () => import('../../components/preview/HomeExhibitionWall.astro'),
        'home-museum-atlas': () => import('../../components/preview/HomeMuseumAtlas.astro'),
        'history-catalogue': () => import('../../components/preview/HistoryCatalogue.astro'),
        'book-catalogue': () => import('../../components/preview/BookCatalogue.astro'),
      } as Record<string, () => Promise<{ default: any }>>)[concept!]()).default,
    }
  : null;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{concept === 'history-catalogue' ? '课程目录概念 · ArtPilot（本地预览）'
      : concept === 'book-catalogue' ? '课程目录概念 · 档案桌 · ArtPilot（本地预览）'
      : `首页概念 ${name} · ArtPilot（本地预览）`}</title>
  </head>
  <body>
    <main>
      {preview && <preview.Concept lessons={lessons} images={preview.images} />}
    </main>
  </body>
</html>
