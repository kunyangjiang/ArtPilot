---
// The collection (藏品图鉴): this browser's collected cards, kept in cabinets by stage (src/components/CollectionCabinets.astro),
// in the halls' room, the homepage's room seen from a corridor (src/lib/desk/hall.ts).
import Base from '../layouts/Base.astro';
import CollectionCabinets from '../components/CollectionCabinets.astro';
import BackToTop from '../components/BackToTop.astro';
---
<Base title="藏品图鉴 · ArtPilot" description="ArtPilot 藏品卡片图鉴：完成课程，收集作品卡片。" dark nav={{
  tone: 'gallery',
  back: { href: '/', label: '首页' },
  hall: 'collection', here: true,
}}>
  <section class="archive">
    <canvas class="archive-web" data-web aria-hidden="true"></canvas>
    <CollectionCabinets />
    <footer class="archive-foot">
      <button type="button" class="btn btn-secondary archive-clear" data-archive-clear>清除本机收集记录</button>
    </footer>
  </section>
  <BackToTop />
</Base>

<style>
  /* The lines sit behind the cabinets, over the archive's own ground (the canvas is fixed to the window; the archive
     is its stacking context, so the site bar stays above it). */
  .archive { position: relative; isolation: isolate; }
  .archive-web { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
</style>

<script>
  import { clearCollection, deviceStorage } from '../lib/collection.js';
  import { startGround } from '../lib/desk/ground';
  import { drawHallBodies } from '../lib/desk/hall';
  import { startScrollFade } from '../lib/scrollFade';

  // The halls' room behind the page; blocks dim as they leave the window (cabinets drawn later too).
  startGround(document.querySelector<HTMLCanvasElement>('[data-web]')!, drawHallBodies);
  startScrollFade('.cc-head, .cc-intro, .cc-cab, .cc-more, .cc-cabinet-head, .cc-thumb');

  document.querySelector('[data-archive-clear]')!.addEventListener('click', () => {
    if (!confirm('清除这台设备上的全部收集记录？此操作无法撤销。')) return;
    clearCollection(deviceStorage());
    dispatchEvent(new Event('artpilot:collected'));
  });
</script>
