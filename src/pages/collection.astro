---
// The card archive (图鉴): every artwork that has a card, locked until collected on this device.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArtworkCard from '../components/ArtworkCard.astro';

const cards = (await getCollection('artworks'))
  .filter((a) => a.data.card)
  .sort((a, b) => a.data.card!.no.localeCompare(b.data.card!.no));
---
<Base title="藏品图鉴 · ArtPilot" description="ArtPilot 藏品卡片图鉴：完成课程，收集作品卡片。" nav={{
  tone: 'gallery',
  back: { href: '/', label: '课程列表' },
  links: [],
}}>
  <section class="archive">
    <header class="archive-head">
      <p class="kicker">藏品图鉴</p>
      <h1>图鉴</h1>
      <p class="archive-count" aria-live="polite"><span data-archive-count>0</span> / {cards.length} 已收集</p>
      <p class="archive-how">完成一门课程的观察练习，即可收集该课程作品的卡片。翻到卡片背面，可进入完整的藏品记录。</p>
    </header>

    <ul class="archive-grid">
      {cards.map((a) => <li><ArtworkCard artwork={a.id} /></li>)}
      <li class="archive-more" aria-label="更多卡片">
        <p>更多卡片将随新课程加入。</p>
      </li>
    </ul>

    <footer class="archive-foot">
      <p>收集记录只保存在这台设备的浏览器中，不上传、不同步。</p>
      <button type="button" class="btn btn-secondary archive-clear" data-archive-clear>清除本机收集记录</button>
    </footer>
  </section>
</Base>

<script>
  import { clearCollection, deviceStorage } from '../lib/collection.js';

  const count = document.querySelector<HTMLElement>('[data-archive-count]')!;
  const recount = () => { count.textContent = String(document.querySelectorAll('[data-card][data-collected="true"]').length); };
  document.addEventListener('artpilot:cards-synced', recount);
  recount();

  document.querySelector('[data-archive-clear]')!.addEventListener('click', () => {
    if (!confirm('清除这台设备上的全部收集记录？此操作无法撤销。')) return;
    clearCollection(deviceStorage());
    dispatchEvent(new Event('artpilot:collected'));
  });
</script>
